#
# Find active channel for radio from vap_table.
#
# Legacy UniFi:
#   ng = 2.4 GHz
#   na = 5 GHz
#
# IMPORTANT:
# Do NOT use radio_table.scan_table here.
# scan_table contains channels of neighbouring APs.
# The active AP channel is present in vap_table.
#

radio_channel()
{
        local RADIO="$1"

        [ -n "$RADIO" ] || {
                printf '0'
                return
        }

        printf '%s\n' "$DUMP" |
        awk -v target="$RADIO" '
        BEGIN {
                RS=""
                found=0
        }

        {
                data=$0

                #
                # Extract vap_table.
                #
                p=index(data, "\"vap_table\"")
                if (!p)
                        exit

                data=substr(data,p)

                #
                # Each VAP object contains:
                #
                # "channel":11,...,"radio":"ng"
                #
                # or
                #
                # "channel":153,...,"radio":"na"
                #
                # We do not use radio_table here.
                #

                while (match(data,
                        /\{[^{}]*"channel"[[:space:]]*:[[:space:]]*[0-9]+[^{}]*"radio"[[:space:]]*:[[:space:]]*"[^"]+"/)) {

                        obj=substr(data,RSTART,RLENGTH)

                        radio=""
                        channel=""

                        x=obj

                        if (match(x,
                            /"radio"[[:space:]]*:[[:space:]]*"[^"]+"/)) {

                                r=substr(x,RSTART,RLENGTH)

                                sub(/^.*"radio"[[:space:]]*:[[:space:]]*"/,"",r)
                                sub(/".*$/,"",r)

                                radio=r
                        }

                        x=obj

                        if (match(x,
                            /"channel"[[:space:]]*:[[:space:]]*[0-9]+/)) {

                                c=substr(x,RSTART,RLENGTH)

                                sub(/^.*"channel"[[:space:]]*:[[:space:]]*/,"",c)
                                sub(/[^0-9].*$/,"",c)

                                channel=c
                        }

                        if (radio == target && channel != "") {
                                print channel
                                found=1
                                exit
                        }

                        data=substr(data,RSTART+RLENGTH)
                }
        }

        END {
                if (!found)
                        print 0
        }'
}


CHANNEL2G="$(radio_channel ng)"
CHANNEL5G="$(radio_channel na)"
CHANNEL6G="$(radio_channel 6g)"

#
# Normalize.
#

case "$CHANNEL2G" in
        ''|*[!0-9]*)
                CHANNEL2G=0
                ;;
esac

case "$CHANNEL5G" in
        ''|*[!0-9]*)
                CHANNEL5G=0
                ;;
esac

case "$CHANNEL6G" in
        ''|*[!0-9]*)
                CHANNEL6G=0
                ;;
esac
