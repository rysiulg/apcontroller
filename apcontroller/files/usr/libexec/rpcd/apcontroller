#!/bin/sh

#
# apcontroller rpcd backend
#
# Universal remote AP discovery / polling layer.
#
# rpcd plugin protocol:
#
#   apcontroller list
#   apcontroller call status
#   apcontroller call activity
#   apcontroller call scripts
#
# RPC arguments are supplied through stdin as JSON.
#

PATH="/usr/sbin:/usr/bin:/sbin:/bin"

BASEPATH="/tmp/apcontroller"

. /lib/functions.sh

T="$(uci -q get apcontroller.@global[0].path)"
[ -n "$T" ] && BASEPATH="$T"

mkdir -p "$BASEPATH"


#
# ---------------------------------------------------------------------------
# JSON helpers
# ---------------------------------------------------------------------------
#

json_escape()
{
	printf '%s' "$1" |
		awk '
		BEGIN { ORS="" }
		{
			gsub(/\\/, "\\\\");
			gsub(/"/, "\\\"");
			gsub(/\t/, "\\t");
			gsub(/\r/, "\\r");
			gsub(/\n/, "\\n");
			printf "%s", $0;
		}'
}


json_string()
{
	printf '"%s"' "$(json_escape "$1")"
}


json_number()
{
	case "$1" in
		''|*[!0-9-]*)
			printf '0'
			;;
		*)
			printf '%s' "$1"
			;;
	esac
}


empty_host_json()
{
	cat <<'EOF'
{
	"mac":"",
	"hostname":"",
	"model":"",
	"software":"",
	"uptime":0,
	"load":"",
	"channels2g":"",
	"channels5g":"",
	"channels6g":"",
	"clientslist2g":[],
	"clientslist5g":[],
	"clientslist6g":[]
}
EOF
}


#
# ---------------------------------------------------------------------------
# SSH
# ---------------------------------------------------------------------------
#

SSHOPTIONS="-o StrictHostKeyChecking=accept-new -o ConnectTimeout=5"

DETECT_SSHOPTIONS="$SSHOPTIONS \
	-o HostKeyAlgorithms=+ssh-rsa \
	-o PubkeyAcceptedAlgorithms=+ssh-rsa \
	-o KexAlgorithms=+diffie-hellman-group14-sha1,diffie-hellman-group1-sha1"


get_ssh_options()
{
	local platform="$1"

	case "$platform" in
		ubiquiti)
			echo "$SSHOPTIONS \
				-o HostKeyAlgorithms=+ssh-rsa \
				-o PubkeyAcceptedAlgorithms=+ssh-rsa \
				-o KexAlgorithms=+diffie-hellman-group14-sha1,diffie-hellman-group1-sha1"
			;;

		*)
			echo "$SSHOPTIONS"
			;;
	esac
}


remote_ssh()
{
	local platform="$1"
	local ipaddr="$2"
	local port="$3"
	local username="$4"
	local password="$5"
	local keyfile="$6"
	local usekeyfile="$7"

	shift 7

	local OPTIONS
	OPTIONS="$(get_ssh_options "$platform")"

	if [ "$usekeyfile" = "1" ] && [ -e "$keyfile" ]; then
		ssh -q \
			-i "$keyfile" \
			$OPTIONS \
			-p "$port" \
			"$username@$ipaddr" \
			"$@" 2>/dev/null
	else
		sshpass -p "$password" \
			ssh -q \
			$OPTIONS \
			-p "$port" \
			"$username@$ipaddr" \
			"$@" 2>/dev/null
	fi
}


remote_scp()
{
	local platform="$1"
	local ipaddr="$2"
	local port="$3"
	local username="$4"
	local password="$5"
	local keyfile="$6"
	local usekeyfile="$7"
	local source="$8"
	local destination="$9"

	local OPTIONS
	OPTIONS="$(get_ssh_options "$platform")"

	if [ "$usekeyfile" = "1" ] && [ -e "$keyfile" ]; then
		scp -O \
			-i "$keyfile" \
			$OPTIONS \
			-P "$port" \
			"$source" \
			"$username@$ipaddr:$destination" \
			2>/dev/null
	else
		sshpass -p "$password" \
			scp -O \
			$OPTIONS \
			-P "$port" \
			"$source" \
			"$username@$ipaddr:$destination" \
			2>/dev/null
	fi
}


#
# ---------------------------------------------------------------------------
# Remote platform autodiscovery
# ---------------------------------------------------------------------------
#

detect_platform()
{
	local ipaddr="$1"
	local port="$2"
	local username="$3"
	local password="$4"
	local keyfile="$5"
	local usekeyfile="$6"

	local OUT
	local OPTIONS

	#
	# Discovery must itself be vendor-neutral.
	# Allow legacy SSH algorithms because old Ubiquiti APs
	# commonly expose only ssh-rsa/ssh-dss.
	#
  OPTIONS="$DETECT_SSHOPTIONS \
  	-o HostKeyAlgorithms=+ssh-rsa \
  	-o PubkeyAcceptedAlgorithms=+ssh-rsa \
  	-o KexAlgorithms=+diffie-hellman-group14-sha1,diffie-hellman-group1-sha1"

	if [ "$usekeyfile" = "1" ] && [ -e "$keyfile" ]; then

OUT="$(sshpass -p "$password" \
	ssh -q \
	$OPTIONS \
	-p "$port" \
	"$username@$ipaddr" '
		echo "---APCONTROLLER---"

		if command -v mca-cli >/dev/null 2>&1 ||
		   command -v mca-cli-op >/dev/null 2>&1 ||
		   command -v ubntbox >/dev/null 2>&1 ||
		   command -v cfgmtd >/dev/null 2>&1 ||
		   command -v syswrapper.sh >/dev/null 2>&1 ||
		   command -v ubnt-util >/dev/null 2>&1 ||
		   [ -f /etc/ubnt_version ] ||
		   [ -f /etc/ubnt_version.info ] ||
		   [ -d /etc/ubnt ] ||
		   [ -d /etc/ubnt.d ] ||
		   { [ -f /etc/version ] && grep -qi "ubiquiti\|ubnt" /etc/version 2>/dev/null; }
		then
			echo UBIQUITI
		fi

		if [ -f /etc/openwrt_release ] ||
		   [ -f /etc/openwrt_version ] ||
		   { [ -f /etc/os-release ] && grep -qi "^[[:space:]]*ID=[\"'\"']*openwrt" /etc/os-release 2>/dev/null; } ||
		   command -v ubus >/dev/null 2>&1 ||
		   command -v uci >/dev/null 2>&1
		then
			echo OPENWRT
		fi

		if command -v cliclientd >/dev/null 2>&1 ||
		   command -v tpctl >/dev/null 2>&1 ||
		   [ -d /etc/omada ] ||
		   [ -d /etc/tplink ] ||
		   [ -d /etc/tp-link ]
		then
			echo OMADA
		fi

		if command -v hostapd >/dev/null 2>&1 ||
		   [ -d /etc/hostapd ] ||
		   [ -d /sys/class/net ]
		then
			echo GENERIC
		fi
	' 2>/dev/null)"

	else

		OUT="$(sshpass -p "$password" \
			ssh -q \
			$OPTIONS \
			-p "$port" \
			"$username@$ipaddr" '
				echo "---APCONTROLLER---"

				if command -v mca-cli >/dev/null 2>&1 ||
				   command -v mca-cli-op >/dev/null 2>&1 ||
				   command -v ubntbox >/dev/null 2>&1 ||
				   command -v cfgmtd >/dev/null 2>&1 ||
				   command -v syswrapper.sh >/dev/null 2>&1 ||
				   command -v ubnt-util >/dev/null 2>&1 ||
				   [ -f /etc/ubnt_version ] ||
				   [ -f /etc/ubnt_version.info ] ||
				   [ -d /etc/ubnt ] ||
				   [ -d /etc/ubnt.d ] ||
				   { [ -f /etc/version ] && grep -qi "ubiquiti\|ubnt" /etc/version 2>/dev/null; }
				then
					echo UBIQUITI
				fi

				if [ -f /etc/openwrt_release ] ||
				   [ -f /etc/openwrt_version ] ||
				   { [ -f /etc/os-release ] && grep -qi "^[[:space:]]*ID=[\"'\"']*openwrt" /etc/os-release 2>/dev/null; } ||
				   command -v ubus >/dev/null 2>&1 ||
				   command -v uci >/dev/null 2>&1
				then
					echo OPENWRT
				fi

				if command -v cliclientd >/dev/null 2>&1 ||
				   command -v tpctl >/dev/null 2>&1 ||
				   [ -d /etc/omada ] ||
				   [ -d /etc/tplink ] ||
				   [ -d /etc/tp-link ]
				then
					echo OMADA
				fi

				if command -v hostapd >/dev/null 2>&1 ||
				   [ -d /etc/hostapd ] ||
				   [ -d /sys/class/net ]
				then
					echo GENERIC
				fi
			' 2>/dev/null)"
	fi

	#
	# Specific vendor wins over generic OpenWrt/hostapd indicators.
	#
	case "$OUT" in
		*UBIQUITI*)
			echo "ubiquiti"
			;;

		*OMADA*)
			echo "omada"
			;;

		*OPENWRT*)
			echo "openwrt"
			;;

		*GENERIC*)
			echo "generic"
			;;

		*)
			echo "unknown"
			;;
	esac
}

#
# ---------------------------------------------------------------------------
# Agent selection
# ---------------------------------------------------------------------------
#

get_agent()
{
	local platform="$1"

	case "$platform" in
		openwrt)
			if [ -x /usr/share/apcontroller/apcontroller-agent-openwrt ]; then
				echo /usr/share/apcontroller/apcontroller-agent-openwrt
				return 0
			fi
			;;

		ubiquiti)
			if [ -x /usr/share/apcontroller/apcontroller-agent-ubiquiti ]; then
				echo /usr/share/apcontroller/apcontroller-agent-ubiquiti
				return 0
			fi
			;;

		omada)
			if [ -x /usr/share/apcontroller/apcontroller-agent-omada ]; then
				echo /usr/share/apcontroller/apcontroller-agent-omada
				return 0
			fi
			;;

		generic)
			if [ -x /usr/share/apcontroller/apcontroller-agent-generic ]; then
				echo /usr/share/apcontroller/apcontroller-agent-generic
				return 0
			fi
			;;
	esac

	#
	# Universal agent is ALWAYS the final fallback.
	#
	if [ -x /usr/share/apcontroller/apcontroller-agent ]; then
		echo /usr/share/apcontroller/apcontroller-agent
		return 0
	fi

	echo ""
	return 1
}


#
# ---------------------------------------------------------------------------
# Validate / normalize agent output
# ---------------------------------------------------------------------------
#

normalize_agent_output()
{
	local input="$1"

	if [ -n "$input" ] &&
	   printf '%s' "$input" |
	   jsonfilter -q -e '@' >/dev/null 2>&1; then

		#
		# Make sure the top-level object contains the arrays LuCI expects.
		#
		local clients2g clients5g clients6g

		clients2g="$(printf '%s' "$input" | jsonfilter -q -e '@.clientslist2g')"
		clients5g="$(printf '%s' "$input" | jsonfilter -q -e '@.clientslist5g')"
		clients6g="$(printf '%s' "$input" | jsonfilter -q -e '@.clientslist6g')"

		[ -n "$clients2g" ] || clients2g="[]"
		[ -n "$clients5g" ] || clients5g="[]"
		[ -n "$clients6g" ] || clients6g="[]"

		printf '%s' "$input" |
			sed 's/}[[:space:]]*$//' |
			sed "s/\$/,\"clientslist2g\":${clients2g},\"clientslist5g\":${clients5g},\"clientslist6g\":${clients6g}}/" 2>/dev/null

		return 0
	fi

	empty_host_json
}


#
# ---------------------------------------------------------------------------
# Poll one host
# ---------------------------------------------------------------------------
#

get_data_from_host()
{
	local cfg="$1"

	local enabled
	local ipaddr
	local username
	local password
	local port
	local usekeyfile
	local keyfile
	local platform
	local configured_platform
	local agent

	local output
	local tmpoutput
	local now
	local val
	local timestamp
	local d
	local ret

	config_get_bool enabled "$cfg" enabled 1
	[ "$enabled" -gt 0 ] || return 0

	config_get ipaddr "$cfg" ipaddr
	config_get username "$cfg" username

	[ -n "$ipaddr" ] || return 0
	[ -n "$username" ] || return 0

	config_get password "$cfg" password
	config_get port "$cfg" port 22

	config_get usekeyfile "$cfg" usekeyfile 0
	config_get keyfile "$cfg" keyfile "/root/.ssh/id_dropbear"

	config_get configured_platform "$cfg" platform ""

	#
	# Automatic discovery first.
	#
	platform="$(detect_platform \
		"$ipaddr" \
		"$port" \
		"$username" \
		"$password" \
		"$keyfile" \
		"$usekeyfile")"

	[ -n "$platform" ] || platform="unknown"

	#
	# Explicit UCI platform is an override, not a replacement
	# for autodiscovery.
	#
	if [ -n "$configured_platform" ] &&
	   [ "$configured_platform" != "auto" ]; then
		platform="$configured_platform"
	fi

	agent="$(get_agent "$platform")"

	output="${BASEPATH}/${ipaddr}-${cfg}"
	tmpoutput="${output}.tmp"

	rm -f "$tmpoutput"

	printf '%s\n' "$platform" \
		> "${BASEPATH}/${ipaddr}-${cfg}.platform"

	#
	# Upload and execute agent.
	#
	if [ -n "$agent" ]; then

		if remote_scp \
			"$platform" \
			"$ipaddr" \
			"$port" \
			"$username" \
			"$password" \
			"$keyfile" \
			"$usekeyfile" \
			"$agent" \
			"/tmp/apcontroller-agent"; then

			remote_ssh \
				"$platform" \
				"$ipaddr" \
				"$port" \
				"$username" \
				"$password" \
				"$keyfile" \
				"$usekeyfile" \
				"chmod +x /tmp/apcontroller-agent; /tmp/apcontroller-agent" \
				> "$tmpoutput"

			ret=$?

			remote_ssh \
				"$platform" \
				"$ipaddr" \
				"$port" \
				"$username" \
				"$password" \
				"$keyfile" \
				"$usekeyfile" \
				"rm -f /tmp/apcontroller-agent" \
				>/dev/null 2>&1

			if [ "$ret" -eq 0 ] && [ -s "$tmpoutput" ]; then

				if jsonfilter -q -i "$tmpoutput" -e '@' >/dev/null 2>&1; then
					normalize_agent_output "$(cat "$tmpoutput")" > "$output"
				else
					empty_host_json > "$output"
				fi

				rm -f "$tmpoutput"
			else
				rm -f "$tmpoutput"
			fi
		fi
	fi

	#
	# Always keep a valid cache object.
	#
	if [ ! -s "$output" ]; then
		empty_host_json > "$output"
	fi

	#
	# Online/offline.
	#
	now="$(date +%s)"
	val=0

	if [ -s "$output" ]; then
		timestamp="$(date +%s -r "$output" 2>/dev/null)"

		case "$timestamp" in
			''|*[!0-9]*)
				timestamp=0
				;;
		esac

		d=$((now - timestamp))

		[ "$d" -le 60 ] && val=1
	fi

	#
	# Hourly activity.
	#
	now="$(date +%s -d "$(date -d @"$now" '+%Y-%m-%d %H:00')")"

	touch "${BASEPATH}/${ipaddr}.txt"

	if ! grep -q "^${now} ${val}$" "${BASEPATH}/${ipaddr}.txt"; then
		echo "$now $val" >> "${BASEPATH}/${ipaddr}.txt"
	fi
}


#
# ---------------------------------------------------------------------------
# Read host cache
# ---------------------------------------------------------------------------
#

host_json()
{
	local cfg="$1"
	local ipaddr="$2"

	if [ -n "$ipaddr" ] &&
	   [ -s "${BASEPATH}/${ipaddr}-${cfg}" ]; then

		cat "${BASEPATH}/${ipaddr}-${cfg}"

	else
		empty_host_json
	fi
}


#
# ---------------------------------------------------------------------------
# Build hosts array
# ---------------------------------------------------------------------------
#

build_one_host()
{
	local cfg="$1"

	local ipaddr
	local name
	local enabled
	local platform
	local data

	local lastcontact
	local cache
	local now
	local ts

	local mac
	local hostname
	local model
	local software
	local uptime
	local load

	local channels2g
	local channels5g
	local channels6g

	local clients2g
	local clients5g
	local clients6g

	config_get ipaddr "$cfg" ipaddr
	config_get name "$cfg" name
	config_get_bool enabled "$cfg" enabled 1

	[ -n "$ipaddr" ] || return 0

	platform="$(cat "${BASEPATH}/${ipaddr}-${cfg}.platform" 2>/dev/null)"
	[ -n "$platform" ] || platform="unknown"

	data="$(host_json "$cfg" "$ipaddr" 2>/dev/null)"

	[ -n "$data" ] || data="$(empty_host_json)"

	#
	# Last contact
	#
	lastcontact=-1
	cache="${BASEPATH}/${ipaddr}-${cfg}"

	if [ -s "$cache" ]; then
		now="$(date +%s)"
		ts="$(date +%s -r "$cache" 2>/dev/null)"

		case "$ts" in
			''|*[!0-9]*)
				lastcontact=-1
				;;
			*)
				lastcontact=$((now - ts))
				[ "$lastcontact" -lt 0 ] && lastcontact=0
				;;
		esac
	fi

	#
	# Scalar fields.
	#
	mac="$(printf '%s' "$data" | jsonfilter -q -e '@.mac' 2>/dev/null)"
	hostname="$(printf '%s' "$data" | jsonfilter -q -e '@.hostname' 2>/dev/null)"
	model="$(printf '%s' "$data" | jsonfilter -q -e '@.model' 2>/dev/null)"
	software="$(printf '%s' "$data" | jsonfilter -q -e '@.software' 2>/dev/null)"
	uptime="$(printf '%s' "$data" | jsonfilter -q -e '@.uptime' 2>/dev/null)"
	load="$(printf '%s' "$data" | jsonfilter -q -e '@.load' 2>/dev/null)"

	channels2g="$(printf '%s' "$data" | jsonfilter -q -e '@.channels2g' 2>/dev/null)"
	channels5g="$(printf '%s' "$data" | jsonfilter -q -e '@.channels5g' 2>/dev/null)"
	channels6g="$(printf '%s' "$data" | jsonfilter -q -e '@.channels6g' 2>/dev/null)"

	#
	# Client arrays.
	#
	clients2g="$(printf '%s' "$data" | jsonfilter -q -e '@.clientslist2g' 2>/dev/null)"
	clients5g="$(printf '%s' "$data" | jsonfilter -q -e '@.clientslist5g' 2>/dev/null)"
	clients6g="$(printf '%s' "$data" | jsonfilter -q -e '@.clientslist6g' 2>/dev/null)"

	[ -n "$clients2g" ] || clients2g='[]'
	[ -n "$clients5g" ] || clients5g='[]'
	[ -n "$clients6g" ] || clients6g='[]'

	#
	# Never allow an undefined/non-numeric uptime.
	#
	case "$uptime" in
		''|*[!0-9-]*)
			uptime=0
			;;
	esac

	#
	# Build ONE guaranteed JSON object.
	#
	printf '{'
	printf '"section":%s,' "$(json_string "$cfg")"
	printf '"name":%s,' "$(json_string "$name")"
	printf '"ipaddr":%s,' "$(json_string "$ipaddr")"
	printf '"platform":%s,' "$(json_string "$platform")"
	printf '"enabled":%s,' "$(json_number "$enabled")"

	printf '"mac":%s,' "$(json_string "$mac")"
	printf '"hostname":%s,' "$(json_string "$hostname")"
	printf '"model":%s,' "$(json_string "$model")"
	printf '"software":%s,' "$(json_string "$software")"
	printf '"uptime":%s,' "$(json_number "$uptime")"
	printf '"load":%s,' "$(json_string "$load")"

	printf '"lastcontact":%s,' "$(json_number "$lastcontact")"

	printf '"channels2g":%s,' "$(json_string "$channels2g")"
	printf '"channels5g":%s,' "$(json_string "$channels5g")"
	printf '"channels6g":%s,' "$(json_string "$channels6g")"

	printf '"clientslist2g":%s,' "$clients2g"
	printf '"clientslist5g":%s,' "$clients5g"
	printf '"clientslist6g":%s' "$clients6g"

	printf '}'
}


build_hosts()
{
	local first=1
	local cfg
	local item

	printf '['

	config_load apcontroller

	for cfg in $(uci -q show apcontroller | sed -n 's/^apcontroller\.\([^=]*\)=host$/\1/p'); do

		item="$(build_one_host "$cfg" 2>/dev/null)"

		#
		# Pomijamy wyłącznie faktycznie pusty wynik.
		#
		[ -n "$item" ] || continue

		if [ "$first" -eq 0 ]; then
			printf ','
		fi

		printf '%s' "$item"
		first=0
	done

	printf ']'
}


#
# ---------------------------------------------------------------------------
# RPC: status
# ---------------------------------------------------------------------------
#

rpc_status()
{
	config_load apcontroller

	config_foreach get_data_from_host host

	printf '{"hosts":'
	build_hosts
	printf '}\n'
}

#
# ---------------------------------------------------------------------------
# RPC: activity
# ---------------------------------------------------------------------------
#

rpc_activity()
{
	local input
	local section
	local ipaddr
	local file
	local first=1
	local timestamp
	local value

	input="$(cat)"

	section="$(printf '%s' "$input" |
		jsonfilter -q -e '@.section' 2>/dev/null)"

	[ -n "$section" ] || {
		printf '{"activity":[]}\n'
		return 0
	}

	config_load apcontroller
	config_get ipaddr "$section" ipaddr

	[ -n "$ipaddr" ] || {
		printf '{"activity":[]}\n'
		return 0
	}

	file="${BASEPATH}/${ipaddr}.txt"

	printf '{"activity":['

	if [ -f "$file" ]; then
		while read -r timestamp value; do

			[ -n "$timestamp" ] || continue
			[ -n "$value" ] || value=0

			if [ "$first" -eq 0 ]; then
				printf ','
			fi

			first=0

			printf '{"timestamp":%s,"value":%s}' \
				"$(json_number "$timestamp")" \
				"$(json_number "$value")"

		done < "$file"
	fi

	printf ']}\n'
}


#
# ---------------------------------------------------------------------------
# RPC: scripts
# ---------------------------------------------------------------------------
#

rpc_scripts()
{
	local first=1
	local file
	local filename
	local description
	local warn

	printf '{"scripts":['

	for file in /usr/share/apcontroller/scripts/*; do

		[ -f "$file" ] || continue

		filename="$(basename "$file")"
		description="$filename"
		warn=0

		if grep -q '^# APController-Warn:[[:space:]]*1' \
			"$file" 2>/dev/null; then
			warn=1
		fi

		if [ "$first" -eq 0 ]; then
			printf ','
		fi

		first=0

		printf '{"file":%s,"description":%s,"warn":%s}' \
			"$(json_string "$filename")" \
			"$(json_string "$description")" \
			"$warn"

	done

	printf ']}\n'
}


#
# ---------------------------------------------------------------------------
# RPCD METHOD REGISTRATION
# ---------------------------------------------------------------------------
#
# THIS IS CRITICAL.
#
# rpcd executes this script with:
#
#   $1 = list
#
# at startup.
#
# For calls:
#
#   $1 = call
#   $2 = method
#
# JSON arguments arrive through stdin.
#
# ---------------------------------------------------------------------------
#

case "$1" in

	list)
		cat <<'EOF'
{
	"status": {},
	"activity": {
		"section": "string"
	},
	"scripts": {}
}
EOF
		exit 0
		;;

	call)

		case "$2" in

			status)
				rpc_status
				;;

			activity)
				rpc_activity
				;;

			scripts)
				rpc_scripts
				;;

			*)
				exit 1
				;;

		esac

		exit 0
		;;

	*)
		exit 1
		;;

esac
