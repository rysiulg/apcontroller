#!/bin/sh

PATH="/usr/sbin:/usr/bin:/sbin:/bin"

#
# APController OpenWrt bootstrap
#

REMOTE_AGENT="$1"
CONTROLLER="$2"
API_PORT="$3"
API_PATH="$4"
API_KEY="$5"
INTERVAL="$6"
DEBUG="$7"

[ -n "$REMOTE_AGENT" ] || exit 1
[ -n "$CONTROLLER" ] || exit 1
[ -n "$API_PORT" ] || API_PORT="8080"
[ -n "$API_PATH" ] || API_PATH="/cgi-bin/apcontroller-agent"
[ -n "$INTERVAL" ] || INTERVAL="30"
[ -n "$DEBUG" ] || DEBUG="1"

TMP="/tmp/apcontroller-agent.$$"
CRONLINE="*/${INTERVAL} * * * * ${REMOTE_AGENT}"

cleanup()
{
	rm -f "$TMP"
}

trap cleanup EXIT INT TERM


#
# Verify OpenWrt
#

if [ ! -f /etc/openwrt_release ] &&
   [ ! -f /etc/openwrt_version ] &&
   ! command -v ubus >/dev/null 2>&1
then
	echo "not OpenWrt" >&2
	exit 1
fi


#
# Agent body comes through stdin.
#

cat > "$TMP" || exit 1

chmod 700 "$TMP" || exit 1


#
# Install atomically.
#

mkdir -p "$(dirname "$REMOTE_AGENT")" || exit 1

mv "$TMP" "$REMOTE_AGENT" || exit 1

chmod 700 "$REMOTE_AGENT" || exit 1


#
# Install configuration directly into the script.
#
# The values are passed as environment variables by the generated
# launcher section.
#

sed -i \
	-e "s|^APCONTROLLER_CONTROLLER=.*|APCONTROLLER_CONTROLLER=$(printf '%s' "$CONTROLLER" | sed 's/[\/&]/\\&/g')|" \
	-e "s|^APCONTROLLER_API_PORT=.*|APCONTROLLER_API_PORT=$(printf '%s' "$API_PORT" | sed 's/[\/&]/\\&/g')|" \
	-e "s|^APCONTROLLER_API_PATH=.*|APCONTROLLER_API_PATH=$(printf '%s' "$API_PATH" | sed 's/[\/&]/\\&/g')|" \
	-e "s|^APCONTROLLER_API_KEY=.*|APCONTROLLER_API_KEY=$(printf '%s' "$API_KEY" | sed 's/[\/&]/\\&/g')|" \
	-e "s|^APCONTROLLER_INTERVAL=.*|APCONTROLLER_INTERVAL=$(printf '%s' "$INTERVAL" | sed 's/[\/&]/\\&/g')|" \
	-e "s|^APCONTROLLER_DEBUG=.*|APCONTROLLER_DEBUG=$(printf '%s' "$DEBUG" | sed 's/[\/&]/\\&/g')|" \
	"$REMOTE_AGENT"


#
# Cron
#

mkdir -p /etc/crontabs

CRONTAB="/etc/crontabs/root"
TMPCRON="/tmp/apcontroller-cron.$$"

touch "$CRONTAB"

grep -vF "$REMOTE_AGENT" "$CRONTAB" > "$TMPCRON" 2>/dev/null

echo "$CRONLINE" >> "$TMPCRON"

mv "$TMPCRON" "$CRONTAB"

#
# Restart cron.
#

if [ -x /etc/init.d/cron ]; then
	/etc/init.d/cron restart >/dev/null 2>&1
fi

#
# Run immediately.
#

"$REMOTE_AGENT" >/dev/null 2>&1 &

exit 0