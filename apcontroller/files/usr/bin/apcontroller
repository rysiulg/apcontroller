#!/bin/sh

#
# (c) 2025-2026 Cezary Jackiewicz <cezary@eko.one.pl>
#

SSHOPTIONS="-o StrictHostKeyChecking=accept-new"
SCPOPTIONS="-O"

BASEPATH="/tmp/apcontroller"

. /lib/functions.sh

get_data_from_host() {
	local cfg="$1"
	local enabled ipaddr username password port
	local usekeyfile keyfile
	local sshoptions
	local scpoptions
	local target
	local output
	local timestamp now val d

	config_get_bool enabled "$cfg" enabled 1
	[ "$enabled" -gt 0 ] || return 0

	config_get ipaddr "$cfg" ipaddr
	config_get username "$cfg" username

	[ -n "$ipaddr" ] || return 0
	[ -n "$username" ] || return 0

	config_get password "$cfg" password
	config_get port "$cfg" port 22

	#
	# Dodatkowe opcje SSH można ustawić per host.
	#
	# Przykład dla starego Ubiquiti:
	# option sshoptions '-c aes128-ctr'
	#
	config_get sshoptions "$cfg" sshoptions ""

	#
	# SCP:
	# OpenSSH >= 9 domyślnie używa SFTP.
	# -O wymusza stary protokół SCP, potrzebny m.in.
	# przy Dropbear na OpenWrt/Ubiquiti.
	#
	config_get scpoptions "$cfg" scpoptions "-O"

	config_get usekeyfile "$cfg" usekeyfile 0
	config_get keyfile "$cfg" keyfile "/root/.ssh/id_dropbear"

	target="${username}@${ipaddr}"
	output="${BASEPATH}/${ipaddr}-${cfg}"

	if [ "$usekeyfile" -eq 1 ] && [ -e "$keyfile" ]; then

		scp \
			-i "$keyfile" \
			${SSHOPTIONS} \
			${scpoptions} \
			-P "$port" \
			/usr/share/apcontroller/apcontroller-agent \
			"${target}:/tmp" \
			2>/dev/null

		if [ $? -eq 0 ]; then
			ssh \
				-q \
				-i "$keyfile" \
				${SSHOPTIONS} \
				${sshoptions} \
				-p "$port" \
				"$target" \
				"/tmp/apcontroller-agent" \
				> "$output" 2>/dev/null
		fi

	else

		sshpass -p "$password" \
			scp \
			${SSHOPTIONS} \
			${scpoptions} \
			-P "$port" \
			/usr/share/apcontroller/apcontroller-agent \
			"${target}:/tmp" \
			2>/dev/null

		if [ $? -eq 0 ]; then
			sshpass -p "$password" \
				ssh \
				-q \
				${SSHOPTIONS} \
				${sshoptions} \
				-p "$port" \
				"$target" \
				"/tmp/apcontroller-agent" \
				> "$output" 2>/dev/null
		fi

	fi

	#
	# Sprawdzenie czy agent faktycznie zwrócił dane.
	#
	now=$(date "+%s")
	val=0

	if [ -s "$output" ]; then
		timestamp=$(date +%s -r "$output")
		d=$((now - timestamp))

		[ "$d" -le 60 ] && val=1
	fi

	#
	# Log tylko dzień/godzina.
	#
	now=$(date +%s -d "$(date -d @"$now" "+%Y-%m-%d %H:00")")

	touch "${BASEPATH}/${ipaddr}.txt"

	grep -q "$now $val" "${BASEPATH}/${ipaddr}.txt" ||
		echo "$now $val" >> "${BASEPATH}/${ipaddr}.txt"
}

T=$(uci -q get apcontroller.@global[0].path)
[ -n "$T" ] && BASEPATH="$T"

mkdir -p "$BASEPATH"

config_load apcontroller
config_foreach get_data_from_host host

exit 0
