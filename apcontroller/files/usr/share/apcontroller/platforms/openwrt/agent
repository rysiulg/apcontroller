add_modern_client()
{
	local iface="$1"
	local band="$2"
	local client_mac="$3"

	local ssid
	local freq
	local channel
	local bssid
	local station

	local signal
	local rx_bytes
	local tx_bytes
	local rx_rate_raw
	local tx_rate_raw
	local connected

	local rx_rate
	local tx_rate

	local client_ip
	local client_hostname
	local wifi_generation

	[ -n "$client_mac" ] || return

	if client_exists "$client_mac"; then
		return
	fi

	ssid="$(get_wireless_ssid "$iface")"
	freq="$(get_iface_freq "$iface")"
	channel="$(get_iface_channel "$iface")"
	bssid="$(get_iface_bssid "$iface")"

	station="$(
		iw dev "$iface" station dump 2>/dev/null |
		awk -v wanted="$client_mac" '
		BEGIN {
			wanted=tolower(wanted)
			found=0
			signal=""
			rx=""
			tx=""
			rxrate=""
			txrate=""
			connected=""
		}

		/^Station / {
			found=(tolower($2)==wanted)
			next
		}

		!found {
			next
		}

		$1=="signal:" {
			s=$2
			gsub(/dBm/, "", s)
			signal=s
		}

		$1=="rx" && $2=="bytes:" {
			rx=$3
		}

		$1=="tx" && $2=="bytes:" {
			tx=$3
		}

		$1=="rx" && $2=="bitrate:" {
			$1=""
			$2=""
			sub(/^[ \t]+/, "")
			rxrate=$0
		}

		$1=="tx" && $2=="bitrate:" {
			$1=""
			$2=""
			sub(/^[ \t]+/, "")
			txrate=$0
		}

		$1=="connected" && $2=="time:" {
			connected=$3
		}

		END {
			printf "%s|%s|%s|%s|%s|%s\n",
				signal,rx,tx,rxrate,txrate,connected
		}'
	)"

	OLDIFS="$IFS"
	IFS='|'
	set -- $station
	IFS="$OLDIFS"

	signal="$1"
	rx_bytes="$2"
	tx_bytes="$3"
	rx_rate_raw="$4"
	tx_rate_raw="$5"
	connected="$6"

	rx_rate="$(rate_to_omada "$rx_rate_raw")"
	tx_rate="$(rate_to_omada "$tx_rate_raw")"

	client_ip="$(get_client_ip "$client_mac")"
	client_hostname="$(get_client_hostname "$client_mac")"
	wifi_generation="$(get_wifi_generation "$iface")"

	case "$signal" in
		''|*[!0-9-]*)
			signal=0
			;;
	esac

	case "$rx_bytes" in
		''|*[!0-9]*)
			rx_bytes=0
			;;
	esac

	case "$tx_bytes" in
		''|*[!0-9]*)
			tx_bytes=0
			;;
	esac

	case "$connected" in
		''|*[!0-9]*)
			connected=0
			;;
	esac

	printf '{' >> "$CLIENTS"

	printf '"ap":%s,' \
		"$(jstr "$iface")" >> "$CLIENTS"

	printf '"mac":%s,' \
		"$(jstr "$client_mac")" >> "$CLIENTS"

	printf '"channel":%s,' \
		"$(jstr "$channel")" >> "$CLIENTS"

	printf '"txrate":%s,' \
		"$(jstr "$tx_rate")" >> "$CLIENTS"

	printf '"rxrate":%s,' \
		"$(jstr "$rx_rate")" >> "$CLIENTS"

	printf '"signal":%s,' \
		"$(jnum "$signal")" >> "$CLIENTS"

	printf '"connected":%s,' \
		"$(jnum "$connected")" >> "$CLIENTS"

	printf '"lastcommunication":0,' >> "$CLIENTS"

	printf '"idle":0,' >> "$CLIENTS"

	printf '"band":%s,' \
		"$(jstr "$band")" >> "$CLIENTS"

	printf '"ssid":%s,' \
		"$(jstr "$ssid")" >> "$CLIENTS"

	printf '"bssid":%s,' \
		"$(jstr "$bssid")" >> "$CLIENTS"

	printf '"interface":%s,' \
		"$(jstr "$iface")" >> "$CLIENTS"

	printf '"ipaddr":%s,' \
		"$(jstr "$client_ip")" >> "$CLIENTS"

	printf '"name":%s,' \
		"$(jstr "$client_hostname")" >> "$CLIENTS"

	printf '"hostname":%s,' \
		"$(jstr "$client_hostname")" >> "$CLIENTS"

	printf '"rx":%s,' \
		"$(jnum "$rx_bytes")" >> "$CLIENTS"

	printf '"tx":%s,' \
		"$(jnum "$tx_bytes")" >> "$CLIENTS"

	printf '"rx_bytes":%s,' \
		"$(jnum "$rx_bytes")" >> "$CLIENTS"

	printf '"tx_bytes":%s,' \
		"$(jnum "$tx_bytes")" >> "$CLIENTS"

	printf '"wifi":%s' \
		"$(jnum "$wifi_generation")" >> "$CLIENTS"

	printf '}\n' >> "$CLIENTS"
}

###############################################################################
# COLLECT WIFI
###############################################################################

collect_wifi()
{
	local iface
	local freq
	local channel
	local band
	local ssid
	local bssid
	local line
	local station_mac

	while IFS= read -r iface; do

		[ -n "$iface" ] || continue

		case "$iface" in
			mon*|*mon)
				continue
				;;
		esac

		freq="$(get_iface_freq "$iface")"

		case "$freq" in
			''|*[!0-9]*)
				freq=0
				;;
		esac

		channel="$(get_iface_channel "$iface")"

		case "$channel" in
			''|*[!0-9]*)
				channel=0
				;;
		esac

		if [ "$freq" -gt 0 ] 2>/dev/null; then
			band="$(get_band "$freq")"
		else
			band="$(get_band_from_channel "$channel")"
		fi

		#
		# Legacy wlanconfig can give us the channel even when
		# iw/iwinfo does not.
		#
		if [ "$channel" = "0" ] &&
		   command -v wlanconfig >/dev/null 2>&1
		then
			channel="$(
				wlanconfig "$iface" list sta 2>/dev/null |
				awk '
				NR == 1 {
					c=0

					for (i=1; i<=NF; i++) {
						h=toupper($i)

						if (h=="CHAN" || h=="CHANNEL") {
							c=i
							break
						}
					}

					next
				}

				c > 0 {
					v=$c
					gsub(/[^0-9]/, "", v)

					if (v != "" && v > 0) {
						print v
						exit
					}
				}'
			)"

			case "$channel" in
				''|*[!0-9]*)
					channel=0
					;;
			esac

			if [ "$freq" -eq 0 ] 2>/dev/null; then
				band="$(get_band_from_channel "$channel")"
			fi
		fi

		case "$band" in
			2g|5g|6g)
				;;
			*)
				continue
				;;
		esac

		ssid="$(get_wireless_ssid "$iface")"
		bssid="$(get_iface_bssid "$iface")"

		add_wifi \
			"$iface" \
			"$band" \
			"$freq" \
			"$channel" \
			"$ssid" \
			"$bssid"

		############################################################################
		# LEGACY ATHEROS
		############################################################################

		if command -v wlanconfig >/dev/null 2>&1; then

			legacy_prepare_columns "$iface"

			if [ "$legacy_station_header" != "" ]; then

				wlanconfig "$iface" list sta 2>/dev/null |
				awk '
				NR > 1 &&
				$1 ~ /^[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:/ {
					print
				}' |
				while IFS= read -r line; do

					[ -n "$line" ] || continue

					add_legacy_client \
						"$iface" \
						"$band" \
						"$line"

				done
			fi
		fi

		############################################################################
		# MODERN MAC80211
		############################################################################

		if command -v iw >/dev/null 2>&1; then

			iw dev "$iface" station dump 2>/dev/null |
			awk '
			/^Station / {
				print $2
			}' |
			while IFS= read -r station_mac; do

				[ -n "$station_mac" ] || continue

				add_modern_client \
					"$iface" \
					"$band" \
					"$station_mac"

			done
		fi

	done < "$IFACES"
}

collect_wifi

###############################################################################
# BUILD ARRAY
###############################################################################

build_array()
{
	local file="$1"
	local result="["
	local first=1
	local item

	while IFS= read -r item; do
		[ -n "$item" ] || continue

		if [ "$first" -eq 0 ]; then
			result="${result},"
		fi

		result="${result}${item}"
		first=0
	done < "$file"

	result="${result}]"

	printf '%s' "$result"
}

wifi_json="$(build_array "$WIFI")"
clients_json="$(build_array "$CLIENTS")"

###############################################################################
# CLIENTS BY BAND
###############################################################################

clients2g="["
clients5g="["
clients6g="["

first2g=1
first5g=1
first6g=1

while IFS= read -r client_json; do

	[ -n "$client_json" ] || continue

	band="$(
		printf '%s' "$client_json" |
		sed -n 's/.*"band":"\([^"]*\)".*/\1/p'
	)"

	case "$band" in
		2g)
			[ "$first2g" -eq 0 ] &&
				clients2g="${clients2g},"

			clients2g="${clients2g}${client_json}"
			first2g=0
			;;

		5g)
			[ "$first5g" -eq 0 ] &&
				clients5g="${clients5g},"

			clients5g="${clients5g}${client_json}"
			first5g=0
			;;

		6g)
			[ "$first6g" -eq 0 ] &&
				clients6g="${clients6g},"

			clients6g="${clients6g}${client_json}"
			first6g=0
			;;
	esac

done < "$CLIENTS"

clients2g="${clients2g}]"
clients5g="${clients5g}]"
clients6g="${clients6g}]"

###############################################################################
# FINAL DEBUG
###############################################################################

wifi_count="$(wc -l < "$WIFI" 2>/dev/null)"
client_count="$(wc -l < "$CLIENTS" 2>/dev/null)"
iface_count="$(wc -l < "$IFACES" 2>/dev/null)"

agent_debug \
	"FINAL iface_count=$iface_count wifi_count=$wifi_count client_count=$client_count ip=$ipaddr mac=$mac hostname=$hostname_val model=$model"

###############################################################################
# FINAL JSON
###############################################################################

printf '{'

printf '"type":"openwrt",'
printf '"platform":"openwrt",'

printf '"ipaddr":%s,' \
	"$(jstr "$ipaddr")"

printf '"mac":%s,' \
	"$(jstr "$mac")"

printf '"hostname":%s,' \
	"$(jstr "$hostname_val")"

printf '"model":%s,' \
	"$(jstr "$model")"

printf '"software":%s,' \
	"$(jstr "$software")"

printf '"lastcontact":%s,' \
	"$(jnum "$lastcontact")"

printf '"uptime":%s,' \
	"$(jnum "$uptime")"

printf '"load":%s,' \
	"$(jstr "$load")"

printf '"wifi":%s,' \
	"$wifi_json"

printf '"clients":%s,' \
	"$clients_json"

printf '"clientslist2g":%s,' \
	"$clients2g"

printf '"clientslist5g":%s,' \
	"$clients5g"

printf '"clientslist6g":%s' \
	"$clients6g"

printf '}\n'

agent_debug \
	"END SUCCESS iface_count=$iface_count wifi_count=$wifi_count client_count=$client_count"

exit 0