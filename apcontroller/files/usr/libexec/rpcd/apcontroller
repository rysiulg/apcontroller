. /usr/share/libubox/jshn.sh
. /lib/functions.sh

BASEPATH="/tmp/apcontroller"

T=$(uci -q get apcontroller.@global[0].path)
[ -n "$T" ] && BASEPATH="$T"


#
# Get host status/data
#
show_status() {
	json_init
	json_add_array "hosts"

	config_load apcontroller
	config_foreach _show_status_host host

	json_close_array
	json_dump
}


_show_status_host() {
	local cfg="$1"
	local enabled
	local name
	local ipaddr
	local output
	local platform
	local platformfile
	local lastcontact
	local now
	local timestamp
	local data

	config_get_bool enabled "$cfg" enabled 1
	[ "$enabled" -gt 0 ] || return 0

	config_get name "$cfg" name
	config_get ipaddr "$cfg" ipaddr

	[ -n "$ipaddr" ] || return 0

	output="${BASEPATH}/${ipaddr}-${cfg}"
	platformfile="${output}.platform"

	now=$(date +%s)
	lastcontact=-1

	if [ -s "$output" ]; then
		timestamp=$(date +%s -r "$output" 2>/dev/null)

		if [ -n "$timestamp" ]; then
			lastcontact=$((now - timestamp))
		fi
	fi

	platform="unknown"

	if [ -f "$platformfile" ]; then
		read -r platform < "$platformfile"
		[ -n "$platform" ] || platform="unknown"
	fi


	#
	# Start host object.
	#
	json_add_object

	json_add_string "section" "$cfg"
	json_add_string "name" "$name"
	json_add_string "ipaddr" "$ipaddr"
	json_add_string "platform" "$platform"
	json_add_int "lastcontact" "$lastcontact"


	#
	# Agent output is JSON.
	#
	# IMPORTANT:
	# Do not json_load() here. json_load() replaces the current
	# JSHN context and would destroy the host object currently
	# being constructed.
	#
	if [ -s "$output" ] && jsonfilter -q -s "$(cat "$output")" -e '@' >/dev/null 2>&1; then

		data=$(cat "$output")

		#
		# Scalar fields.
		#
		_add_json_string_field "$data" "mac"
		_add_json_string_field "$data" "hostname"
		_add_json_string_field "$data" "model"
		_add_json_string_field "$data" "software"
		_add_json_string_field "$data" "uptime"
		_add_json_string_field "$data" "load"
		_add_json_string_field "$data" "clients2g"
		_add_json_string_field "$data" "clients5g"
		_add_json_string_field "$data" "clients6g"
		_add_json_string_field "$data" "channels2g"
		_add_json_string_field "$data" "channels5g"
		_add_json_string_field "$data" "channels6g"

		#
		# Client lists are arrays. Preserve them as JSON arrays.
		#
		_add_json_raw_field "$data" "clientslist2g"
		_add_json_raw_field "$data" "clientslist5g"
		_add_json_raw_field "$data" "clientslist6g"
	fi

	json_close_object
}


#
# Add a scalar JSON field without changing the current JSHN context.
#
_add_json_string_field() {
	local data="$1"
	local field="$2"
	local value

	value=$(jsonfilter -q -s "$data" -e "@.${field}" 2>/dev/null)

	[ -n "$value" ] || return 0

	json_add_string "$field" "$value"
}


#
# Add an arbitrary JSON value without changing the current JSHN context.
#
_add_json_raw_field() {
	local data="$1"
	local field="$2"
	local value

	value=$(jsonfilter -q -s "$data" -e "@.${field}" 2>/dev/null)

	[ -n "$value" ] || return 0

	json_add_raw "$field" "$value"
}


#
# Activity
#
show_activity() {
	local section="$1"
	local ipaddr
	local logfile
	local timestamp
	local value

	config_load apcontroller
	config_get ipaddr "$section" ipaddr

	json_init
	json_add_array "activity"

	[ -n "$ipaddr" ] || {
		json_close_array
		json_dump
		return 0
	}

	logfile="${BASEPATH}/${ipaddr}.txt"

	[ -f "$logfile" ] || {
		json_close_array
		json_dump
		return 0
	}

	while read -r timestamp value; do
		[ -n "$timestamp" ] || continue
		[ -n "$value" ] || continue

		json_add_object
		json_add_int "timestamp" "$timestamp"
		json_add_int "value" "$value"
		json_close_object
	done < "$logfile"

	json_close_array
	json_dump
}


#
# Available scripts
#
show_scripts() {
	local file
	local description
	local warn

	json_init
	json_add_array "scripts"

	for file in /usr/share/apcontroller/scripts/*; do
		[ -f "$file" ] || continue
		[ -x "$file" ] || continue

		description="$(sed -n 's/^# Description:[[:space:]]*//p' "$file" | head -1)"
		warn="$(sed -n 's/^# Warn:[[:space:]]*//p' "$file" | head -1)"

		[ -n "$description" ] || description="$(basename "$file")"
		[ -n "$warn" ] || warn="0"

		json_add_object
		json_add_string "file" "$(basename "$file")"
		json_add_string "description" "$description"
		json_add_string "warn" "$warn"
		json_close_object
	done

	json_close_array
	json_dump
}


#
# rpcd protocol
#
case "$1" in

	list)
		json_init

		json_add_object "activity"
		json_close_object

		json_add_object "scripts"
		json_close_object

		json_add_object "status"
		json_close_object

		json_dump
		;;

	call)
		case "$2" in

			status)
				show_status
				;;

			activity)
				read -r input
				json_load "$input" 2>/dev/null
				json_get_var section section
				show_activity "$section"
				;;

			scripts)
				show_scripts
				;;

			*)
				echo "Method not found" >&2
				exit 1
				;;
		esac
		;;

	*)
		echo "Invalid request" >&2
		exit 1
		;;

esac

exit 0
