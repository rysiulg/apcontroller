import {cursor} from 'uci';
let c=cursor(),zone=c.get('multivpn','settings','mobile_zone')||'vpn',nets=[],local=[];
function subnet(ip,bits){let a=split(ip,'.');if(length(a)!=4||bits<1||bits>32)return null;let n=0;for(let v in a){if(!match(v,/^\d+$/)||int(v)>255)return null;n=n*256+int(v);}let size=1;for(let i=bits;i<32;i++)size*=2;let base=int(n/size)*size;return {cidr:join('.',map([16777216,65536,256,1],v=>int(base/v)%256))+'/'+bits,base:base,end:base+size-1};}
function addresses(p){let rows=[];for(let value in (type(p.addresses)=='array'?p.addresses:p.addresses?[p.addresses]:[]))push(rows,value);for(let value in (type(p.ipaddr)=='array'?p.ipaddr:p.ipaddr?[p.ipaddr]:[])){let bits=24;if(p.netmask){bits=0;let binary='';for(let x in split(p.netmask,'.')){let v=int(x),s='';for(let i=0;i<8;i++){s=(v%2)+s;v=int(v/2);}binary+=s;}if(!match(binary,/^1*0*$/))continue;for(let ch in split(binary,''))if(ch=='1')bits++;}push(rows,index(value,'/')>=0?value:value+'/'+bits);}return rows;}
let source=null;c.foreach('firewall','zone',z=>{if(z.name==zone)source=z;});if(!source||!match(zone,/^[a-z][a-z0-9_]{0,11}$/))die('Nie znaleziono strefy VPN telefonu\n');
for(let iface in (type(source.network)=='array'?source.network:split(source.network||'',' '))){let p=c.get_all('network',iface);if(!p)continue;for(let value in addresses(p)){let a=split(value,'/'),n=subnet(a[0],int(a[1]));if(n&&index(nets,n.cidr)<0)push(nets,n.cidr);}}
if(ARGV[0]=='networks'){for(let n in nets)printf('%s\n',n);exit(0);}if(ARGV[0]=='zone'){print(zone);exit(0);}
let id=ARGV[1],p=c.get_all('multivpn',id),wanted=p?subnet(split(p.local_subnet,'/')[0],int(split(p.local_subnet,'/')[1])):null;
if(ARGV[0]=='local-address'&&wanted){c.foreach('firewall','zone',z=>{if(z.name!=(p.local_zone||'lan'))return;for(let iface in (type(z.network)=='array'?z.network:split(z.network||'',' '))){let i=c.get_all('network',iface);if(!i)continue;for(let value in addresses(i)){let a=split(value,'/'),n=subnet(a[0],32);if(n&&n.base>=wanted.base&&n.base<=wanted.end)push(local,a[0]);}}});if(length(local))print(local[0]);}
