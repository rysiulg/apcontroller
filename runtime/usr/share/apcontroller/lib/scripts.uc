import {readfile,stat} from 'fs';
let dir='/etc/apcontroller/scripts',names=['sync_scripts_from_nas.sh','sync-wireless-smart.sh','autoupdate.sh','autoupdate-notify.sh','99-dhcp-fallback.sh','update-hostname.sh','make_backup_usb.sh','fail2ban_sources.sh'],action=ARGV[0]||'list';
let descriptions={'sync_scripts_from_nas.sh':'Pobieranie plików z NAS','sync-wireless-smart.sh':'Wysyłanie Wi-Fi przez mechanizm APController','autoupdate.sh':'Starszy updater firmware','autoupdate-notify.sh':'Powiadomienia aktualizacji','99-dhcp-fallback.sh':'Statyczny fallback po zaniku DHCP','update-hostname.sh':'Nazwa hosta według adresu','make_backup_usb.sh':'AP → główny → szyfrowana paczka do NAS','fail2ban_sources.sh':'Źródła reguł fail2ban'};
if(action=='preview'){let name=ARGV[1];if(index(names,name)<0)die('Nieznany skrypt');let content=readfile('/scripts/'+name)||'';printf('%J\n',{name:name,text:join('\n',map(split(content,'\n'),line=>match(line,/(TOKEN|PASSWORD|PASSWD|SECRET|PRIVATE_KEY)/i)?'[wiersz z danymi uwierzytelniania ukryty]':line))});exit(0);}
let hashes={},remote={};for(let line in split(readfile(dir+'/local.sha256')||'','\n')){let m=match(line,/^([a-f0-9]{64})\s+\/scripts\/([A-Za-z0-9_.-]+)$/);if(m)hashes[m[2]]=m[1];}for(let line in split(readfile(dir+'/manifest')||'','\n')){let f=split(line,'|');remote[f[0]]=f[1];}
let rows=[];for(let name in names){let path='/scripts/'+name,info=stat(path),text=readfile(path)||'',state=info?'Lokalny plik':'Brak pliku';if(info&&match(text,/\nexit\s*\n/))state+=' · wczesne exit';if(remote[name])state+=hashes[name]==remote[name]?' · zgodny z NAS':' · różni się od NAS';if(name=='make_backup_usb.sh'&&stat('/etc/autobackup.disabled'))state+=' · autobackup wyłączony';push(rows,{name:name,description:descriptions[name],size:info?.size||0,mtime:info?.mtime||0,state:state});}
let code=readfile(dir+'/result');printf('%J\n',{rows:rows,done:!!code,code:code?int(trim(code)):null,output:readfile(dir+'/log')||'Brak wcześniejszej operacji'});
