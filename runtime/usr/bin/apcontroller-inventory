#!/bin/sh
set -e
id=${1:-};case "$id" in ''|*[!a-zA-Z0-9_]*) exit 2;;esac
[ "$(uci -q get apcontroller.$id)" = host ] || exit 2
[ -f /etc/apcontroller/inventory/$id/wireless ] || { echo 'Brak pierwszego odczytu. Włącz synchronizację i poczekaj na przygotowanie klienta.' >&2;exit 1; }
exec ucode -e 'import {cursor} from "uci";let c=cursor("/etc/apcontroller/inventory/"+ARGV[0]),result={wifi:[],networks:[]};c.foreach("wireless","wifi-iface",w=>push(result.wifi,{section:w[".name"],mode:w.mode,radio:w.device,ssid:w.ssid,network:w.network,encryption:w.encryption,managed:w.apcontroller}));c.foreach("network","interface",n=>push(result.networks,{name:n[".name"],device:n.device,protocol:n.proto}));printf("%J\n",result);' "$id"
