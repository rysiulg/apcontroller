#!/bin/sh

#
# APController - Omada EAP agent
#
# Runs locally on APController/OpenWrt.
# Connects to remote Omada EAP through SSH and returns JSON.
#
# Usage:
#
#   apcontroller-agent-omada poll \
#       <ip> <port> <username> <password> <usekeyfile> <keyfile>
#

PATH="/usr/sbin:/usr/bin:/sbin:/bin"


###############################################################################
# ARGUMENTS
###############################################################################

ACTION="$1"

if [ "$ACTION" != "poll" ]; then
	echo '{"error":"usage: apcontroller-agent-omada poll <host> <port> <user> <password> <usekeyfile> <keyfile>"}'
	exit 2
fi

IPADDR="$2"
PORT="$3"
USERNAME="$4"
PASSWORD="$5"
USEKEYFILE="$6"
KEYFILE="$7"

[ -n "$PORT" ] || PORT=22
[ -n "$USEKEYFILE" ] || USEKEYFILE=0
[ -n "$KEYFILE" ] || KEYFILE="/root/.ssh/id_dropbear"

if [ -z "$IPADDR" ] || [ -z "$USERNAME" ]; then
	echo '{"error":"invalid arguments"}'
	exit 2
fi


###############################################################################
# AUTHENTICATION
###############################################################################

USE_KEY=0

if [ "$USEKEYFILE" = "1" ] && [ -r "$KEYFILE" ]; then
	USE_KEY=1
fi

if [ "$USE_KEY" -eq 0 ] && [ -z "$PASSWORD" ]; then
	echo '{"error":"password or valid keyfile required"}'
	exit 2
fi


###############################################################################
# DEPENDENCIES
###############################################################################

command -v sexpect >/dev/null 2>&1 || {
	echo '{"error":"sexpect not found"}'
	exit 127
}

command -v ssh >/dev/null 2>&1 || {
	echo '{"error":"ssh not found"}'
	exit 127
}


###############################################################################
# TEMP FILES
###############################################################################

BASE="/tmp/apcontroller-omada-$$"

SOCK="$BASE.sock"
KNOWN="$BASE.known_hosts"

VERSION_RAW="$BASE.version"
UPTIME_RAW="$BASE.uptime"
NETWORK_RAW="$BASE.network"
WIFI_RAW="$BASE.wifi"
STATION_RAW="$BASE.station"
DEVICE_RAW="$BASE.device"
CLOUD_RAW="$BASE.cloud"
TRAFFIC_RAW="$BASE.traffic"

WIFI_JSON="$BASE.wifi.json"
CLIENT_JSON="$BASE.clients.json"
WIFI_MAP="$BASE.wifi.map"

CLIENTS2="$BASE.clients2"
CLIENTS5="$BASE.clients5"
CLIENTS6="$BASE.clients6"

rm -f \
	"$SOCK" \
	"$KNOWN" \
	"$VERSION_RAW" \
	"$UPTIME_RAW" \
	"$NETWORK_RAW" \
	"$WIFI_RAW" \
	"$STATION_RAW" \
	"$DEVICE_RAW" \
	"$CLOUD_RAW" \
	"$TRAFFIC_RAW" \
	"$WIFI_JSON" \
	"$CLIENT_JSON" \
	"$WIFI_MAP" \
	"$CLIENTS2" \
	"$CLIENTS5" \
	"$CLIENTS6"

export SEXPECT_SOCKFILE="$SOCK"


###############################################################################
# CLEANUP
###############################################################################

cleanup()
{
	sexpect close >/dev/null 2>&1

	rm -f \
		"$SOCK" \
		"$KNOWN" \
		"$VERSION_RAW" \
		"$UPTIME_RAW" \
		"$NETWORK_RAW" \
		"$WIFI_RAW" \
		"$STATION_RAW" \
		"$DEVICE_RAW" \
		"$CLOUD_RAW" \
		"$TRAFFIC_RAW" \
		"$WIFI_JSON" \
		"$CLIENT_JSON" \
		"$WIFI_MAP" \
		"$CLIENTS2" \
		"$CLIENTS5" \
		"$CLIENTS6"
}

trap cleanup EXIT INT TERM


###############################################################################
# SSH OPTIONS
###############################################################################

SSH_OPTS="
-o StrictHostKeyChecking=no
-o UserKnownHostsFile=$KNOWN
-o ConnectTimeout=8
-o ServerAliveInterval=5
-o ServerAliveCountMax=2
-o HostKeyAlgorithms=+ssh-rsa
-o PubkeyAcceptedAlgorithms=+ssh-rsa
-o LogLevel=ERROR
-p $PORT
"

if [ "$USE_KEY" -eq 1 ]; then
	SSH_OPTS="$SSH_OPTS -i $KEYFILE"
fi


###############################################################################
# START SSH
###############################################################################

sexpect spawn -t 20 ssh -tt $SSH_OPTS "$USERNAME@$IPADDR" \
	>/dev/null 2>&1

if [ $? -ne 0 ]; then
	echo '{"error":"cannot spawn ssh"}'
	exit 1
fi


###############################################################################
# PASSWORD
###############################################################################

if [ "$USE_KEY" -eq 0 ]; then

	sexpect expect \
		-timeout 10 \
		-nocase \
		-re 'password:' \
		>/dev/null 2>&1

	if [ $? -ne 0 ]; then
		echo '{"error":"password prompt not found"}'
		exit 1
	fi

	sexpect send -enter -- "$PASSWORD" >/dev/null 2>&1
fi


###############################################################################
# WAIT FOR EAP PROMPT
###############################################################################

if ! sexpect expect \
	-timeout 15 \
	-re 'EAP>' \
	>/dev/null 2>&1
then
	echo '{"error":"EAP prompt not found"}'
	exit 1
fi


###############################################################################
# ENABLE
###############################################################################

sexpect send -enter -- 'enable' >/dev/null 2>&1

if ! sexpect expect \
	-timeout 10 \
	-re 'EAP#' \
	>/dev/null 2>&1
then
	echo '{"error":"EAP enable failed"}'
	exit 1
fi


###############################################################################
# RUN COMMAND
###############################################################################

run_cmd()
{
	CMD="$1"
	OUT="$2"

	sexpect send -enter -- "$CMD" >/dev/null 2>&1

	if ! sexpect expect \
		-timeout 20 \
		-re '(.|\n)*EAP#' \
		>/dev/null 2>&1
	then
		return 1
	fi

	sexpect expect_out -index 0 |
		tr -d '\r' |
		sed 's/EAP#$//' |
		sed "1{/^[[:space:]]*$CMD[[:space:]]*$/d;}" \
		> "$OUT"

	return 0
}


###############################################################################
# COLLECT DATA
###############################################################################

run_cmd 'show version'        "$VERSION_RAW" || :
run_cmd 'show uptime'         "$UPTIME_RAW"  || :
run_cmd 'show network status' "$NETWORK_RAW" || :
run_cmd 'show wifi detail'    "$WIFI_RAW"    || :
run_cmd 'show station info'   "$STATION_RAW" || :
run_cmd 'show device-id'      "$DEVICE_RAW" || :
run_cmd 'show status cloud'   "$CLOUD_RAW"   || :
run_cmd 'show traffic'        "$TRAFFIC_RAW" || :


###############################################################################
# JSON HELPERS
###############################################################################

json_escape()
{
	printf '%s' "$1" |
	awk '
	BEGIN {
		ORS=""
	}
	{
		gsub(/\\/, "\\\\")
		gsub(/"/, "\\\"")
		gsub(/\t/, "\\t")
		gsub(/\r/, "\\r")
		gsub(/\n/, "\\n")
		printf "%s", $0
	}'
}


jstr()
{
	printf '"%s"' "$(json_escape "$1")"
}


jnum()
{
	case "$1" in
		''|*[!0-9-]*)
			printf '0'
			;;
		*)
			printf '%s' "$1"
			;;
	esac
}


###############################################################################
# VERSION
###############################################################################

firmware="$(
	sed -n '1p' "$VERSION_RAW" |
	sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
)"

software="Omada EAP $firmware"

model="$(
	awk -F': ' '
	/^[[:space:]]*(Model|Device Model|Hardware Model):/ {
		print $2
		exit
	}' "$VERSION_RAW"
)"


###############################################################################
# HOSTNAME
###############################################################################

hostname="$(
	awk -F': ' '
	/^[[:space:]]*(System Name|Hostname|Name):/ {
		print $2
		exit
	}' "$VERSION_RAW"
)"


###############################################################################
# UPTIME
###############################################################################

uptime="$(
	awk '
	{
		days=0
		h=0
		m=0
		s=0

		for (i=1; i<=NF; i++) {

			if ($i == "up") {

				for (j=i+1; j<=NF; j++) {

					x=$j
					gsub(/,/,"",x)

					if (x == "load")
						break

					if (x ~ /^[0-9]+$/ &&
					    $(j+1) ~ /^days?,?$/) {

						days=x
						continue
					}

					if (x ~ /^[0-9]+:[0-9]+:[0-9]+$/) {

						split(x,t,":")

						h=t[1]
						m=t[2]
						s=t[3]

						continue
					}

					if (x ~ /^[0-9]+:[0-9]+$/) {

						split(x,t,":")

						h=t[1]
						m=t[2]

						continue
					}
				}

				print (days * 86400) + \
				      (h * 3600) + \
				      (m * 60) + \
				      s

				exit
			}
		}
	}' "$UPTIME_RAW"
)"

case "$uptime" in
	''|*[!0-9]*)
		uptime=0
		;;
esac


###############################################################################
# LOAD
###############################################################################

load="$(
	sed -n \
		's/.*load average:[[:space:]]*\(.*\)$/\1/p' \
		"$UPTIME_RAW" |
	head -n1
)"

[ -n "$load" ] || load="0"


###############################################################################
# NETWORK
###############################################################################

ipaddr="$(
	awk '
	$1 == "br0" {
		br=1
		next
	}

	br && /inet addr:/ {

		x=$0

		sub(/^.*inet addr:/,"",x)
		sub(/[[:space:]].*$/,"",x)

		print x
		exit
	}' "$NETWORK_RAW"
)"

if [ -z "$ipaddr" ]; then
	ipaddr="$IPADDR"
fi


###############################################################################
# MAC
###############################################################################

mac="$(
	awk '
	$1 == "br0" {

		for (i=1; i<=NF; i++) {

			if ($i == "HWaddr") {
				print $(i+1)
				exit
			}
		}
	}' "$NETWORK_RAW"
)"

if [ -z "$mac" ]; then
	mac="$(
		awk '
		/^[[:space:]]*br0[[:space:]]/ {
			for (i=1; i<=NF; i++) {
				if ($i ~ /^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$/) {
					print $i
					exit
				}
			}
		}' "$NETWORK_RAW"
	)"
fi


###############################################################################
# DEVICE ID
###############################################################################

device_id="$(
	grep -E \
		'^[0-9A-Fa-f]{40}$' \
		"$DEVICE_RAW" |
	head -n1
)"


###############################################################################
# CLOUD
###############################################################################

cloud_status="$(
	sed -n \
		's/^Cloud Status:[[:space:]]*//p' \
		"$CLOUD_RAW" |
	head -n1
)"

[ -n "$cloud_status" ] || cloud_status="unknown"


###############################################################################
# WIFI INITIALIZATION
###############################################################################

: > "$WIFI_JSON"
: > "$CLIENT_JSON"
: > "$WIFI_MAP"


###############################################################################
# WIFI PARSER
###############################################################################

parse_wifi()
{
	awk '
	function flush() {

		if (iface == "")
			return

		if (freq == "" && channel == "")
			return

		if (band == "") {

			if (freq != "") {

				f=freq + 0

				if (f < 3)
					band="2g"
				else if (f < 5.925)
					band="5g"
				else
					band="6g"
			}
		}

		printf "%s\t%s\t%s\t%s\t%s\t%s\n",
			iface,
			essid,
			freq,
			band,
			channel,
			bssid
	}

	#
	# New wireless interface block.
	#
	$1 ~ /^ath[0-9]+$/ && $2 == "IEEE" {

		flush()

		iface=$1
		essid=""
		freq=""
		band=""
		channel=""
		bssid=""

		if (match($0,/ESSID:"[^"]*"/)) {

			x=substr($0,RSTART,RLENGTH)

			sub(/^ESSID:"/,"",x)
			sub(/"$/,"",x)

			essid=x
		}

		next
	}

	#
	# Some firmware versions may place ESSID on a separate line.
	#
	iface != "" && /ESSID:"[^"]*"/ {

		if (match($0,/ESSID:"[^"]*"/)) {

			x=substr($0,RSTART,RLENGTH)

			sub(/^ESSID:"/,"",x)
			sub(/"$/,"",x)

			essid=x
		}
	}

	#
	# Frequency.
	#
	iface != "" && /Frequency:[0-9.]+[[:space:]]*GHz/ {

		if (match($0,/Frequency:[0-9.]+[[:space:]]*GHz/)) {

			x=substr($0,RSTART,RLENGTH)

			sub(/^Frequency:/,"",x)
			sub(/[[:space:]]*GHz$/,"",x)

			freq=x
		}
	}

	#
	# Channel.
	#
	iface != "" && /Channel:[[:space:]]*[0-9]+/ {

		if (match($0,/Channel:[[:space:]]*[0-9]+/)) {

			x=substr($0,RSTART,RLENGTH)

			sub(/^Channel:[[:space:]]*/,"",x)

			channel=x
		}
	}

	#
	# Band.
	#
	iface != "" && /Band:[[:space:]]*[0-9A-Za-z.-]+/ {

		if (match($0,/Band:[[:space:]]*[0-9A-Za-z.-]+/)) {

			x=substr($0,RSTART,RLENGTH)

			sub(/^Band:[[:space:]]*/,"",x)

			x=tolower(x)

			if (x ~ /2\.4|2g/)
				band="2g"
			else if (x ~ /5g|5ghz/)
				band="5g"
			else if (x ~ /6g|6ghz/)
				band="6g"
		}
	}

	#
	# BSSID / Access Point.
	#
	iface != "" && /Access Point:[[:space:]]*[0-9A-Fa-f:]+/ {

		if (match($0,/Access Point:[[:space:]]*[0-9A-Fa-f:]+/)) {

			x=substr($0,RSTART,RLENGTH)

			sub(/^Access Point:[[:space:]]*/,"",x)

			bssid=x
		}
	}

	#
	# Alternative BSSID format.
	#
	iface != "" && /BSSID:[[:space:]]*[0-9A-Fa-f:]+/ {

		if (match($0,/BSSID:[[:space:]]*[0-9A-Fa-f:]+/)) {

			x=substr($0,RSTART,RLENGTH)

			sub(/^BSSID:[[:space:]]*/,"",x)

			bssid=x
		}
	}

	END {
		flush()
	}
	' "$WIFI_RAW"
}


###############################################################################
# BUILD WIFI JSON + WIFI MAP
###############################################################################

parse_wifi |
while IFS='	' read -r iface ssid freq band channel bssid
do

	[ -n "$iface" ] || continue

	case "$channel" in
		''|*[!0-9]*)
			channel=0
			;;
	esac

	#
	# WIFI JSON
	#
	printf '{' >> "$WIFI_JSON"

	printf '"ifname":%s,' \
		"$(jstr "$iface")" >> "$WIFI_JSON"

	printf '"ssid":%s,' \
		"$(jstr "$ssid")" >> "$WIFI_JSON"

	printf '"frequency":%s,' \
		"$(jstr "$freq")" >> "$WIFI_JSON"

	printf '"band":%s,' \
		"$(jstr "$band")" >> "$WIFI_JSON"

	printf '"bssid":%s,' \
		"$(jstr "$bssid")" >> "$WIFI_JSON"

	printf '"channel":%s' \
		"$(jnum "$channel")" >> "$WIFI_JSON"

	printf '}\n' >> "$WIFI_JSON"

	#
	# MAP:
	#
	# iface | ssid | frequency | band | channel | bssid
	#
	printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
		"$iface" \
		"$ssid" \
		"$freq" \
		"$band" \
		"$channel" \
		"$bssid" \
		>> "$WIFI_MAP"

done


###############################################################################
# CLIENT PARSER
###############################################################################

parse_clients()
{
	awk '
	#
	# Typical format:
	#
	# athX channel MAC txrate rxrate signal connected inactive ...
	#
	$1 ~ /^ath[0-9]+$/ &&
	$2 ~ /^[0-9]+$/ &&
	$3 ~ /^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$/ {

		iface=$1
		channel=$2
		mac=$3
		txrate=$4
		rxrate=$5
		signal=$6
		connected=$7
		inactive=$8

		#
		# Normalize MAC.
		#
		gsub(/-/,"",mac)
		gsub(/:/,"",mac)

		if (length(mac) == 12) {

			out=""

			for (i=1; i<=12; i+=2) {

				if (out != "")
					out=out ":"

				out=out substr(mac,i,2)
			}

			mac=out
		}

		#
		# Normalize time values.
		#
		sub(/s$/,"",connected)
		sub(/s$/,"",inactive)

		print \
			iface "\t" \
			channel "\t" \
			mac "\t" \
			txrate "\t" \
			rxrate "\t" \
			signal "\t" \
			connected "\t" \
			inactive
	}
	' "$STATION_RAW"
}


###############################################################################
# ADD CLIENTS
###############################################################################

parse_clients |
while IFS='	' read -r iface channel client_mac txrate rxrate signal connected inactive
do

	[ -n "$client_mac" ] || continue

	#
	# Lookup AP information.
	#
	# IMPORTANT:
	# WIFI_MAP contains six fields:
	#
	# iface ssid frequency band channel bssid
	#
	wifi_data="$(
		awk -F '	' -v wanted="$iface" '
		$1 == wanted {
			print $2 "\t" $3 "\t" $4 "\t" $5 "\t" $6
			exit
		}' "$WIFI_MAP"
	)"

	ssid=""
	frequency=""
	band=""
	wifi_channel=0
	bssid=""

	if [ -n "$wifi_data" ]; then
		IFS='	' read -r ssid frequency band wifi_channel bssid <<EOF
$wifi_data
EOF
	fi

	#
	# Sanitize numeric values.
	#
	case "$wifi_channel" in
		''|*[!0-9]*)
			wifi_channel=0
			;;
	esac

	case "$channel" in
		''|*[!0-9]*)
			channel=0
			;;
	esac

	case "$signal" in
		''|*[!0-9-]*)
			signal=0
			;;
	esac

	case "$connected" in
		''|*[!0-9]*)
			connected=0
			;;
	esac

	#
	# CLIENT JSON
	#
	printf '{' >> "$CLIENT_JSON"

	printf '"ap":%s,' \
		"$(jstr "$iface")" >> "$CLIENT_JSON"

	printf '"mac":%s,' \
		"$(jstr "$client_mac")" >> "$CLIENT_JSON"

	printf '"channel":%s,' \
		"$(jnum "$channel")" >> "$CLIENT_JSON"

	printf '"wifi_channel":%s,' \
		"$(jnum "$wifi_channel")" >> "$CLIENT_JSON"

	printf '"txrate":%s,' \
		"$(jstr "$txrate")" >> "$CLIENT_JSON"

	printf '"rxrate":%s,' \
		"$(jstr "$rxrate")" >> "$CLIENT_JSON"

	printf '"signal":%s,' \
		"$(jnum "$signal")" >> "$CLIENT_JSON"

	printf '"connected":%s,' \
		"$(jnum "$connected")" >> "$CLIENT_JSON"

	printf '"band":%s,' \
		"$(jstr "$band")" >> "$CLIENT_JSON"

	printf '"ssid":%s,' \
		"$(jstr "$ssid")" >> "$CLIENT_JSON"

	printf '"bssid":%s,' \
		"$(jstr "$bssid")" >> "$CLIENT_JSON"

	printf '"interface":%s,' \
		"$(jstr "$iface")" >> "$CLIENT_JSON"

	printf '"ipaddr":%s,' \
		'""' >> "$CLIENT_JSON"

	printf '"name":%s,' \
		'""' >> "$CLIENT_JSON"

	printf '"hostname":%s,' \
		'""' >> "$CLIENT_JSON"

	printf '"rx":0,' >> "$CLIENT_JSON"
	printf '"tx":0,' >> "$CLIENT_JSON"

	printf '"rx_bytes":0,' >> "$CLIENT_JSON"
	printf '"tx_bytes":0,' >> "$CLIENT_JSON"

	printf '"wifi":0' >> "$CLIENT_JSON"

	printf '}\n' >> "$CLIENT_JSON"

done


###############################################################################
# ARRAY BUILDER
###############################################################################

make_array()
{
	FILE="$1"
	first=1

	printf '['

	while IFS= read -r line
	do

		[ -n "$line" ] || continue

		if [ "$first" -eq 0 ]; then
			printf ','
		fi

		printf '%s' "$line"

		first=0

	done < "$FILE"

	printf ']'
}


###############################################################################
# CLIENT BAND FILTER
###############################################################################

: > "$CLIENTS2"
: > "$CLIENTS5"
: > "$CLIENTS6"


while IFS= read -r line
do

	[ -n "$line" ] || continue

	band="$(
		printf '%s' "$line" |
		sed -n \
			's/.*"band":"\([^"]*\)".*/\1/p'
	)"

	case "$band" in

		2g)
			printf '%s\n' "$line" >> "$CLIENTS2"
			;;

		5g)
			printf '%s\n' "$line" >> "$CLIENTS5"
			;;

		6g)
			printf '%s\n' "$line" >> "$CLIENTS6"
			;;

	esac

done < "$CLIENT_JSON"


###############################################################################
# BUILD ARRAYS
###############################################################################

wifi_json="$(make_array "$WIFI_JSON")"

clients_json="$(make_array "$CLIENT_JSON")"

clients2g_json="$(make_array "$CLIENTS2")"

clients5g_json="$(make_array "$CLIENTS5")"

clients6g_json="$(make_array "$CLIENTS6")"


###############################################################################
# TRAFFIC
###############################################################################

traffic_rx=0
traffic_tx=0

if [ -s "$TRAFFIC_RAW" ]; then

	traffic_data="$(
		awk '
		$1 == "br0" {
			rx=$2
			tx=$10
			print rx "\t" tx
			exit
		}' "$TRAFFIC_RAW"
	)"

	if [ -n "$traffic_data" ]; then
		IFS='	' read -r traffic_rx traffic_tx <<EOF
$traffic_data
EOF
	fi
fi

case "$traffic_rx" in
	''|*[!0-9]*)
		traffic_rx=0
		;;
esac

case "$traffic_tx" in
	''|*[!0-9]*)
		traffic_tx=0
		;;
esac


###############################################################################
# FINAL JSON
###############################################################################

printf '{'

printf '"type":"omada-eap",'
printf '"platform":"omada",'

printf '"ipaddr":%s,' \
	"$(jstr "$IPADDR")"

printf '"mac":%s,' \
	"$(jstr "$mac")"

printf '"hostname":%s,' \
	"$(jstr "$hostname")"

printf '"model":%s,' \
	"$(jstr "$model")"

printf '"firmware":%s,' \
	"$(jstr "$firmware")"

printf '"software":%s,' \
	"$(jstr "$software")"

printf '"device_id":%s,' \
	"$(jstr "$device_id")"

printf '"cloud_status":%s,' \
	"$(jstr "$cloud_status")"

printf '"uptime":%s,' \
	"$(jnum "$uptime")"

printf '"load":%s,' \
