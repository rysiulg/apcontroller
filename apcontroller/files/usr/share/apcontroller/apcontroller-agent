PATH="/usr/sbin:/usr/bin:/sbin:/bin"

AGENT_DIR="/usr/bin"
UBUS_EVENT="apcontroller"


#
# Detect platform
#

detect_platform()
{
	#
	# Ubiquiti / UniFi
	#
	if command -v mca-dump >/dev/null 2>&1 ||
	   command -v mca-cli-op >/dev/null 2>&1 ||
	   [ -f /etc/ubnt_version ]; then
		echo "ubiquiti"
		return 0
	fi


	#
	# TP-Link Omada
	#
	if command -v cliclientd >/dev/null 2>&1 ||
	   [ -d /etc/omada ] ||
	   [ -d /etc/tplink ]; then
		echo "omada"
		return 0
	fi


	#
	# OpenWrt
	#
	if [ -f /etc/openwrt_release ] ||
	   [ -f /etc/openwrt_version ]; then
		echo "openwrt"
		return 0
	fi


	return 1
}


#
# Detect platform
#

PLATFORM="$(detect_platform)"

case "$PLATFORM" in

	openwrt)
		AGENT="$AGENT_DIR/apcontroller-agent-openwrt"
		;;

	omada)
		AGENT="$AGENT_DIR/apcontroller-agent-omada"
		;;

	ubiquiti)
		AGENT="$AGENT_DIR/apcontroller-agent-ubiquiti"
		;;

	*)
		logger -t apcontroller-agent \
			"unsupported platform"
		exit 1
		;;

esac


#
# Check selected agent
#

if [ ! -x "$AGENT" ]; then
	logger -t apcontroller-agent \
		"agent not found: $AGENT"
	exit 1
fi


#
# Run platform-specific agent.
#
# The selected agent must return complete JSON on stdout.
#

JSON="$("$AGENT" 2>/dev/null)"

if [ -z "$JSON" ]; then
	logger -t apcontroller-agent \
		"agent returned no data: $PLATFORM"
	exit 1
fi


#
# Validate JSON
#

if ! jsonfilter -s "$JSON" -e '@' >/dev/null 2>&1; then
	logger -t apcontroller-agent \
		"agent returned invalid JSON: $PLATFORM"
	exit 1
fi


#
# Pass JSON unchanged to ubus
#

if ! ubus send "$UBUS_EVENT" "$JSON" >/dev/null 2>&1; then
	logger -t apcontroller-agent \
		"ubus send failed: $PLATFORM"
	exit 1
fi

exit 0
