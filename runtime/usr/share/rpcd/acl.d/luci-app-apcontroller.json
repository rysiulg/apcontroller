{
  "luci-app-apcontroller": {
    "description": "Grant UCI access for luci-app-apcontroller",
    "read": {
      "file": {
        "/etc/crontabs/root": [
          "read"
        ],
        "/etc/apcontroller/discovery.json": [
          "read"
        ],
        "/usr/share/apcontroller/apcontroller.user": [
          "read"
        ]
      },
      "ubus": {
        "apcontroller": [
          "activity",
          "scripts",
          "status"
        ],
        "file": [
          "read"
        ],
        "luci-rpc": [
          "getHostHints"
        ]
      },
      "uci": [
        "apcontroller",
        "multivpn",
        "network"
      ]
    },
    "write": {
      "file": {
        "/etc/crontabs/root": [
          "write"
        ],
        "/etc/init.d/cron reload": [
          "exec"
        ],
        "/usr/bin/apcontroller": [
          "exec"
        ],
        "/usr/bin/apcontroller-package": [
          "exec"
        ],
        "/usr/bin/apcontroller-sendconfig": [
          "exec"
        ],
        "/usr/bin/scp": [
          "exec"
        ],
        "/usr/bin/ssh": [
          "exec"
        ],
        "/usr/bin/sshpass": [
          "exec"
        ],
        "/usr/share/apcontroller/apcontroller.user": [
          "write"
        ],
        "/usr/bin/apcontroller-authorize-key": [
          "exec"
        ],
        "/usr/bin/apcontroller-scan": [
          "exec"
        ],
        "/usr/bin/apcontroller-scripts": [
          "exec"
        ],
        "/usr/bin/apcontroller-wifi-job": [
          "exec"
        ],
        "/usr/bin/apcontroller-backup": [
          "exec"
        ],
        "/usr/bin/apcontroller-desired": [
          "exec"
        ],
        "/usr/bin/apcontroller-inventory": [
          "exec"
        ]
      },
      "ubus": {
        "file": [
          "write"
        ]
      },
      "uci": [
        "apcontroller"
      ]
    }
  }
}
