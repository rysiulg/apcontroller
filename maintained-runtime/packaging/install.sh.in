#!/bin/sh
set -eu
BASE=${APC_REPO_URL:-https://nas.marm.pl/openwrt/ap_repos/apcontroller}
ARCH=$(head -n 1 /etc/apk/arch)
case "$ARCH" in aarch64_cortex-a53) ;; *) echo "No tested package for $ARCH" >&2; exit 1;; esac
fetch() { if command -v curl >/dev/null 2>&1; then curl --fail --silent --show-error --location --proto '=https' "$1" -o "$3"; else wget -q -O "$3" "$1"; fi; }
tmp=$(mktemp -d /tmp/apcontroller-install.XXXXXX)
completed=0
cleanup() { if [ "$completed" = 0 ] && [ -f "$tmp/world.before" ]; then cp "$tmp/world.before" /etc/apk/world; fi; rm -rf "$tmp"; }
trap cleanup EXIT
trap 'exit 130' INT TERM
fetch "$BASE/keys/apcontroller-local.pem" -o "$tmp/key.pem"
echo '@KEY_HASH@  '"$tmp/key.pem" | sha256sum -c -
fetch "$BASE/$ARCH/packages.adb" -o "$tmp/packages.adb"
mkdir -p /etc/apk/keys /etc/apk/repositories.d
cp "$tmp/key.pem" /etc/apk/keys/apcontroller-local.pem
chmod 644 /etc/apk/keys/apcontroller-local.pem
apk verify "$tmp/packages.adb"
cp -p /etc/apk/world "$tmp/world.before"
awk '{if ($0 ~ /^apcontroller[<>=~]/) print "apcontroller"; else if ($0 ~ /^luci-app-apcontroller[<>=~]/) print "luci-app-apcontroller"; else if ($0 ~ /^luci-i18n-apcontroller-pl[<>=~]/) print "luci-i18n-apcontroller-pl"; else print}' /etc/apk/world > "$tmp/world"
cp "$tmp/world" /etc/apk/world
if [ -f /etc/apk/repositories.d/customfeeds.list ]; then
    awk '!/raw.github(usercontent)?.com\/rysiulg\/apcontroller/' /etc/apk/repositories.d/customfeeds.list > "$tmp/customfeeds.list"
    cp "$tmp/customfeeds.list" /etc/apk/repositories.d/customfeeds.list
fi
printf '%s/%s/packages.adb\n' "$BASE" "$ARCH" > /etc/apk/repositories.d/apcontroller.list
apk update
apk add --upgrade apcontroller luci-app-apcontroller luci-i18n-apcontroller-pl
completed=1
rm -f /etc/apk/keys/rysiulg-apcontroller.rsa.pub
echo 'APController installed. Reopen its LuCI page.'
