#!/bin/sh

#
# APController rpcd backend
#
# SSH authentication:
#
#   1. local APController key
#   2. per-host username/password fallback
#   3. after successful password login:
#        install local public key into remote ~/.ssh/authorized_keys
#        mark host usekeyfile=1
#   4. future SSH/SCP connections use key first
#
# Discovery:
#
#   - ONLY LAN and VPN logical interfaces
#   - WAN/WAN6 are NEVER scanned
#   - guest interfaces are NEVER scanned
#   - network is calculated from REAL IPv4 address + REAL prefix
#   - detects supported platform
#   - automatically adds discovered host to UCI
#   - stores discovery username/password per host
#

PATH="/usr/sbin:/usr/bin:/sbin:/bin"

CONFIG="apcontroller"

BASEPATH="/tmp/apcontroller"
T="$(uci -q get apcontroller.@global[0].path 2>/dev/null)"
[ -n "$T" ] && BASEPATH="$T"

KEYDIR="/etc/apcontroller/ssh"
KEYFILE="${KEYDIR}/id_apcontroller"
PUBKEY="${KEYFILE}.pub"

mkdir -p "$BASEPATH"
mkdir -p "$KEYDIR"

chmod 700 "$KEYDIR" 2>/dev/null
chmod 600 "$KEYFILE" 2>/dev/null
chmod 644 "$PUBKEY" 2>/dev/null


#
# ---------------------------------------------------------------------------
# JSON helpers
# ---------------------------------------------------------------------------
#

json_escape()
{
	printf '%s' "$1" |
	awk '
	BEGIN { ORS="" }
	{
		gsub(/\\/, "\\\\")
		gsub(/"/, "\\\"")
		gsub(/\t/, "\\t")
		gsub(/\r/, "\\r")
		gsub(/\n/, "\\n")
		printf "%s", $0
	}'
}


json_string()
{
	printf '"%s"' "$(json_escape "$1")"
}


json_number()
{
	case "$1" in
		''|*[!0-9-]*)
			printf '0'
			;;
		*)
			printf '%s' "$1"
			;;
	esac
}


empty_host_json()
{
	cat <<'JSON'
{
"mac":"",
"hostname":"",
"model":"",
"software":"",
"uptime":0,
"load":"",
"channels2g":"",
"channels5g":"",
"channels6g":"",
"clientslist2g":[],
"clientslist5g":[],
"clientslist6g":[]
}
JSON
}


#
# ---------------------------------------------------------------------------
# UCI helpers
# ---------------------------------------------------------------------------
#

uci_get()
{
	local section="$1"
	local option="$2"
	local default="$3"
	local value

	value="$(uci -q get "${CONFIG}.${section}.${option}" 2>/dev/null)"

	if [ -n "$value" ]; then
		printf '%s' "$value"
	else
		printf '%s' "$default"
	fi
}


uci_set()
{
	local section="$1"
	local option="$2"
	local value="$3"

	uci -q set "${CONFIG}.${section}.${option}=${value}" 2>/dev/null
}


host_sections()
{
	uci -q show "$CONFIG" 2>/dev/null |
	sed -n 's/^apcontroller\.\([^.=]*\)=host$/\1/p'
}


host_exists_ip()
{
	local wanted="$1"
	local cfg
	local ip

	for cfg in $(host_sections); do
		ip="$(uci_get "$cfg" ipaddr "")"

		if [ "$ip" = "$wanted" ]; then
			printf '%s' "$cfg"
			return 0
		fi
	done

	return 1
}


next_host_name()
{
	local base="$1"
	local n=1
	local candidate

	while :; do
		candidate="${base}${n}"

		if ! uci -q get "${CONFIG}.${candidate}" >/dev/null 2>&1; then
			printf '%s' "$candidate"
			return 0
		fi

		n=$((n + 1))
	done
}


#
# ---------------------------------------------------------------------------
# SSH key management
# ---------------------------------------------------------------------------
#

ensure_local_key()
{
	if [ -s "$KEYFILE" ] && [ -s "$PUBKEY" ]; then
		chmod 600 "$KEYFILE" 2>/dev/null
		chmod 644 "$PUBKEY" 2>/dev/null
		return 0
	fi

	mkdir -p "$KEYDIR"
	chmod 700 "$KEYDIR" 2>/dev/null

	if command -v ssh-keygen >/dev/null 2>&1; then

		rm -f "$KEYFILE" "$PUBKEY"

		ssh-keygen \
			-q \
			-t ed25519 \
			-N "" \
			-f "$KEYFILE" \
			>/dev/null 2>&1

		if [ "$?" -eq 0 ] &&
		   [ -s "$KEYFILE" ] &&
		   [ -s "$PUBKEY" ]; then

			chmod 600 "$KEYFILE"
			chmod 644 "$PUBKEY"

			return 0
		fi

		rm -f "$KEYFILE" "$PUBKEY"

		ssh-keygen \
			-q \
			-t rsa \
			-b 3072 \
			-N "" \
			-f "$KEYFILE" \
			>/dev/null 2>&1

		if [ "$?" -eq 0 ] &&
		   [ -s "$KEYFILE" ] &&
		   [ -s "$PUBKEY" ]; then

			chmod 600 "$KEYFILE"
			chmod 644 "$PUBKEY"

			return 0
		fi
	fi

	if command -v dropbearkey >/dev/null 2>&1; then

		rm -f "$KEYFILE" "$PUBKEY"

		dropbearkey \
			-t ed25519 \
			-f "$KEYFILE" \
			>/dev/null 2>&1

		if [ "$?" -eq 0 ] && [ -s "$KEYFILE" ]; then

			dropbearkey \
				-y \
				-f "$KEYFILE" 2>/dev/null |
				awk '/^ssh-|^ecdsa-/ {
					print
				}' > "$PUBKEY"

			if [ -s "$PUBKEY" ]; then
				chmod 600 "$KEYFILE"
				chmod 644 "$PUBKEY"
				return 0
			fi
		fi
	fi

	return 1
}


#
# ---------------------------------------------------------------------------
# SSH options
# ---------------------------------------------------------------------------
#

SSHOPTIONS="
-o StrictHostKeyChecking=accept-new
-o ConnectTimeout=3
-o ServerAliveInterval=3
-o ServerAliveCountMax=1
"


DETECT_SSHOPTIONS="
$SSHOPTIONS
-o HostKeyAlgorithms=+ssh-rsa
-o PubkeyAcceptedAlgorithms=+ssh-rsa
-o KexAlgorithms=+diffie-hellman-group14-sha1,diffie-hellman-group1-sha1
"


get_ssh_options()
{
	local platform="$1"

	case "$platform" in

		ubiquiti)
			echo "$SSHOPTIONS
-o HostKeyAlgorithms=+ssh-rsa
-o PubkeyAcceptedAlgorithms=+ssh-rsa
-o KexAlgorithms=+diffie-hellman-group14-sha1,diffie-hellman-group1-sha1"
			;;

		*)
			echo "$SSHOPTIONS"
			;;

	esac
}


#
# ---------------------------------------------------------------------------
# SSH key authentication
# ---------------------------------------------------------------------------
#

ssh_key_exec()
{
	local platform="$1"
	local ipaddr="$2"
	local port="$3"
	local username="$4"

	shift 4

	[ -s "$KEYFILE" ] || return 1

	local OPTIONS
	OPTIONS="$(get_ssh_options "$platform")"

	ssh \
		-q \
		-i "$KEYFILE" \
		$OPTIONS \
		-o BatchMode=yes \
		-o PasswordAuthentication=no \
		-o KbdInteractiveAuthentication=no \
		-p "$port" \
		"${username}@${ipaddr}" \
		"$@" 2>/dev/null
}


#
# ---------------------------------------------------------------------------
# SSH password authentication
# ---------------------------------------------------------------------------
#

ssh_password_exec()
{
	local platform="$1"
	local ipaddr="$2"
	local port="$3"
	local username="$4"
	local password="$5"

	shift 5

	[ -n "$password" ] || return 1
	command -v sshpass >/dev/null 2>&1 || return 1

	local OPTIONS
	OPTIONS="$(get_ssh_options "$platform")"

	SSHPASS="$password" \
	sshpass -e \
	ssh \
		-q \
		$OPTIONS \
		-o PubkeyAuthentication=no \
		-o PreferredAuthentications=password,keyboard-interactive \
		-o BatchMode=no \
		-p "$port" \
		"${username}@${ipaddr}" \
		"$@" 2>/dev/null
}


#
# ---------------------------------------------------------------------------
# Universal remote SSH
# ---------------------------------------------------------------------------
#

REMOTE_AUTH_METHOD=""


remote_ssh()
{
	local platform="$1"
	local ipaddr="$2"
	local port="$3"
	local username="$4"
	local password="$5"

	shift 5

	REMOTE_AUTH_METHOD=""

	#
	# KEY FIRST
	#
	if [ -s "$KEYFILE" ]; then

		if ssh_key_exec \
			"$platform" \
			"$ipaddr" \
			"$port" \
			"$username" \
			"$@"; then

			REMOTE_AUTH_METHOD="key"
			return 0
		fi
	fi

	#
	# PASSWORD FALLBACK
	#
	if [ -n "$password" ]; then

		if ssh_password_exec \
			"$platform" \
			"$ipaddr" \
			"$port" \
			"$username" \
			"$password" \
			"$@"; then

			REMOTE_AUTH_METHOD="password"
			return 0
		fi
	fi

	return 1
}


#
# ---------------------------------------------------------------------------
# SCP key authentication
# ---------------------------------------------------------------------------
#

scp_key()
{
	local platform="$1"
	local ipaddr="$2"
	local port="$3"
	local username="$4"
	local source="$5"
	local destination="$6"

	[ -s "$KEYFILE" ] || return 1

	local OPTIONS
	OPTIONS="$(get_ssh_options "$platform")"

	scp \
		-q \
		-O \
		-i "$KEYFILE" \
		$OPTIONS \
		-o BatchMode=yes \
		-o PasswordAuthentication=no \
		-o KbdInteractiveAuthentication=no \
		-P "$port" \
		"$source" \
		"${username}@${ipaddr}:${destination}" \
		2>/dev/null
}


#
# ---------------------------------------------------------------------------
# SCP password authentication
# ---------------------------------------------------------------------------
#

scp_password()
{
	local platform="$1"
	local ipaddr="$2"
	local port="$3"
	local username="$4"
	local password="$5"
	local source="$6"
	local destination="$7"

	[ -n "$password" ] || return 1
	command -v sshpass >/dev/null 2>&1 || return 1

	local OPTIONS
	OPTIONS="$(get_ssh_options "$platform")"

	SSHPASS="$password" \
	sshpass -e \
	scp \
		-q \
		-O \
		$OPTIONS \
		-o PubkeyAuthentication=no \
		-o PreferredAuthentications=password,keyboard-interactive \
		-P "$port" \
		"$source" \
		"${username}@${ipaddr}:${destination}" \
		2>/dev/null
}


#
# ---------------------------------------------------------------------------
# Universal SCP
# ---------------------------------------------------------------------------
#

REMOTE_SCP_AUTH_METHOD=""


remote_scp()
{
	local platform="$1"
	local ipaddr="$2"
	local port="$3"
	local username="$4"
	local password="$5"
	local source="$6"
	local destination="$7"

	REMOTE_SCP_AUTH_METHOD=""

	if scp_key \
		"$platform" \
		"$ipaddr" \
		"$port" \
		"$username" \
		"$source" \
		"$destination"; then

		REMOTE_SCP_AUTH_METHOD="key"
		return 0
	fi

	if scp_password \
		"$platform" \
		"$ipaddr" \
		"$port" \
		"$username" \
		"$password" \
		"$source" \
		"$destination"; then

		REMOTE_SCP_AUTH_METHOD="password"
		return 0
	fi

	return 1
}


#
# ---------------------------------------------------------------------------
# Install public key on remote host
# ---------------------------------------------------------------------------
#

install_remote_key()
{
	local platform="$1"
	local ipaddr="$2"
	local port="$3"
	local username="$4"
	local password="$5"

	local remote_tmp
	local pub

	[ -s "$PUBKEY" ] || return 1
	[ -n "$password" ] || return 1

	#
	# Najpierw próbujemy SCP, tak jak w oryginalnym mechanizmie.
	#
	if scp_password \
		"$platform" \
		"$ipaddr" \
		"$port" \
		"$username" \
		"$password" \
		"$PUBKEY" \
		"/tmp/.apcontroller-key.pub"; then

		if ssh_password_exec \
			"$platform" \
			"$ipaddr" \
			"$port" \
			"$username" \
			"$password" \
			'
K="$HOME/.ssh/authorized_keys"

mkdir -p "$HOME/.ssh" 2>/dev/null || exit 1
chmod 700 "$HOME/.ssh" 2>/dev/null

touch "$K" 2>/dev/null || exit 1
chmod 600 "$K" 2>/dev/null

KEY="$(cat /tmp/.apcontroller-key.pub 2>/dev/null)"

[ -n "$KEY" ] || exit 1

if ! grep -F -q "$KEY" "$K" 2>/dev/null; then
	printf "%s\n" "$KEY" >> "$K" || exit 1
fi

rm -f /tmp/.apcontroller-key.pub

exit 0
'; then

			return 0
		fi

		#
		# Jeżeli SCP się udało, ale zdalny shell nie,
		# posprzątaj.
		#
		ssh_password_exec \
			"$platform" \
			"$ipaddr" \
			"$port" \
			"$username" \
			"$password" \
			"rm -f /tmp/.apcontroller-key.pub" \
			>/dev/null 2>&1
	fi

	#
	# Fallback bez SCP:
	# przesyłamy klucz przez stdin do ssh.
	#
	pub="$(cat "$PUBKEY" 2>/dev/null)"

	[ -n "$pub" ] || return 1

	if SSHPASS="$password" \
		sshpass -e \
		ssh \
			-q \
			$(get_ssh_options "$platform") \
			-o PubkeyAuthentication=no \
			-o PreferredAuthentications=password,keyboard-interactive \
			-p "$port" \
			"${username}@${ipaddr}" \
			"sh -c 'K=\"\$HOME/.ssh/authorized_keys\"; mkdir -p \"\$HOME/.ssh\" || exit 1; chmod 700 \"\$HOME/.ssh\"; touch \"\$K\" || exit 1; chmod 600 \"\$K\"; grep -F -q \"${pub}\" \"\$K\" 2>/dev/null || printf \"%s\n\" \"${pub}\" >> \"\$K\"'" \
			>/dev/null 2>&1; then

		return 0
	fi

	return 1
}


#
# ---------------------------------------------------------------------------
# Mark host as key-enabled
# ---------------------------------------------------------------------------
#

enable_host_key()
{
	local cfg="$1"

	[ -n "$cfg" ] || return 1

	uci_set "$cfg" usekeyfile 1
	uci_set "$cfg" keyfile "$KEYFILE"

	uci commit "$CONFIG" >/dev/null 2>&1
}


#
# ---------------------------------------------------------------------------
# Remote platform autodetection
# ---------------------------------------------------------------------------
#

detect_platform()
{
	local ipaddr="$1"
	local port="$2"
	local username="$3"
	local password="$4"

	local OUT=""
	local OPTIONS

	REMOTE_AUTH_METHOD=""

	ensure_local_key >/dev/null 2>&1

	OPTIONS="$DETECT_SSHOPTIONS"

	#
	# -----------------------------------------------------------------------
	# KEY FIRST
	# -----------------------------------------------------------------------
	#

	if [ -s "$KEYFILE" ]; then

		OUT="$(
			ssh \
				-q \
				-i "$KEYFILE" \
				$OPTIONS \
				-o BatchMode=yes \
				-o PasswordAuthentication=no \
				-o KbdInteractiveAuthentication=no \
				-p "$port" \
				"${username}@${ipaddr}" \
				'
printf "===APC_BEGIN===\n"

if command -v mca-cli >/dev/null 2>&1 ||
   command -v mca-cli-op >/dev/null 2>&1 ||
   command -v ubntbox >/dev/null 2>&1 ||
   command -v cfgmtd >/dev/null 2>&1 ||
   command -v syswrapper.sh >/dev/null 2>&1 ||
   command -v ubnt-util >/dev/null 2>&1 ||
   [ -f /etc/ubnt_version ] ||
   [ -f /etc/ubnt_version.info ] ||
   [ -d /etc/ubnt ] ||
   [ -d /etc/ubnt.d ] ||
   { [ -f /etc/version ] &&
     grep -qi "ubiquiti\|ubnt" /etc/version 2>/dev/null; }
then
	printf "UBIQUITI\n"
	exit 0
fi

if [ -f /etc/openwrt_release ] ||
   [ -f /etc/openwrt_version ] ||
   { [ -f /etc/os-release ] &&
     grep -qi "^[[:space:]]*ID=\"*openwrt" /etc/os-release 2>/dev/null; } ||
   command -v ubus >/dev/null 2>&1 ||
   command -v uci >/dev/null 2>&1
then
	printf "OPENWRT\n"
	exit 0
fi

if command -v cliclientd >/dev/null 2>&1 ||
   command -v tpctl >/dev/null 2>&1 ||
   [ -d /etc/omada ] ||
   [ -d /etc/tplink ] ||
   [ -d /etc/tp-link ]
then
	printf "OMADA\n"
	exit 0
fi

if command -v hostapd >/dev/null 2>&1 ||
   [ -d /etc/hostapd ] ||
   [ -d /sys/class/net ]
then
	printf "GENERIC\n"
	exit 0
fi

printf "GENERIC\n"
' 2>/dev/null
		)"

		if [ -n "$OUT" ]; then
			REMOTE_AUTH_METHOD="key"
		fi
	fi

	#
	# -----------------------------------------------------------------------
	# PASSWORD FALLBACK
	# -----------------------------------------------------------------------
	#

	if [ -z "$OUT" ] &&
	   [ -n "$password" ] &&
	   command -v sshpass >/dev/null 2>&1; then

		OUT="$(
			SSHPASS="$password" \
			sshpass -e \
			ssh \
				-q \
				$OPTIONS \
				-o PubkeyAuthentication=no \
				-o PreferredAuthentications=password,keyboard-interactive \
				-p "$port" \
				"${username}@${ipaddr}" \
				'
printf "===APC_BEGIN===\n"

if command -v mca-cli >/dev/null 2>&1 ||
   command -v mca-cli-op >/dev/null 2>&1 ||
   command -v ubntbox >/dev/null 2>&1 ||
   command -v cfgmtd >/dev/null 2>&1 ||
   command -v syswrapper.sh >/dev/null 2>&1 ||
   command -v ubnt-util >/dev/null 2>&1 ||
   [ -f /etc/ubnt_version ] ||
   [ -f /etc/ubnt_version.info ] ||
   [ -d /etc/ubnt ] ||
   [ -d /etc/ubnt.d ] ||
   { [ -f /etc/version ] &&
     grep -qi "ubiquiti\|ubnt" /etc/version 2>/dev/null; }
then
	printf "UBIQUITI\n"
	exit 0
fi

if [ -f /etc/openwrt_release ] ||
   [ -f /etc/openwrt_version ] ||
   { [ -f /etc/os-release ] &&
     grep -qi "^[[:space:]]*ID=\"*openwrt" /etc/os-release 2>/dev/null; } ||
   command -v ubus >/dev/null 2>&1 ||
   command -v uci >/dev/null 2>&1
then
	printf "OPENWRT\n"
	exit 0
fi

if command -v cliclientd >/dev/null 2>&1 ||
   command -v tpctl >/dev/null 2>&1 ||
   [ -d /etc/omada ] ||
   [ -d /etc/tplink ] ||
   [ -d /etc/tp-link ]
then
	printf "OMADA\n"
	exit 0
fi

if command -v hostapd >/dev/null 2>&1 ||
   [ -d /etc/hostapd ]
then
	printf "GENERIC\n"
	exit 0
fi

printf "GENERIC\n"
' 2>/dev/null
		)"

		if [ -n "$OUT" ]; then
			REMOTE_AUTH_METHOD="password"
		fi
	fi

	case "$OUT" in
		*UBIQUITI*)
			printf 'ubiquiti'
			;;

		*OMADA*)
			printf 'omada'
			;;

		*OPENWRT*)
			printf 'openwrt'
			;;

		*GENERIC*)
			printf 'generic'
			;;

		*)
			printf 'unknown'
			;;
	esac
}


#
# ---------------------------------------------------------------------------
# Agent selection
# ---------------------------------------------------------------------------
#

get_agent()
{
	local platform="$1"

	case "$platform" in

		openwrt)
			[ -x /usr/share/apcontroller/apcontroller-agent-openwrt ] &&
			echo /usr/share/apcontroller/apcontroller-agent-openwrt &&
			return 0
			;;

		ubiquiti)
			[ -x /usr/share/apcontroller/apcontroller-agent-ubiquiti ] &&
			echo /usr/share/apcontroller/apcontroller-agent-ubiquiti &&
			return 0
			;;

		omada)
			[ -x /usr/share/apcontroller/apcontroller-agent-omada ] &&
			echo /usr/share/apcontroller/apcontroller-agent-omada &&
			return 0
			;;

		generic)
			[ -x /usr/share/apcontroller/apcontroller-agent-generic ] &&
			echo /usr/share/apcontroller/apcontroller-agent-generic &&
			return 0
			;;

	esac

	if [ -x /usr/share/apcontroller/apcontroller-agent ]; then
		echo /usr/share/apcontroller/apcontroller-agent
		return 0
	fi

	echo ""
	return 1
}


#
# ---------------------------------------------------------------------------
# Normalize agent output
# ---------------------------------------------------------------------------
#

normalize_agent_output()
{
	local input="$1"

	if [ -n "$input" ] &&
	   printf '%s' "$input" |
	   jsonfilter -q -e '@' >/dev/null 2>&1; then

		local c2
		local c5
		local c6

		c2="$(printf '%s' "$input" |
			jsonfilter -q -e '@.clientslist2g' 2>/dev/null)"

		c5="$(printf '%s' "$input" |
			jsonfilter -q -e '@.clientslist5g' 2>/dev/null)"

		c6="$(printf '%s' "$input" |
			jsonfilter -q -e '@.clientslist6g' 2>/dev/null)"

		if [ -n "$c2" ] &&
		   [ -n "$c5" ] &&
		   [ -n "$c6" ]; then

			printf '%s' "$input"
			return 0
		fi
	fi

	empty_host_json
}


#
# ---------------------------------------------------------------------------
# Poll one host
# ---------------------------------------------------------------------------
#

get_data_from_host()
{
	local cfg="$1"

	local enabled
	local ipaddr
	local username
	local password
	local port
	local configured_platform

	local platform
	local agent

	local output
	local tmpoutput

	local now
	local timestamp
	local d
	local val
	local ret

	enabled="$(uci_get "$cfg" enabled 1)"

	case "$enabled" in
		1|on|true|yes)
			;;
		*)
			return 0
			;;
	esac

	ipaddr="$(uci_get "$cfg" ipaddr "")"
	username="$(uci_get "$cfg" username "")"
	password="$(uci_get "$cfg" password "")"
	port="$(uci_get "$cfg" port 22)"
	configured_platform="$(uci_get "$cfg" platform "")"

	[ -n "$ipaddr" ] || return 0
	[ -n "$username" ] || return 0

	ensure_local_key >/dev/null 2>&1

	platform="$(detect_platform \
		"$ipaddr" \
		"$port" \
		"$username" \
		"$password")"

	[ -n "$platform" ] || platform="unknown"

	if [ -n "$configured_platform" ] &&
	   [ "$configured_platform" != "auto" ]; then

		platform="$configured_platform"
	fi

	#
	# Jeśli faktycznie weszliśmy hasłem, instalujemy klucz.
	#
	if [ "$REMOTE_AUTH_METHOD" = "password" ] &&
	   [ -n "$password" ]; then

		if install_remote_key \
			"$platform" \
			"$ipaddr" \
			"$port" \
			"$username" \
			"$password"; then

			enable_host_key "$cfg"
		fi
	fi

	agent="$(get_agent "$platform")"

	output="${BASEPATH}/${ipaddr}-${cfg}"
	tmpoutput="${output}.tmp"

	rm -f "$tmpoutput"

	printf '%s\n' "$platform" \
		> "${BASEPATH}/${ipaddr}-${cfg}.platform"

	if [ -n "$agent" ]; then

		if remote_scp \
			"$platform" \
			"$ipaddr" \
			"$port" \
			"$username" \
			"$password" \
			"$agent" \
			"/tmp/apcontroller-agent"; then

			remote_ssh \
				"$platform" \
				"$ipaddr" \
				"$port" \
				"$username" \
				"$password" \
				"chmod +x /tmp/apcontroller-agent; /tmp/apcontroller-agent" \
				> "$tmpoutput"

			ret=$?

			remote_ssh \
				"$platform" \
				"$ipaddr" \
				"$port" \
				"$username" \
				"$password" \
				"rm -f /tmp/apcontroller-agent" \
				>/dev/null 2>&1

			if [ "$ret" -eq 0 ] && [ -s "$tmpoutput" ]; then

				if jsonfilter -q -i "$tmpoutput" -e '@' \
					>/dev/null 2>&1; then

					normalize_agent_output \
						"$(cat "$tmpoutput")" \
						> "$output"

				else
					empty_host_json > "$output"
				fi
			fi

			rm -f "$tmpoutput"
		fi
	fi

	if [ ! -s "$output" ]; then
		empty_host_json > "$output"
	fi

	now="$(date +%s)"
	val=0

	if [ -s "$output" ]; then

		timestamp="$(date +%s -r "$output" 2>/dev/null)"

		case "$timestamp" in
			''|*[!0-9]*)
				timestamp=0
				;;
		esac

		d=$((now - timestamp))

		[ "$d" -le 180 ] && val=1
	fi

	#
	# Godzinowy zapis aktywności.
	#
	local hourstamp

	hourstamp="$(
		date -d "$(date -d @"$now" '+%Y-%m-%d %H:00')" +%s \
		2>/dev/null
	)"

	case "$hourstamp" in
		''|*[!0-9]*)
			hourstamp="$now"
			;;
	esac

	touch "${BASEPATH}/${ipaddr}.txt"

	if ! grep -q "^${hourstamp} ${val}$" \
		"${BASEPATH}/${ipaddr}.txt" 2>/dev/null; then

		echo "$hourstamp $val" >> "${BASEPATH}/${ipaddr}.txt"
	fi
}


#
# ---------------------------------------------------------------------------
# Host cache
# ---------------------------------------------------------------------------
#

host_json()
{
	local cfg="$1"
	local ipaddr="$2"

	if [ -n "$ipaddr" ] &&
	   [ -s "${BASEPATH}/${ipaddr}-${cfg}" ]; then

		cat "${BASEPATH}/${ipaddr}-${cfg}"

	else
		empty_host_json
	fi
}


#
# ---------------------------------------------------------------------------
# Build one host JSON
# ---------------------------------------------------------------------------
#

build_one_host()
{
	local cfg="$1"

	local ipaddr
	local name
	local enabled
	local platform
	local data
	local cache

	local lastcontact
	local now
	local ts

	local mac
	local hostname
	local model
	local software
	local vendor
	local uptime
	local load

	local channels2g
	local channels5g
	local channels6g

	local clients2g
	local clients5g
	local clients6g

	ipaddr="$(uci_get "$cfg" ipaddr "")"
	name="$(uci_get "$cfg" name "")"
	enabled="$(uci_get "$cfg" enabled 1)"

	[ -n "$ipaddr" ] || return 0

	platform="$(cat \
		"${BASEPATH}/${ipaddr}-${cfg}.platform" \
		2>/dev/null)"

	[ -n "$platform" ] || platform="unknown"

	data="$(host_json "$cfg" "$ipaddr" 2>/dev/null)"

	[ -n "$data" ] || data="$(empty_host_json)"

	lastcontact=-1
	cache="${BASEPATH}/${ipaddr}-${cfg}"

	if [ -s "$cache" ]; then

		now="$(date +%s)"
		ts="$(date +%s -r "$cache" 2>/dev/null)"

		case "$ts" in
			''|*[!0-9]*)
				lastcontact=-1
				;;

			*)
				lastcontact=$((now - ts))

				[ "$lastcontact" -lt 0 ] &&
					lastcontact=0
				;;
		esac
	fi

	mac="$(printf '%s' "$data" |
		jsonfilter -q -e '@.mac' 2>/dev/null)"

	hostname="$(printf '%s' "$data" |
		jsonfilter -q -e '@.hostname' 2>/dev/null)"

	model="$(printf '%s' "$data" |
		jsonfilter -q -e '@.model' 2>/dev/null)"

	software="$(printf '%s' "$data" |
		jsonfilter -q -e '@.software' 2>/dev/null)"

	uptime="$(printf '%s' "$data" |
		jsonfilter -q -e '@.uptime' 2>/dev/null)"

	load="$(printf '%s' "$data" |
		jsonfilter -q -e '@.load' 2>/dev/null)"

	channels2g="$(printf '%s' "$data" |
		jsonfilter -q -e '@.channels2g' 2>/dev/null)"

	channels5g="$(printf '%s' "$data" |
		jsonfilter -q -e '@.channels5g' 2>/dev/null)"

	channels6g="$(printf '%s' "$data" |
		jsonfilter -q -e '@.channels6g' 2>/dev/null)"

	vendor=""

	case "$model $software" in

		*Ubiquiti*|*UBNT*|*UniFi*)
			vendor="Ubiquiti"
			;;

		*TP-Link*|*TP_LINK*|*Archer*|*TL-WDR*)
			vendor="TP-Link"
			;;

		*Omada*)
			vendor="TP-Link"
			;;

		*)
			case "$platform" in
				ubiquiti)
					vendor="Ubiquiti"
					;;
				omada)
					vendor="TP-Link"
					;;
				openwrt)
					vendor="OpenWrt"
					;;
				generic)
					vendor="Generic"
					;;
				*)
					vendor=""
					;;
			esac
			;;

	esac

	if [ -n "$vendor" ] && [ -n "$software" ]; then
		software="$vendor / $software"
	fi

	clients2g="$(printf '%s' "$data" |
		jsonfilter -q -e '@.clientslist2g' 2>/dev/null)"

	clients5g="$(printf '%s' "$data" |
		jsonfilter -q -e '@.clientslist5g' 2>/dev/null)"

	clients6g="$(printf '%s' "$data" |
		jsonfilter -q -e '@.clientslist6g' 2>/dev/null)"

	[ -n "$clients2g" ] || clients2g='[]'
	[ -n "$clients5g" ] || clients5g='[]'
	[ -n "$clients6g" ] || clients6g='[]'

	case "$uptime" in
		''|*[!0-9-]*)
			uptime=0
			;;
	esac

	printf '{'

	printf '"section":%s,' \
		"$(json_string "$cfg")"

	printf '"name":%s,' \
		"$(json_string "$name")"

	printf '"ipaddr":%s,' \
		"$(json_string "$ipaddr")"

	printf '"platform":%s,' \
		"$(json_string "$platform")"

	printf '"vendor":%s,' \
		"$(json_string "$vendor")"

	printf '"enabled":%s,' \
		"$(json_number "$enabled")"

	printf '"mac":%s,' \
		"$(json_string "$mac")"

	printf '"hostname":%s,' \
		"$(json_string "$hostname")"

	printf '"model":%s,' \
		"$(json_string "$model")"

	printf '"software":%s,' \
		"$(json_string "$software")"

	printf '"uptime":%s,' \
		"$(json_number "$uptime")"

	printf '"load":%s,' \
		"$(json_string "$load")"

	printf '"lastcontact":%s,' \
		"$(json_number "$lastcontact")"

	printf '"channels2g":%s,' \
		"$(json_string "$channels2g")"

	printf '"channels5g":%s,' \
		"$(json_string "$channels5g")"

	printf '"channels6g":%s,' \
		"$(json_string "$channels6g")"

	printf '"clientslist2g":%s,' \
		"$clients2g"

	printf '"clientslist5g":%s,' \
		"$clients5g"

	printf '"clientslist6g":%s' \
		"$clients6g"

	printf '}'
}


#
# ---------------------------------------------------------------------------
# Build hosts
# ---------------------------------------------------------------------------
#

build_hosts()
{
	local first=1
	local cfg
	local item

	printf '['

	for cfg in $(host_sections); do

		item="$(build_one_host "$cfg" 2>/dev/null)"

		[ -n "$item" ] || continue

		if [ "$first" -eq 0 ]; then
			printf ','
		fi

		printf '%s' "$item"

		first=0
	done

	printf ']'
}


#
# ---------------------------------------------------------------------------
# RPC status
# ---------------------------------------------------------------------------
#

rpc_status()
{
	printf '{"hosts":'
	build_hosts
	printf '}\n'
}


#
# ---------------------------------------------------------------------------
# RPC poll
# ---------------------------------------------------------------------------
#

rpc_poll()
{
	local cfg

	#
	# Nie robimy "discover" podczas poll.
	# Poll dotyczy tylko hostów już zapisanych w UCI.
	#

	for cfg in $(host_sections); do
		get_data_from_host "$cfg" &
	done

	#
	# Poczekaj na wszystkie procesy.
	#
	wait

	printf '{"ok":true}\n'
}


#
# ---------------------------------------------------------------------------
# RPC activity
# ---------------------------------------------------------------------------
#

rpc_activity()
{
	local input
	local section
	local ipaddr
	local file
	local first=1
	local timestamp
	local value

	input="$(cat)"

	section="$(printf '%s' "$input" |
		jsonfilter -q -e '@.section' 2>/dev/null)"

	[ -n "$section" ] || {
		printf '{"activity":[]}\n'
		return 0
	}

	ipaddr="$(uci_get "$section" ipaddr "")"

	[ -n "$ipaddr" ] || {
		printf '{"activity":[]}\n'
		return 0
	}

	file="${BASEPATH}/${ipaddr}.txt"

	printf '{"activity":['

	if [ -f "$file" ]; then

		while read -r timestamp value; do

			[ -n "$timestamp" ] || continue
			[ -n "$value" ] || value=0

			if [ "$first" -eq 0 ]; then
				printf ','
			fi

			first=0

			printf '{"timestamp":%s,"value":%s}' \
				"$(json_number "$timestamp")" \
				"$(json_number "$value")"

		done < "$file"
	fi

	printf ']}\n'
}


#
# ---------------------------------------------------------------------------
# Discovery credentials
# ---------------------------------------------------------------------------
#

get_discovery_credentials()
{
	DISCOVERY_USERNAME="$(uci -q get \
		"${CONFIG}.@global[0].username" \
		2>/dev/null)"

	DISCOVERY_PASSWORD="$(uci -q get \
		"${CONFIG}.@global[0].password" \
		2>/dev/null)"

	DISCOVERY_PORT="$(uci -q get \
		"${CONFIG}.@global[0].port" \
		2>/dev/null)"

	[ -n "$DISCOVERY_PORT" ] || DISCOVERY_PORT=22

	if [ -z "$DISCOVERY_USERNAME" ]; then

		local cfg
		local enabled

		for cfg in $(host_sections); do

			enabled="$(uci_get "$cfg" enabled 1)"

			case "$enabled" in
				1|on|true|yes)
					;;
				*)
					continue
					;;
			esac

			DISCOVERY_USERNAME="$(uci_get "$cfg" username "")"
			DISCOVERY_PASSWORD="$(uci_get "$cfg" password "")"
			DISCOVERY_PORT="$(uci_get "$cfg" port "$DISCOVERY_PORT")"

			[ -n "$DISCOVERY_USERNAME" ] && break
		done
	fi
}


#
# ---------------------------------------------------------------------------
# Add discovered host to UCI
# ---------------------------------------------------------------------------
#

add_discovered_host()
{
	local ipaddr="$1"
	local platform="$2"
	local username="$3"
	local password="$4"
	local port="$5"

	local existing
	local name

	existing="$(host_exists_ip "$ipaddr" 2>/dev/null)"

	if [ -n "$existing" ]; then

		if [ -n "$username" ] &&
		   [ -z "$(uci_get "$existing" username "")" ]; then
			uci_set "$existing" username "$username"
		fi

		if [ -n "$password" ] &&
		   [ -z "$(uci_get "$existing" password "")" ]; then
			uci_set "$existing" password "$password"
		fi

		if [ -n "$port" ] &&
		   [ -z "$(uci_get "$existing" port "")" ]; then
			uci_set "$existing" port "$port"
		fi

		if [ -z "$(uci_get "$existing" platform "")" ]; then
			uci_set "$existing" platform "$platform"
		fi

		printf '%s' "$existing"
		return 0
	fi

	name="$(next_host_name "host")"

	uci -q set "${CONFIG}.${name}=host"

	uci_set "$name" enabled 1
	uci_set "$name" name "AP-${ipaddr}"
	uci_set "$name" ipaddr "$ipaddr"
	uci_set "$name" port "$port"
	uci_set "$name" username "$username"
	uci_set "$name" password "$password"
	uci_set "$name" platform "$platform"
	uci_set "$name" usekeyfile 0
	uci_set "$name" keyfile "$KEYFILE"
	uci_set "$name" url "http://${ipaddr}"

	printf '%s' "$name"
}


#
# ---------------------------------------------------------------------------
# Discovery interface filter
# ---------------------------------------------------------------------------
#

discovery_interface_allowed()
{
	local iface="$1"

	#
	# Absolutny zakaz WAN/GUEST.
	#
	case "$iface" in
		wan|wan6|wan_*|wan6_*|guest|guest_*|guest*)
			return 1
			;;
	esac

	#
	# LAN.
	#
	case "$iface" in
		lan|lan_*)
			return 0
			;;
	esac

	#
	# VPN.
	#
	case "$iface" in
		vpn|vpn_*)
			return 0
			;;
	esac

	#
	# WireGuard.
	#
	case "$iface" in
		wg*|wireguard*)
			return 0
			;;
	esac

	#
	# IPsec.
	#
	case "$iface" in
		ipsec*)
			return 0
			;;
	esac

	#
	# Tunnel.
	#
	case "$iface" in
		tun*)
			return 0
			;;
	esac

	return 1
}


#
# ---------------------------------------------------------------------------
# Calculate network from IPv4 + prefix
# ---------------------------------------------------------------------------
#

calculate_network()
{
	local addr="$1"
	local prefix="$2"

	local a
	local b
	local c
	local d

	local va
	local vb
	local vc
	local vd

	#
	# Prefix musi być liczbą 1..32.
	#
	case "$prefix" in
		''|*[!0-9]*)
			return 1
			;;
	esac

	[ "$prefix" -ge 1 ] 2>/dev/null || return 1
	[ "$prefix" -le 32 ] 2>/dev/null || return 1

	#
	# Rozbij IPv4.
	#
	IFS=.
	set -- $addr
	IFS=' '

	[ "$#" -eq 4 ] || return 1

	a="$1"
	b="$2"
	c="$3"
	d="$4"

	#
	# Wszystkie oktety muszą być liczbami.
	#
	for va in "$a" "$b" "$c" "$d"; do
		case "$va" in
			''|*[!0-9]*)
				return 1
				;;
		esac

		[ "$va" -le 255 ] 2>/dev/null || return 1
	done

	#
	# Maska oktetowa.
	#
	case "$prefix" in
		1)  m1=128; m2=0;   m3=0;   m4=0 ;;
		2)  m1=192; m2=0;   m3=0;   m4=0 ;;
		3)  m1=224; m2=0;   m3=0;   m4=0 ;;
		4)  m1=240; m2=0;   m3=0;   m4=0 ;;
		5)  m1=248; m2=0;   m3=0;   m4=0 ;;
		6)  m1=252; m2=0;   m3=0;   m4=0 ;;
		7)  m1=254; m2=0;   m3=0;   m4=0 ;;
		8)  m1=255; m2=0;   m3=0;   m4=0 ;;
		9)  m1=255; m2=128; m3=0;   m4=0 ;;
		10) m1=255; m2=192; m3=0;   m4=0 ;;
		11) m1=255; m2=224; m3=0;   m4=0 ;;
		12) m1=255; m2=240; m3=0;   m4=0 ;;
		13) m1=255; m2=248; m3=0;   m4=0 ;;
		14) m1=255; m2=252; m3=0;   m4=0 ;;
		15) m1=255; m2=254; m3=0;   m4=0 ;;
		16) m1=255; m2=255; m3=0;   m4=0 ;;
		17) m1=255; m2=255; m3=128; m4=0 ;;
		18) m1=255; m2=255; m3=192; m4=0 ;;
		19) m1=255; m2=255; m3=224; m4=0 ;;
		20) m1=255; m2=255; m3=240; m4=0 ;;
		21) m1=255; m2=255; m3=248; m4=0 ;;
		22) m1=255; m2=255; m3=252; m4=0 ;;
		23) m1=255; m2=255; m3=254; m4=0 ;;
		24) m1=255; m2=255; m3=255; m4=0 ;;
		25) m1=255; m2=255; m3=255; m4=128 ;;
		26) m1=255; m2=255; m3=255; m4=192 ;;
		27) m1=255; m2=255; m3=255; m4=224 ;;
		28) m1=255; m2=255; m3=255; m4=240 ;;
		29) m1=255; m2=255; m3=255; m4=248 ;;
		30) m1=255; m2=255; m3=255; m4=252 ;;
		31) m1=255; m2=255; m3=255; m4=254 ;;
		32) m1=255; m2=255; m3=255; m4=255 ;;
		*)
			return 1
			;;
	esac

	a=$((a & m1))
	b=$((b & m2))
	c=$((c & m3))
	d=$((d & m4))

	printf '%s.%s.%s.%s/%s\n' \
		"$a" "$b" "$c" "$d" "$prefix"
}


#
# ---------------------------------------------------------------------------
# IPv4 -> integer
# ---------------------------------------------------------------------------
#

ipv4_to_int()
{
	local ip="$1"

	IFS=.
	set -- $ip
	IFS=' '

	[ "$#" -eq 4 ] || return 1

	printf '%s\n' \
		$((($1 * 16777216) + ($2 * 65536) + ($3 * 256) + $4))
}


#
# ---------------------------------------------------------------------------
# Integer -> IPv4
# ---------------------------------------------------------------------------
#

int_to_ipv4()
{
	local n="$1"

	local a
	local b
	local c
	local d

	a=$((n / 16777216))
	n=$((n - a * 16777216))

	b=$((n / 65536))
	n=$((n - b * 65536))

	c=$((n / 256))
	d=$((n - c * 256))

	printf '%s.%s.%s.%s\n' "$a" "$b" "$c" "$d"
}


#
# ---------------------------------------------------------------------------
# Get interface status
# ---------------------------------------------------------------------------
#

get_interface_ipv4()
{
	local iface="$1"

	ubus call "network.interface.${iface}" status 2>/dev/null
}


#
# ---------------------------------------------------------------------------
# Discover networks
# ---------------------------------------------------------------------------
#

discover_networks()
{
	local netfile="$1"

	local iface
	local status
	local up
	local addr
	local mask
	local network

	[ -n "$netfile" ] || return 1

	#
	# UBUS is wymagany do poprawnego discovery OpenWrt.
	#
	command -v ubus >/dev/null 2>&1 || return 1
	command -v jsonfilter >/dev/null 2>&1 || return 1

	for iface in $(
		ubus call network.interface dump 2>/dev/null |
		jsonfilter -q -e '@.interface[*].interface' 2>/dev/null
	); do

		discovery_interface_allowed "$iface" || continue

		status="$(get_interface_ipv4 "$iface")"

		[ -n "$status" ] || continue

		up="$(
			printf '%s' "$status" |
			jsonfilter -q -e '@.up' 2>/dev/null
		)"

		case "$up" in
			true|1)
				;;
			*)
				continue
				;;
		esac

		#
		# IPv4 address.
		#
		addr="$(
			printf '%s' "$status" |
			jsonfilter -q -e '@["ipv4-address"][0].address' \
			2>/dev/null
		)"

		#
		# OpenWrt ubus zwraca tutaj PREFIX, np. 24,
		# a nie dotted netmask.
		#
		mask="$(
			printf '%s' "$status" |
			jsonfilter -q -e '@["ipv4-address"][0].mask' \
			2>/dev/null
		)"

		[ -n "$addr" ] || continue
		[ -n "$mask" ] || continue

		case "$addr" in
			0.0.0.0|127.*)
				continue
				;;
		esac

		case "$mask" in
			''|*[!0-9]*)
				continue
				;;
		esac

		[ "$mask" -ge 1 ] 2>/dev/null || continue
		[ "$mask" -le 32 ] 2>/dev/null || continue

		network="$(calculate_network "$addr" "$mask")"

		[ -n "$network" ] || continue

		if ! grep -F -q "^${network}$" "$netfile" 2>/dev/null; then
			printf '%s\n' "$network" >> "$netfile"
		fi
	done

	#
	# Fallback tylko wtedy, gdy UBUS nie znalazł żadnej sieci.
	#
	if [ ! -s "$netfile" ] &&
	   command -v ip >/dev/null 2>&1; then

		ip -4 addr show scope global 2>/dev/null |
		awk '
		{
			for (i=1; i<=NF; i++) {
				if ($i ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+\/[0-9]+$/) {
					print $i
				}
			}
		}
		' |
		while read -r addrprefix; do

			addr="${addrprefix%/*}"
			mask="${addrprefix#*/}"

			network="$(calculate_network "$addr" "$mask")"

			[ -n "$network" ] || continue

			#
			# Fallback jest tylko dla adresów globalnych.
			#
			case "$network" in
				0.0.0.0/*)
					continue
					;;
			esac

			if ! grep -F -q "^${network}$" "$netfile" 2>/dev/null; then
				printf '%s\n' "$network" >> "$netfile"
			fi
		done
	fi

	sort -u "$netfile" -o "$netfile" 2>/dev/null

	return 0
}


#
# ---------------------------------------------------------------------------
# Check TCP port
# ---------------------------------------------------------------------------
#

tcp_port_open()
{
	local ip="$1"
	local port="$2"

	#
	# BusyBox nc jest różny zależnie od builda.
	# Nie używamy -z.
	#
	if command -v nc >/dev/null 2>&1; then

		nc \
			-w 1 \
			"$ip" \
			"$port" \
			</dev/null \
			>/dev/null 2>&1

		return $?
	fi

	#
	# Bez nc pozwalamy SSH zrobić właściwy test.
	#
	return 0
}


#
# ---------------------------------------------------------------------------
# Scan one IP
# ---------------------------------------------------------------------------
#

discover_one_host()
{
	local target="$1"
	local port="$2"
	local username="$3"
	local password="$4"
	local hostfile="$5"

	local platform
	local cfg
	local existing

	#
	# Najpierw tani test TCP, jeśli nc jest dostępne.
	#
	if command -v nc >/dev/null 2>&1; then
		tcp_port_open "$target" "$port" || return 0
	fi

	platform="$(
		detect_platform \
			"$target" \
			"$port" \
			"$username" \
			"$password"
	)"

	case "$platform" in
		unknown|"")
			return 0
			;;

		*)
			;;
	esac

	#
	# Dodaj/uzupełnij UCI.
	#
	cfg="$(
		add_discovered_host \
			"$target" \
			"$platform" \
			"$username" \
			"$password" \
			"$port"
	)"

	#
	# Jeżeli detekcja weszła hasłem, instalujemy klucz.
	#
	if [ "$REMOTE_AUTH_METHOD" = "password" ] &&
	   [ -n "$password" ]; then

		if install_remote_key \
			"$platform" \
			"$target" \
			"$port" \
			"$username" \
			"$password"; then

			if [ -n "$cfg" ]; then
				enable_host_key "$cfg"
			else
				existing="$(
					host_exists_ip "$target" 2>/dev/null
				)"

				[ -n "$existing" ] &&
					enable_host_key "$existing"
			fi
		fi
	fi

	printf '%s|%s|%s\n' \
		"$target" \
		"$platform" \
		"$cfg" >> "$hostfile"
}


#
# ---------------------------------------------------------------------------
# RPC discovery
# ---------------------------------------------------------------------------
#

rpc_discover()
{
	local username
	local password
	local port

	local netfile
	local hostfile

	local iface
	local up
	local addr
	local mask

	local network
	local base
	local cidr

	local scan_start
	local scan_end
	local scan_ip
	local target

	local platform
	local cfg
	local existing

	local first
	local baseaddr
	local scan_range

	get_discovery_credentials

	username="$DISCOVERY_USERNAME"
	password="$DISCOVERY_PASSWORD"
	port="$DISCOVERY_PORT"

	[ -n "$port" ] || port=22

	if [ -z "$username" ]; then
		printf '{"ok":false,"error":"discovery username is empty"}\n'
		return 1
	fi

	ensure_local_key >/dev/null 2>&1

	netfile="${BASEPATH}/.discover-networks.$$"
	hostfile="${BASEPATH}/.discover-hosts.$$"

	rm -f "$netfile" "$hostfile"
	: > "$netfile"
	: > "$hostfile"

	#
	# ===============================================================
	# DISCOVERY NETWORKS
	#
	# TYLKO:
	#
	#   lan
	#   lan_*
	#   vpn
	#   vpn_*
	#   wg*
	#   wireguard*
	#   ipsec*
	#   tun*
	#
	# NIGDY:
	#
	#   wan
	#   wan6
	#   guest
	#   loopback
	#
	# ===============================================================
	#

	if command -v ubus >/dev/null 2>&1 &&
	   command -v jsonfilter >/dev/null 2>&1; then

		for iface in $(
			ubus call network.interface dump 2>/dev/null |
			jsonfilter -q -e '@.interface[*].interface' 2>/dev/null
		); do

			if ! discovery_interface_allowed "$iface"; then
				continue
			fi

			#
			# Twarda ochrona WAN/GUEST.
			#
			case "$iface" in
				wan|wan6|wan_*|wan6_*|guest|guest_*|loopback)
					continue
					;;
			esac

			#
			# Interface musi być UP.
			#
			up="$(
				ubus call "network.interface.${iface}" status 2>/dev/null |
				jsonfilter -q -e '@.up' 2>/dev/null
			)"

			case "$up" in
				true|1)
					;;
				*)
					continue
					;;
			esac

			#
			# REAL IPv4 address.
			#
			addr="$(
				ubus call "network.interface.${iface}" status 2>/dev/null |
				jsonfilter -q -e '@["ipv4-address"][0].address' 2>/dev/null
			)"

			#
			# REAL prefix.
			#
			mask="$(
				ubus call "network.interface.${iface}" status 2>/dev/null |
				jsonfilter -q -e '@["ipv4-address"][0].mask' 2>/dev/null
			)"

			[ -n "$addr" ] || continue
			[ -n "$mask" ] || continue

			case "$addr" in
				*[!0-9.]*)
					continue
					;;
			esac

			case "$mask" in
				''|*[!0-9]*)
					continue
					;;
			esac

			[ "$mask" -ge 1 ] 2>/dev/null || continue
			[ "$mask" -le 32 ] 2>/dev/null || continue

			cidr="$mask"

			#
			# =======================================================
			# REAL NETWORK = address AND netmask
			#
			# Nie wolno tutaj używać samego adresu.
			# =======================================================
			#

			base="$(
				awk -F. -v p="$cidr" '
				{
					a=$1
					b=$2
					c=$3
					d=$4

					if (p <= 8) {
						x=2^(8-p)
						a=int(a/x)*x
						printf "%d.0.0.0\n", a
						exit
					}

					if (p <= 16) {
						x=2^(16-p)
						b=int(b/x)*x
						printf "%d.%d.0.0\n", a,b
						exit
					}

					if (p <= 24) {
						x=2^(24-p)
						c=int(c/x)*x
						printf "%d.%d.%d.0\n", a,b,c
						exit
					}

					x=2^(32-p)
					d=int(d/x)*x

					printf "%d.%d.%d.%d\n", a,b,c,d
					exit
				}
				' 2>/dev/null
			)"

			[ -n "$base" ] || continue

			network="${base}/${cidr}"

			#
			# Ta sama sieć może być widoczna przez kilka interfejsów.
			#
			if ! grep -F -x -q "$network" "$netfile" 2>/dev/null; then
				printf '%s\n' "$network" >> "$netfile"
			fi

		done

	else

		#
		# ===========================================================
		# FALLBACK
		# ===========================================================
		#

		if command -v ip >/dev/null 2>&1; then

			ip -4 route show scope link 2>/dev/null |
			while read -r network rest; do

				[ -n "$network" ] || continue

				case "$network" in
					default|0.0.0.0/*)
						continue
						;;
				esac

				case "$rest" in
					*dev\ wan*|*dev\ wan6*|*dev\ guest*)
						continue
						;;
				esac

				case "$network" in
					*[!0-9./]*)
						continue
						;;
				esac

				printf '%s\n' "$network"

			done >> "$netfile"
		fi
	fi

	#
	# Unikalne sieci.
	#
	if [ -s "$netfile" ]; then
		sort -u "$netfile" > "${netfile}.sort" 2>/dev/null &&
		mv "${netfile}.sort" "$netfile" 2>/dev/null
	fi

	#
	# ===============================================================
	# SCAN
	# ===============================================================
	#

	while read -r network; do

		[ -n "$network" ] || continue

		cidr="${network#*/}"
		base="${network%/*}"

		case "$cidr" in
			''|*[!0-9]*)
				continue
				;;
		esac

		[ "$cidr" -ge 1 ] 2>/dev/null || continue
		[ "$cidr" -le 32 ] 2>/dev/null || continue

		#
		# ===========================================================
		# NETWORK -> integer range
		# ===========================================================
		#

		scan_range="$(
			awk -F. -v p="$cidr" '
			{
				n=($1*16777216)+
				  ($2*65536)+
				  ($3*256)+
				  $4

				size=2^(32-p)

				start=n
				end=n+size-1

				#
				# /31 i /32 nie mają klasycznego
				# network/broadcast do pominięcia.
				#
				if (p < 31) {
					start=n+1
					end=n+size-2
				}

				printf "%.0f %.0f\n",start,end
				exit
			}
			' 2>/dev/null
		)"

		set -- $scan_range

		scan_start="$1"
		scan_end="$2"

		case "$scan_start" in
			''|*[!0-9]*)
				continue
				;;
		esac

		case "$scan_end" in
			''|*[!0-9]*)
				continue
				;;
		esac

		[ "$scan_start" -le "$scan_end" ] 2>/dev/null || continue

		#
		# ===========================================================
		# Znajdź lokalny adres w tej sieci.
		# ===========================================================
		#

		baseaddr=""

		if command -v ip >/dev/null 2>&1; then

			baseaddr="$(
				ip -4 addr show 2>/dev/null |
				awk -v wanted="$base" -v prefix="$cidr" '
				{
					for (i=1; i<=NF; i++) {

						if ($i ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+\/[0-9]+$/) {

							split($i,a,"/")

							ip=a[1]
							p=a[2]

							if (p != prefix)
								continue

							split(ip,b,".")

							n=(b[1]*16777216)+
							  (b[2]*65536)+
							  (b[3]*256)+
							  b[4]

							split(wanted,c,".")

							w=(c[1]*16777216)+
							  (c[2]*65536)+
							  (c[3]*256)+
							  c[4]

							size=2^(32-prefix)
							net=int(n/size)*size

							if (net == w) {
								print ip
								exit
							}
						}
					}
				}'
			)"
		fi

		#
		# ===========================================================
		# Scan wszystkich hostów.
		#
		# WAŻNE:
		# NIE używamy już nc jako filtra.
		#
		# detect_platform() wykonuje właściwą próbę SSH:
		#   1. klucz
		#   2. hasło
		#
		# Dzięki temu host nie zostanie odrzucony przez
		# różne implementacje nc na OpenWrt.
		# ===========================================================
		#

		scan_ip="$scan_start"

		while [ "$scan_ip" -le "$scan_end" ] 2>/dev/null; do

			target="$(
				awk -v n="$scan_ip" '
				BEGIN {
					a=int(n/16777216)
					n=n-a*16777216

					b=int(n/65536)
					n=n-b*65536

					c=int(n/256)
					d=n-c*256

					printf "%d.%d.%d.%d\n",a,b,c,d
				}'
			)"

			#
			# Nie próbuj własnego adresu.
			#
			if [ "$target" = "$baseaddr" ]; then
				scan_ip=$((scan_ip + 1))
				continue
			fi

			#
			# =======================================================
			# DIRECT SSH DETECTION
			# =======================================================
			#

			REMOTE_AUTH_METHOD=""

			platform="$(
				detect_platform \
					"$target" \
					"$port" \
					"$username" \
					"$password"
			)"

			case "$platform" in

				ubiquiti|openwrt|omada|generic)

					#
					# =================================================
					# HOST -> UCI
					# =================================================
					#

					cfg="$(
						add_discovered_host \
							"$target" \
							"$platform" \
							"$username" \
							"$password" \
							"$port"
					)"

					#
					# add_discovered_host() powinno zawsze
					# zwrócić nazwę sekcji.
					#
					if [ -n "$cfg" ]; then

						#
						# Jeśli wykrycie nastąpiło hasłem,
						# natychmiast instalujemy lokalny klucz.
						#
						if [ "$REMOTE_AUTH_METHOD" = "password" ] &&
						   [ -n "$password" ]; then

							if install_remote_key \
								"$platform" \
								"$target" \
								"$port" \
								"$username" \
								"$password"; then

								enable_host_key "$cfg"
							fi
						fi

						#
						# Zapisz wynik discovery.
						#
						printf '%s|%s|%s\n' \
							"$target" \
							"$platform" \
							"$cfg" \
							>> "$hostfile"

					fi
					;;

				*)
					;;
			esac

			scan_ip=$((scan_ip + 1))

		done

	done < "$netfile"

	#
	# ===============================================================
	# COMMIT UCI
	# ===============================================================
	#

	uci commit "$CONFIG" >/dev/null 2>&1

	#
	# ===============================================================
	# RESULT
	# ===============================================================
	#

	printf '{"ok":true,"networks":['

	first=1

	while read -r network; do

		[ -n "$network" ] || continue

		if [ "$first" -eq 0 ]; then
			printf ','
		fi

		first=0

		printf '%s' "$(json_string "$network")"

	done < "$netfile"

	printf '],"hosts":['

	first=1

	while IFS='|' read -r ipaddr platform cfg; do

		[ -n "$ipaddr" ] || continue

		if [ "$first" -eq 0 ]; then
			printf ','
		fi

		first=0

		printf '{'

		printf '"ipaddr":%s,' \
			"$(json_string "$ipaddr")"

		printf '"platform":%s,' \
			"$(json_string "$platform")"

		printf '"section":%s,' \
			"$(json_string "$cfg")"

		printf '"added":true'

		printf '}'

	done < "$hostfile"

	printf ']}\n'

	rm -f \
		"$netfile" \
		"$hostfile"

	return 0
}


#
# ---------------------------------------------------------------------------
# RPC scripts
# ---------------------------------------------------------------------------
#

rpc_scripts()
{
	local first=1
	local file
	local filename
	local description
	local warn

	printf '{"scripts":['

	for file in /usr/share/apcontroller/scripts/*; do

		[ -f "$file" ] || continue

		filename="$(basename "$file")"
		description="$filename"
		warn=0

		if grep -q '^# APController-Warn:[[:space:]]*1' \
			"$file" 2>/dev/null; then
			warn=1
		fi

		if [ "$first" -eq 0 ]; then
			printf ','
		fi

		first=0

		printf '{"file":%s,"description":%s,"warn":%s}' \
			"$(json_string "$filename")" \
			"$(json_string "$description")" \
			"$warn"
	done

	printf ']}\n'
}


#
# ---------------------------------------------------------------------------
# RPCD registration
# ---------------------------------------------------------------------------
#

case "$1" in

	list)

		cat <<'JSON'
{
"status": {},
"poll": {},
"activity": {
"section": "string"
},
"scripts": {},
"discover": {}
}
JSON

		exit 0
		;;

	call)

		case "$2" in

			status)
				rpc_status
				;;

			poll)
				rpc_poll
				;;

			activity)
				rpc_activity
				;;

			scripts)
				rpc_scripts
				;;

			discover)
				rpc_discover
				;;

			*)
				exit 1
				;;

		esac

		exit 0
		;;

	*)
		exit 1
		;;

esac
