. /usr/share/libubox/jshn.sh
. /lib/functions.sh

BASEPATH="/tmp/apcontroller"

T=$(uci -q get apcontroller.@global[0].path)
[ -n "$T" ] && BASEPATH="$T"


#
# Get host status/data
#
show_status() {
	local cfg
	local enabled
	local ipaddr
	local datafile
	local platformfile
	local lastcontact
	local platform

	json_init
	json_add_array "hosts"

	config_load apcontroller

	config_foreach _show_status_host host

	json_close_array
	json_dump
}


_show_status_host() {
	local cfg="$1"

	local enabled
	local name
	local ipaddr
	local output
	local platform
	local platformfile
	local lastcontact
	local now
	local timestamp
	local data
	local clientslist2g
	local clientslist5g
	local clientslist6g

	config_get_bool enabled "$cfg" enabled 1
	config_get name "$cfg" name
	config_get ipaddr "$cfg" ipaddr

	[ -n "$ipaddr" ] || return 0

	output="${BASEPATH}/${ipaddr}-${cfg}"
	platformfile="${output}.platform"

	now=$(date +%s)
	lastcontact=-1

	if [ -s "$output" ]; then
		timestamp=$(date +%s -r "$output")
		lastcontact=$((now - timestamp))
	fi

	platform="unknown"

	if [ -f "$platformfile" ]; then
		read -r platform < "$platformfile"
	fi

	json_add_object

	json_add_string "section" "$cfg"
	json_add_string "name" "$name"
	json_add_string "ipaddr" "$ipaddr"
	json_add_string "platform" "$platform"
	json_add_int "lastcontact" "$lastcontact"

	#
	# Agent output is JSON.
	#
	if [ -s "$output" ]; then
		data=$(cat "$output")

		if json_load "$data" 2>/dev/null; then
			#
			# Copy known fields from agent JSON.
			#
			for field in \
				mac \
				hostname \
				model \
				software \
				uptime \
				load \
				clients2g \
				clients5g \
				clients6g \
				channels2g \
				channels5g \
				channels6g
			do
				if json_get_var value "$field"; then
					json_add_string "$field" "$value"
				fi
			done

			#
			# Client lists
			#
			for band in 2g 5g 6g; do
				if json_get_var value "clientslist${band}"; then
					json_add_raw "clientslist${band}" "$value"
				fi
			done
		fi
	fi

	json_close_object
}


#
# Activity
#
show_activity() {
	local section="$1"
	local ipaddr
	local logfile
	local line
	local timestamp
	local value

	config_load apcontroller
	config_get ipaddr "$section" ipaddr

	json_init
	json_add_array "activity"

	[ -n "$ipaddr" ] || {
		json_close_array
		json_dump
		return
	}

	logfile="${BASEPATH}/${ipaddr}.txt"

	[ -f "$logfile" ] || {
		json_close_array
		json_dump
		return
	}

	while read -r timestamp value; do
		[ -n "$timestamp" ] || continue
		[ -n "$value" ] || continue

		json_add_object
		json_add_int "timestamp" "$timestamp"
		json_add_int "value" "$value"
		json_close_object
	done < "$logfile"

	json_close_array
	json_dump
}


#
# Available scripts
#
show_scripts() {
	local file
	local description
	local warn

	json_init
	json_add_array "scripts"

	for file in /usr/share/apcontroller/scripts/*; do
		[ -f "$file" ] || continue
		[ -x "$file" ] || continue

		description="$(sed -n 's/^# Description:[[:space:]]*//p' "$file" | head -1)"
		warn="$(sed -n 's/^# Warn:[[:space:]]*//p' "$file" | head -1)"

		[ -n "$description" ] || description="$(basename "$file")"
		[ -n "$warn" ] || warn="0"

		json_add_object
		json_add_string "file" "$(basename "$file")"
		json_add_string "description" "$description"
		json_add_string "warn" "$warn"
		json_close_object
	done

	json_close_array
	json_dump
}


#
# rpcd protocol
#
case "$1" in

	list)
		json_init
		json_add_object "activity"
		json_close_object

		json_add_object "scripts"
		json_close_object

		json_add_object "status"
		json_close_object

		json_dump
		;;

	call)
		case "$2" in

			status)
				show_status
				;;

			activity)
				read -r input
				json_load "$input" 2>/dev/null

				json_get_var section section

				show_activity "$section"
				;;

			scripts)
				show_scripts
				;;

			*)
				echo "Method not found" >&2
				exit 1
				;;
		esac
		;;

	*)
		echo "Invalid request" >&2
		exit 1
		;;

esac

exit 0
