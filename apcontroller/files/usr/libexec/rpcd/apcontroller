#!/bin/sh
#
# APController RPCD backend
# Path: /usr/libexec/rpcd/apcontroller
#
# RPCD entry point only.
#
# Main logic:
#
#   /usr/share/apcontroller/lib/platform.sh
#
# SSH helpers:
#
#   /usr/share/apcontroller/lib/ssh.sh
#
# Common helpers:
#
#   /usr/share/apcontroller/lib/common.sh
#
###############################################################################

PATH="/usr/sbin:/usr/bin:/sbin:/bin"

BASEFOLDER="/usr/share/apcontroller"
LIBFOLDER="${BASEFOLDER}/lib"

#
# Common library:
#
#   /usr/share/apcontroller/lib/common.sh
#
. "${LIBFOLDER}/common.sh"

#
# Platform / RPC implementation:
#
#   /usr/share/apcontroller/lib/platform.sh
#
# platform.sh itself loads:
#
#   /usr/share/apcontroller/lib/ssh.sh
#
. "${LIBFOLDER}/platform.sh"


###############################################################################
# RPCD
#
# File:
#   /usr/libexec/rpcd/apcontroller
#
# platform.sh provides:
#
#   rpc_status()
#   rpc_activity()
#   rpc_scripts()
#
###############################################################################

case "$1" in

	list)

		cat <<'EOF'
{
	"status": {},
	"activity": {
		"section": "string"
	},
	"scripts": {}
}
EOF

		exit 0
		;;


	call)

		case "$2" in

			status)

				rpc_status

				exit $?
				;;


			activity)

				rpc_activity

				exit $?
				;;


			scripts)

				rpc_scripts

				exit $?
				;;


			*)

				exit 1
				;;

		esac

		;;


	*)

		exit 1
		;;

esac