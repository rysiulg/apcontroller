#!/bin/sh

#
# APController
#
# (c) 2025-2026 Cezary Jackiewicz <cezary@eko.one.pl>
#

PATH="/usr/sbin:/usr/bin:/sbin:/bin"

BASEFOLDER="${BASEFOLDER:-/usr/share/apcontroller}"
LIBFOLDER="${BASEFOLDER}/lib"

#
# Common configuration / paths / debug
#

. "${LIBFOLDER}/common.sh"

#
# SSH/SCP transport
#

. "${LIBFOLDER}/ssh.sh"

#
# Platform detection + platform agents + polling
#

. "${LIBFOLDER}/platform.sh"

#
# OpenWrt UCI functions
#

. /lib/functions.sh


###############################################################################
# CONFIGURATION
###############################################################################

BASEPATH="/tmp/apcontroller"

T="$(uci -q get apcontroller.@global[0].path)"
[ -n "$T" ] && BASEPATH="$T"

mkdir -p "$BASEPATH"


###############################################################################
# MAIN
###############################################################################

config_load apcontroller

config_foreach get_data_from_host host

exit 0