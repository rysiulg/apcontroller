#!/bin/sh
set -e
umask 077
selected=${1:-all};case "$selected" in *[!a-zA-Z0-9_,]*) exit 2;;esac
. /usr/share/apcontroller/lib/ssh.sh
. /lib/functions.sh
config_load apcontroller
mkdir -p /etc/apcontroller/pull-server
exec 8>/tmp/apcontroller-enroll.lock
flock -n 8 || exit 0
main=$(uci -q get apcontroller.@global[0].pull_main || uci -q get network.lan.ipaddr);main=${main%/*}
case "$main" in ''|*[!0-9.]*) echo 'Ustaw IPv4 gĹ‚Ăłwnego routera do pobierania konfiguracji' >&2;exit 2;;esac
serverkeys=/etc/apcontroller/pull-server/main-known-hosts
: > "$serverkeys"
for file in /etc/dropbear/dropbear_*_host_key; do [ ! -f "$file" ] || dropbearkey -y -f "$file" | awk -v main="$main" '/^(ssh-|ecdsa-)/ {print main" "$1" "$2}' >> "$serverkeys";done
[ -s "$serverkeys" ] || exit 2
version=$( { sha256sum /usr/share/apcontroller/pull-agent /usr/share/apcontroller/pull-init "$serverkeys";printf '%s\n' "$main"; } | sha256sum | cut -d ' ' -f1)
enroll_host(){
 local id="$1" enabled platform ip user pass port key use remote version_old pub
 case "$id" in ''|*[!a-zA-Z0-9_]*) return 1;;esac
 [ "$selected" = all ] || { case ",$selected," in *",$id,"*) ;;*) return 0;;esac; }
 config_get enabled "$id" enabled;config_get platform "$id" platform;[ "$enabled:$platform" = 1:openwrt ] || return 0
 [ -s /etc/apcontroller/desired/$id/current.tar ] || return 0
 config_get ip "$id" ipaddr;config_get user "$id" username;config_get pass "$id" password;config_get port "$id" port 22;config_get key "$id" keyfile;config_get use "$id" usekeyfile 0
 [ "$user" = root ] || { echo "$id: pobieranie wymaga przygotowania klienta z uprawnieniami root";return 0; }
 rexec(){ apc_ssh_exec "$ip" "$port" "$user" "$pass" "$key" "$use" "$1"; }
 rput(){ apc_ssh_pipe "$ip" "$port" "$user" "$pass" "$key" "$use" "umask 077; cat > '$1'" < "$2"; }
 if ! version_old=$(rexec 'test -f /etc/openwrt_release; cat /etc/apcontroller/pull/agent-version 2>/dev/null || true'); then echo "$id ($ip): niedostÄ™pny, przygotowanie zostanie ponowione";return 0;fi
 if [ "$version_old" != "$version" ]; then
  rexec 'set -e; test -f /etc/openwrt_release; command -v dbclient >/dev/null; command -v dropbearkey >/dev/null; mkdir -p /etc/apcontroller/pull /etc/apcontroller/legacy-backup/r21 /root/.ssh /scripts; chmod 700 /etc/apcontroller/pull; if [ ! -f /etc/apcontroller/pull/client.key ]; then dropbearkey -t rsa -s 2048 -f /etc/apcontroller/pull/client.key >/dev/null 2>&1;fi; chmod 600 /etc/apcontroller/pull/client.key; test -f /etc/apcontroller/legacy-backup/r21/crontab || cp /etc/crontabs/root /etc/apcontroller/legacy-backup/r21/crontab' || return 0
  rput /usr/bin/apcontroller-pull.next /usr/share/apcontroller/pull-agent || return 0
  rput /etc/init.d/apcontroller-pull.next /usr/share/apcontroller/pull-init || return 0
  rput /etc/apcontroller/pull/main-known-hosts "$serverkeys" || return 0
  rput /etc/apcontroller/pull/legacy-sync-compat /usr/share/apcontroller/legacy-sync-compat || return 0
  rput /etc/apcontroller/pull/make_backup_usb.sh /usr/share/apcontroller/legacy-backup-compat || return 0
  rexec "set -e; sh -n /usr/bin/apcontroller-pull.next; sh -n /etc/init.d/apcontroller-pull.next; mv /usr/bin/apcontroller-pull.next /usr/bin/apcontroller-pull; mv /etc/init.d/apcontroller-pull.next /etc/init.d/apcontroller-pull; chmod 755 /usr/bin/apcontroller-pull /etc/init.d/apcontroller-pull; printf 'MAIN=%s\\nPORT=22\\n' '$main' > /etc/apcontroller/pull/client.conf; touch /root/.ssh/known_hosts; test -f /etc/apcontroller/legacy-backup/r21/known_hosts || cp /root/.ssh/known_hosts /etc/apcontroller/legacy-backup/r21/known_hosts; awk '\$1 != \"$main\"' /root/.ssh/known_hosts > /root/.ssh/known_hosts.next; cat /etc/apcontroller/pull/main-known-hosts >> /root/.ssh/known_hosts.next; mv /root/.ssh/known_hosts.next /root/.ssh/known_hosts; chmod 600 /root/.ssh/known_hosts; printf '%s\\n' '$version' > /etc/apcontroller/pull/agent-version" || return 0
 fi
 pub=$(rexec 'dropbearkey -y -f /etc/apcontroller/pull/client.key | awk '\''/^ssh-rsa / {print $1" "$2}'\''') || return 0
 printf '%s' "$pub" | grep -Eq '^ssh-rsa [A-Za-z0-9+/=]+$' || return 0
 [ "$(cat /etc/apcontroller/pull-server/$id.pub 2>/dev/null || true)" = "$pub" ] || printf '%s\n' "$pub" > /etc/apcontroller/pull-server/$id.pub
 mkdir -p /etc/dropbear;touch /etc/dropbear/authorized_keys
 [ -f /etc/apcontroller/pull-server/authorized_keys.before ] || cp /etc/dropbear/authorized_keys /etc/apcontroller/pull-server/authorized_keys.before
 original=$(sha256sum /etc/dropbear/authorized_keys | cut -d ' ' -f1)
 awk -v marker="apcontroller-pull:$id" '$NF != marker' /etc/dropbear/authorized_keys > /etc/dropbear/authorized_keys.next
 printf 'command="/usr/bin/apcontroller-config-fetch %s",no-port-forwarding,no-agent-forwarding,no-X11-forwarding,no-pty %s apcontroller-pull:%s\n' "$id" "$pub" "$id" >> /etc/dropbear/authorized_keys.next
 test "$original" = "$(sha256sum /etc/dropbear/authorized_keys | cut -d ' ' -f1)" || { rm /etc/dropbear/authorized_keys.next;echo 'Zmiana rĂłwnolegĹ‚a authorized_keys; przygotowanie zostanie ponowione';return 0; }
 if cmp -s /etc/dropbear/authorized_keys.next /etc/dropbear/authorized_keys; then rm /etc/dropbear/authorized_keys.next;else chmod 600 /etc/dropbear/authorized_keys.next;mv /etc/dropbear/authorized_keys.next /etc/dropbear/authorized_keys;fi
 if [ "$version_old" != "$version" ]; then
  rexec 'set -e; awk '\''/^[[:space:]]*#/ {print;next} /\/(root|scripts)\/(sync-wireless-smart|make_backup_usb|autoupdate)\.sh/ {print "# retired APController r21: "$0;next} {print}'\'' /etc/crontabs/root > /etc/crontabs/root.next; mv /etc/crontabs/root.next /etc/crontabs/root; chmod 600 /etc/crontabs/root; for name in sync-wireless-smart.sh make_backup_usb.sh; do test ! -f /root/$name || test -f /etc/apcontroller/legacy-backup/r21/$name || cp -p /root/$name /etc/apcontroller/legacy-backup/r21/$name;done; cp /etc/apcontroller/pull/legacy-sync-compat /root/sync-wireless-smart.sh; cp /etc/apcontroller/pull/legacy-sync-compat /scripts/sync-wireless-smart.sh; cp /etc/apcontroller/pull/make_backup_usb.sh /root/make_backup_usb.sh; chmod 755 /root/sync-wireless-smart.sh /scripts/sync-wireless-smart.sh /root/make_backup_usb.sh; touch /etc/autobackup.disabled; for path in /etc/apcontroller/ /usr/bin/apcontroller-pull /etc/init.d/apcontroller-pull /root/sync-wireless-smart.sh /scripts/sync-wireless-smart.sh /root/make_backup_usb.sh /root/.ssh/known_hosts /etc/crontabs/root /etc/autobackup.disabled; do grep -qxF "$path" /etc/sysupgrade.conf || echo "$path" >> /etc/sysupgrade.conf;done; /etc/init.d/cron reload; /etc/init.d/apcontroller-pull enable; /etc/init.d/apcontroller-pull restart' || return 0
 fi
 echo "$id ($ip): klient pobierania gotowy"
}
config_foreach enroll_host host
for path in /etc/dropbear/authorized_keys /etc/apcontroller/; do grep -qxF "$path" /etc/sysupgrade.conf || echo "$path" >> /etc/sysupgrade.conf;done
