#!/bin/sh /etc/rc.common
START=96
USE_PROCD=1
start_service(){
 [ -f /etc/apcontroller/pull/client.conf ] || return 0
 procd_open_instance
 procd_set_param command /bin/sh -c 'sleep 25; /usr/bin/apcontroller-pull; while sleep 120; do /usr/bin/apcontroller-pull; done'
 procd_set_param stdout 0
 procd_set_param stderr 1
 procd_close_instance
}
