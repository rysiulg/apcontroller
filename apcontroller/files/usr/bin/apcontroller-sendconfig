#!/bin/sh

#
# (c) 2025-2026 Cezary Jackiewicz <cezary@eko.one.pl>
#

SSHOPTIONS="-o StrictHostKeyChecking=accept-new"
SCPOPTIONS="-O"

SEC="$1"
[ -n "$SEC" ] || exit 0

VERBOSE="$2"

. /lib/functions.sh
. /usr/share/libubox/jshn.sh


#
# Base path
#
BASEPATH="/tmp/apcontroller"

T=$(uci -q get apcontroller.@global[0].path)
[ -n "$T" ] && BASEPATH="$T"

mkdir -p "$BASEPATH"


#
# Legacy SSH options.
#
# Used for old Ubiquiti devices which only offer ssh-rsa/ssh-dss.
#
LEGACY_SSHOPTIONS="$SSHOPTIONS \
	-o HostKeyAlgorithms=+ssh-rsa \
	-o PubkeyAcceptedAlgorithms=+ssh-rsa \
	-o KexAlgorithms=+diffie-hellman-group14-sha1,diffie-hellman-group1-sha1"


#
# Detect remote platform.
#
detect_platform() {
	local ipaddr="$1"
	local port="$2"
	local username="$3"
	local password="$4"
	local keyfile="$5"
	local usekeyfile="$6"
	local OUT

	#
	# First try normal SSH.
	#
	if [ "$usekeyfile" = "1" ] && [ -e "$keyfile" ]; then

		OUT=$(ssh -q \
			-i "$keyfile" \
			$SSHOPTIONS \
			-p "$port" \
			-o ConnectTimeout=5 \
			"$username@$ipaddr" '
				if [ -f /etc/openwrt_release ] ||
				   [ -f /etc/openwrt_version ] ||
				   command -v ubus >/dev/null 2>&1; then
					echo OPENWRT
				elif command -v mca-cli >/dev/null 2>&1 ||
				     command -v ubntbox >/dev/null 2>&1 ||
				     [ -f /etc/ubnt_version ]; then
					echo UBIQUITI
				elif command -v cliclientd >/dev/null 2>&1 ||
				     [ -d /etc/omada ] ||
				     [ -d /etc/tplink ]; then
					echo OMADA
				else
					echo UNKNOWN
				fi
			' 2>/dev/null)

	else

		OUT=$(sshpass -p "$password" \
			ssh -q \
			$SSHOPTIONS \
			-p "$port" \
			-o ConnectTimeout=5 \
			"$username@$ipaddr" '
				if [ -f /etc/openwrt_release ] ||
				   [ -f /etc/openwrt_version ] ||
				   command -v ubus >/dev/null 2>&1; then
					echo OPENWRT
				elif command -v mca-cli >/dev/null 2>&1 ||
				     command -v ubntbox >/dev/null 2>&1 ||
				     [ -f /etc/ubnt_version ]; then
					echo UBIQUITI
				elif command -v cliclientd >/dev/null 2>&1 ||
				     [ -d /etc/omada ] ||
				     [ -d /etc/tplink ]; then
					echo OMADA
				else
					echo UNKNOWN
				fi
			' 2>/dev/null)

	fi


	#
	# FIX:
	# If normal SSH failed, try legacy SSH.
	#
	if [ -z "$OUT" ]; then

		if [ "$usekeyfile" = "1" ] && [ -e "$keyfile" ]; then

			OUT=$(ssh -q \
				-i "$keyfile" \
				$LEGACY_SSHOPTIONS \
				-p "$port" \
				-o ConnectTimeout=5 \
				"$username@$ipaddr" '
					if [ -f /etc/openwrt_release ] ||
					   [ -f /etc/openwrt_version ] ||
					   command -v ubus >/dev/null 2>&1; then
						echo OPENWRT
					elif command -v mca-cli >/dev/null 2>&1 ||
					     command -v ubntbox >/dev/null 2>&1 ||
					     [ -f /etc/ubnt_version ]; then
						echo UBIQUITI
					elif command -v cliclientd >/dev/null 2>&1 ||
					     [ -f /etc/ubnt_version ]; then
						echo UBIQUITI
					elif command -v cliclientd >/dev/null 2>&1 ||
					     [ -d /etc/omada ] ||
					     [ -d /etc/tplink ]; then
						echo OMADA
					else
						echo UNKNOWN
					fi
				' 2>/dev/null)

		else

			OUT=$(sshpass -p "$password" \
				ssh -q \
				$LEGACY_SSHOPTIONS \
				-p "$port" \
				-o ConnectTimeout=5 \
				"$username@$ipaddr" '
					if [ -f /etc/openwrt_release ] ||
					   [ -f /etc/openwrt_version ] ||
					   command -v ubus >/dev/null 2>&1; then
						echo OPENWRT
					elif command -v mca-cli >/dev/null 2>&1 ||
					     command -v ubntbox >/dev/null 2>&1 ||
					     [ -f /etc/ubnt_version ]; then
						echo UBIQUITI
					elif command -v cliclientd >/dev/null 2>&1 ||
					     [ -d /etc/omada ] ||
					     [ -d /etc/tplink ]; then
						echo OMADA
					else
						echo UNKNOWN
					fi
				' 2>/dev/null)

		fi

	fi


	case "$OUT" in
		*OPENWRT*)
			echo "openwrt"
			;;
		*UBIQUITI*)
			echo "ubiquiti"
			;;
		*OMADA*)
			echo "omada"
			;;
		*)
			echo "unknown"
			;;
	esac
}


#
# SSH options depending on platform.
#
get_ssh_options() {
	local platform="$1"

	case "$platform" in

		ubiquiti)
			echo "$LEGACY_SSHOPTIONS"
			;;

		*)
			echo "$SSHOPTIONS"
			;;

	esac
}


#
# Get previously detected platform.
#
get_platform() {
	local ipaddr="$1"
	local host="$2"
	local platform

	platform=""

	if [ -s "${BASEPATH}/${ipaddr}-${host}.platform" ]; then
		platform=$(cat "${BASEPATH}/${ipaddr}-${host}.platform" 2>/dev/null)
	fi

	case "$platform" in
		openwrt|ubiquiti|omada|unknown)
			echo "$platform"
			return 0
			;;
	esac

	echo ""
}


#
# Generate JSON commands.
#
T=$(uci -q get apcontroller."$SEC")
[ "$T" = "group" ] || exit 0

HOSTS=$(uci -q get apcontroller."$SEC".host)
[ -n "$HOSTS" ] || exit 0

WIFIS=$(uci -q get apcontroller."$SEC".wifi)
[ -n "$WIFIS" ] || exit 0


json_init

DELETE=$(uci -q get apcontroller."$SEC".delete)

if [ "$DELETE" = "1" ]; then
	json_add_int "delete" 1
fi

json_add_array "wifis"


for WIFI in $WIFIS; do

	BANDS=$(uci -q get apcontroller."$WIFI".band)

	MACFILTER=$(uci -q get apcontroller."$WIFI".macfilter)
	[ -n "$MACFILTER" ] || MACFILTER="disable"

	MACLIST=$(uci -q get apcontroller."$WIFI".maclist)


	for BAND in $BANDS; do

		json_add_object

		ENABLED=$(uci -q get apcontroller."$WIFI".enabled)
		[ -n "$ENABLED" ] || ENABLED=0

		HIDDEN=$(uci -q get apcontroller."$WIFI".hidden)
		[ -n "$HIDDEN" ] || HIDDEN=0

		ISOLATE=$(uci -q get apcontroller."$WIFI".isolate)
		[ -n "$ISOLATE" ] || ISOLATE=0

		json_add_int "enabled" "$ENABLED"

		json_add_string \
			"band" \
			"$BAND"

		json_add_string \
			"ssid" \
			"$(uci -q get apcontroller."$WIFI".ssid)"

		json_add_string \
			"encryption" \
			"$(uci -q get apcontroller."$WIFI".encryption)"

		json_add_string \
			"key" \
			"$(uci -q get apcontroller."$WIFI".key)"

		json_add_int \
			"hidden" \
			"$HIDDEN"

		json_add_int \
			"isolate" \
			"$ISOLATE"

		json_add_string \
			"network" \
			"$(uci -q get apcontroller."$WIFI".network)"

		json_add_string \
			"macfilter" \
			"$MACFILTER"

		json_add_array "maclist"

		for MAC in $MACLIST; do
			MAC=$(echo "$MAC" | tr '[:lower:]' '[:upper:]')
			json_add_string "" "$MAC"
		done

		json_close_array
		json_close_object

	done

done

json_close_array

json_dump > "${BASEPATH}/cmds-${SEC}" || exit 1


#
# Additional script
#
USEAS=$(uci -q get apcontroller."$SEC".useadditionalscript)


#
# Send configuration to every host.
#
for HOST in $HOSTS; do

	enabled=$(uci -q get apcontroller."$HOST".enabled)
	[ "$enabled" = "1" ] || continue


	ipaddr=$(uci -q get apcontroller."$HOST".ipaddr)
	[ -n "$ipaddr" ] || continue

	port=$(uci -q get apcontroller."$HOST".port)
	[ -n "$port" ] || port=22

	username=$(uci -q get apcontroller."$HOST".username)
	[ -n "$username" ] || continue

	password=$(uci -q get apcontroller."$HOST".password)

	usekeyfile=$(uci -q get apcontroller."$HOST".usekeyfile)
	keyfile=$(uci -q get apcontroller."$HOST".keyfile)

	[ -n "$keyfile" ] || \
		keyfile="/root/.ssh/id_dropbear"


	#
	# Platform.
	#
	platform=$(get_platform "$ipaddr" "$HOST")

	if [ -z "$platform" ]; then

		platform=$(detect_platform \
			"$ipaddr" \
			"$port" \
			"$username" \
			"$password" \
			"$keyfile" \
			"$usekeyfile")

		[ -n "$platform" ] || \
			platform="unknown"

		echo "$platform" \
			> "${BASEPATH}/${ipaddr}-${HOST}.platform"
	fi


	#
	# SSH options.
	#
	PLATFORM_SSHOPTIONS=$(get_ssh_options "$platform")


	#
	# User supplied SSH options.
	#
	sshoptions=$(uci -q get apcontroller."$HOST".sshoptions)


	#
	# SCP options.
	#
	scpoptions=$(uci -q get apcontroller."$HOST".scpoptions)
	[ -n "$scpoptions" ] || \
		scpoptions="$SCPOPTIONS"


	T=1


	#
	# =========================================================
	# KEY AUTHENTICATION
	# =========================================================
	#
	if [ "$usekeyfile" = "1" ] && [ -e "$keyfile" ]; then


		#
		# Additional script.
		#
		if [ "$USEAS" = "1" ]; then

			scp \
				-i "$keyfile" \
				$PLATFORM_SSHOPTIONS \
				$scpoptions \
				-P "$port" \
				/usr/share/apcontroller/apcontroller.user \
				"${username}@${ipaddr}:/tmp/apcontroller.user" \
				2>/dev/null

			if [ $? -ne 0 ]; then
				[ -n "$VERBOSE" ] &&
					echo "$HOST ($ipaddr) [$platform]: ERROR - cannot copy apcontroller.user"
				continue
			fi

			scp \
				-i "$keyfile" \
				$PLATFORM_SSHOPTIONS \
				$scpoptions \
				-P "$port" \
				/usr/share/apcontroller/apcontroller-agent-as \
				"${username}@${ipaddr}:/tmp/apcontroller-agent-as" \
				2>/dev/null

			if [ $? -ne 0 ]; then
				[ -n "$VERBOSE" ] &&
					echo "$HOST ($ipaddr) [$platform]: ERROR - cannot copy additional agent"
				continue
			fi
		fi


		#
		# JSON.
		#
		scp \
			-i "$keyfile" \
			$PLATFORM_SSHOPTIONS \
			$scpoptions \
			-P "$port" \
			"${BASEPATH}/cmds-${SEC}" \
			"${username}@${ipaddr}:/tmp/cmds-${SEC}" \
			2>/dev/null

		if [ $? -ne 0 ]; then
			T=1
			continue
		fi


		#
		# Main dispatcher.
		#
		scp \
			-i "$keyfile" \
			$PLATFORM_SSHOPTIONS \
			$scpoptions \
			-P "$port" \
			/usr/share/apcontroller/apcontroller-agent-setconfig \
			"${username}@${ipaddr}:/tmp/apcontroller-agent-setconfig" \
			2>/dev/null

		if [ $? -ne 0 ]; then
			T=1
			continue
		fi


		#
		# Platform agent.
		#
		case "$platform" in
			openwrt)
				AGENT="/usr/share/apcontroller/apcontroller-agent-setconfig-openwrt"
				;;
			ubiquiti)
				AGENT="/usr/share/apcontroller/apcontroller-agent-setconfig-ubiquiti"
				;;
			omada)
				AGENT="/usr/share/apcontroller/apcontroller-agent-setconfig-omada"
				;;
			*)
				AGENT=""
				;;
		esac


		if [ -n "$AGENT" ]; then

			scp \
				-i "$keyfile" \
				$PLATFORM_SSHOPTIONS \
				$scpoptions \
				-P "$port" \
				"$AGENT" \
				"${username}@${ipaddr}:/tmp/apcontroller-agent-setconfig-$(basename "$AGENT" | sed 's/apcontroller-agent-setconfig-//')" \
				2>/dev/null

			if [ $? -ne 0 ]; then
				T=1
				continue
			fi
		fi


		#
		# FIX:
		# Make remote agents executable.
		#
		ssh \
			-q \
			-i "$keyfile" \
			$PLATFORM_SSHOPTIONS \
			$sshoptions \
			-p "$port" \
			"${username}@${ipaddr}" \
			"chmod +x \
			 /tmp/apcontroller-agent-setconfig \
			 /tmp/apcontroller-agent-as \
			 /tmp/apcontroller-agent-setconfig-openwrt \
			 /tmp/apcontroller-agent-setconfig-ubiquiti \
			 /tmp/apcontroller-agent-setconfig-omada" \
			>/dev/null 2>&1

		if [ $? -ne 0 ]; then
			[ -n "$VERBOSE" ] &&
				echo "${NAME:-$HOST} (${ipaddr}) [${platform}]: ERROR - cannot chmod remote agents"
			continue
		fi


		#
		# Execute dispatcher.
		#
		ssh \
			-q \
			-i "$keyfile" \
			$PLATFORM_SSHOPTIONS \
			$sshoptions \
			-p "$port" \
			"${username}@${ipaddr}" \
			"/tmp/apcontroller-agent-setconfig /tmp/cmds-${SEC} $platform" \
			>/dev/null 2>&1

		T=$?


	#
	# =========================================================
	# PASSWORD AUTHENTICATION
	# =========================================================
	#
	else


		#
		# Additional script.
		#
		if [ "$USEAS" = "1" ]; then

			sshpass -p "$password" \
				scp \
				$PLATFORM_SSHOPTIONS \
				$scpoptions \
				-P "$port" \
				/usr/share/apcontroller/apcontroller.user \
				"${username}@${ipaddr}:/tmp/apcontroller.user" \
				2>/dev/null

			if [ $? -ne 0 ]; then
				[ -n "$VERBOSE" ] &&
					echo "$HOST ($ipaddr) [$platform]: ERROR - cannot copy apcontroller.user"
				continue
			fi

			sshpass -p "$password" \
				scp \
				$PLATFORM_SSHOPTIONS \
				$scpoptions \
				-P "$port" \
				/usr/share/apcontroller/apcontroller-agent-as \
				"${username}@${ipaddr}:/tmp/apcontroller-agent-as" \
				2>/dev/null

			if [ $? -ne 0 ]; then
				[ -n "$VERBOSE" ] &&
					echo "$HOST ($ipaddr) [$platform]: ERROR - cannot copy additional agent"
				continue
			fi
		fi


		#
		# JSON.
		#
		sshpass -p "$password" \
			scp \
			$PLATFORM_SSHOPTIONS \
			$scpoptions \
			-P "$port" \
			"${BASEPATH}/cmds-${SEC}" \
			"${username}@${ipaddr}:/tmp/cmds-${SEC}" \
			2>/dev/null

		if [ $? -ne 0 ]; then
			T=1
			continue
		fi


		#
		# Main dispatcher.
		#
		sshpass -p "$password" \
			scp \
			$PLATFORM_SSHOPTIONS \
			$scpoptions \
			-P "$port" \
			/usr/share/apcontroller/apcontroller-agent-setconfig \
			"${username}@${ipaddr}:/tmp/apcontroller-agent-setconfig" \
			2>/dev/null

		if [ $? -ne 0 ]; then
			T=1
			continue
		fi


		#
		# Platform agent.
		#
		case "$platform" in
			openwrt)
				AGENT="/usr/share/apcontroller/apcontroller-agent-setconfig-openwrt"
				;;
			ubiquiti)
				AGENT="/usr/share/apcontroller/apcontroller-agent-setconfig-ubiquiti"
				;;
			omada)
				AGENT="/usr/share/apcontroller/apcontroller-agent-setconfig-omada"
				;;
			*)
				AGENT=""
				;;
		esac


		if [ -n "$AGENT" ]; then

			case "$platform" in
				openwrt)
					REMOTE_AGENT="/tmp/apcontroller-agent-setconfig-openwrt"
					;;
				ubiquiti)
					REMOTE_AGENT="/tmp/apcontroller-agent-setconfig-ubiquiti"
					;;
				omada)
					REMOTE_AGENT="/tmp/apcontroller-agent-setconfig-omada"
					;;
			esac

			sshpass -p "$password" \
				scp \
				$PLATFORM_SSHOPTIONS \
				$scpoptions \
				-P "$port" \
				"$AGENT" \
				"${username}@${ipaddr}:${REMOTE_AGENT}" \
				2>/dev/null

			if [ $? -ne 0 ]; then
				T=1
				continue
			fi
		fi


		#
		# FIX:
		# Make remote agents executable.
		#
		sshpass -p "$password" \
			ssh \
			-q \
			$PLATFORM_SSHOPTIONS \
			$sshoptions \
			-p "$port" \
			"${username}@${ipaddr}" \
			"chmod +x \
			 /tmp/apcontroller-agent-setconfig \
			 /tmp/apcontroller-agent-as \
			 /tmp/apcontroller-agent-setconfig-openwrt \
			 /tmp/apcontroller-agent-setconfig-ubiquiti \
			 /tmp/apcontroller-agent-setconfig-omada" \
			>/dev/null 2>&1

		if [ $? -ne 0 ]; then
			[ -n "$VERBOSE" ] &&
				echo "$HOST ($ipaddr) [$platform]: ERROR - cannot chmod remote agents"
			continue
		fi


		#
		# Execute dispatcher.
		#
		sshpass -p "$password" \
			ssh \
			-q \
			$PLATFORM_SSHOPTIONS \
			$sshoptions \
			-p "$port" \
			"${username}@${ipaddr}" \
			"/tmp/apcontroller-agent-setconfig /tmp/cmds-${SEC} $platform" \
			>/dev/null 2>&1

		T=$?

	fi


	#
	# Cleanup remote files only after successful execution.
	#
	if [ "$T" -eq 0 ]; then

		if [ "$usekeyfile" = "1" ] && [ -e "$keyfile" ]; then

			ssh \
				-q \
				-i "$keyfile" \
				$PLATFORM_SSHOPTIONS \
				$sshoptions \
				-p "$port" \
				"${username}@${ipaddr}" \
				"rm -f \
				 /tmp/apcontroller-agent-setconfig \
				 /tmp/apcontroller-agent-setconfig-openwrt \
				 /tmp/apcontroller-agent-setconfig-ubiquiti \
				 /tmp/apcontroller-agent-setconfig-omada \
				 /tmp/cmds-${SEC} \
				 /tmp/apcontroller.user \
				 /tmp/apcontroller-agent-as" \
				>/dev/null 2>&1

		else

			sshpass -p "$password" \
				ssh \
				-q \
				$PLATFORM_SSHOPTIONS \
				$sshoptions \
				-p "$port" \
				"${username}@${ipaddr}" \
				"rm -f \
				 /tmp/apcontroller-agent-setconfig \
				 /tmp/apcontroller-agent-setconfig-openwrt \
				 /tmp/apcontroller-agent-setconfig-ubiquiti \
				 /tmp/apcontroller-agent-setconfig-omada \
				 /tmp/cmds-${SEC} \
				 /tmp/apcontroller.user \
				 /tmp/apcontroller-agent-as" \
				>/dev/null 2>&1
		fi

	fi


	#
	# Verbose.
	#
	if [ -n "$VERBOSE" ]; then

		if [ "$T" -eq 0 ]; then
			RET="OK"
		else
			RET="ERROR"
		fi

		NAME=$(uci -q get apcontroller."$HOST".name)

		echo "${NAME} (${ipaddr}) [${platform}]: ${RET}"
	fi

done


rm -f "${BASEPATH}/cmds-${SEC}" 2>/dev/null

exit 0
