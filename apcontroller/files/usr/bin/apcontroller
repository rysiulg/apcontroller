#!/bin/sh

#
# (c) 2025-2026 Cezary Jackiewicz <cezary@eko.one.pl>
#

SSHOPTIONS="-o StrictHostKeyChecking=accept-new"

BASEPATH="/tmp/apcontroller"

. /lib/functions.sh

T=$(uci -q get apcontroller.@global[0].path)
[ -n "$T" ] && BASEPATH="$T"

mkdir -p "$BASEPATH"


detect_platform()
{
	local ipaddr="$1"
	local port="$2"
	local username="$3"
	local password="$4"
	local keyfile="$5"
	local usekeyfile="$6"

	local OUT
	local SOCK
	local KNOWN
	local SSHOPTS

	#
	# ============================================================
	# 1. OPENWRT
	# ============================================================
	#

	if [ "$usekeyfile" = "1" ] && [ -e "$keyfile" ]; then

		OUT=$(
			ssh -q \
				-i "$keyfile" \
				$SSHOPTIONS \
				-p "$port" \
				-o ConnectTimeout=5 \
				"$username@$ipaddr" \
				'if [ -f /etc/openwrt_release ] ||
				    [ -f /etc/openwrt_version ] ||
				    command -v ubus >/dev/null 2>&1; then
					echo OPENWRT
				fi' \
				2>/dev/null
		)

	else

		OUT=$(
			sshpass -p "$password" \
			ssh -q \
				$SSHOPTIONS \
				-p "$port" \
				-o ConnectTimeout=5 \
				"$username@$ipaddr" \
				'if [ -f /etc/openwrt_release ] ||
				    [ -f /etc/openwrt_version ] ||
				    command -v ubus >/dev/null 2>&1; then
					echo OPENWRT
				fi' \
				2>/dev/null
		)

	fi

	case "$OUT" in
		*OPENWRT*)
			echo "openwrt"
			return 0
			;;
	esac


	#
	# ============================================================
	# 2. OMADA
	#
	# Omada EAP po SSH daje prompt:
	#
	#   EAP>
	#
	# po "enable":
	#
	#   EAP#
	#
	# Nie próbujemy tutaj wykonywać komendy przez:
	#
	#   ssh host 'command'
	#
	# bo EAP może nie udostępniać normalnego shell'a.
	# ============================================================
	#

	command -v sexpect >/dev/null 2>&1 || {
		#
		# Bez sexpect nie jesteśmy w stanie pewnie rozpoznać
		# EAP po promptcie.
		#
		OUT=""
	}

	if command -v sexpect >/dev/null 2>&1; then

		SOCK="/tmp/apcontroller-detect-$$.sock"
		KNOWN="/tmp/apcontroller-detect-$$.known_hosts"

		rm -f "$SOCK" "$KNOWN"

		export SEXPECT_SOCKFILE="$SOCK"

		SSHOPTS="
			-o StrictHostKeyChecking=no
			-o UserKnownHostsFile=$KNOWN
			-o ConnectTimeout=8
			-o ServerAliveInterval=5
			-o ServerAliveCountMax=2
			-o LogLevel=ERROR
			-p $port
		"

		#
		# Starsze EAP wymagają czasami ssh-rsa.
		#
		SSHOPTS="$SSHOPTS \
			-o HostKeyAlgorithms=+ssh-rsa \
			-o PubkeyAcceptedAlgorithms=+ssh-rsa \
			-o KexAlgorithms=+diffie-hellman-group14-sha1,diffie-hellman-group1-sha1"

		#
		# Start SSH.
		#
		sexpect spawn \
			-t 15 \
			ssh -tt $SSHOPTS \
			"$username@$ipaddr" \
			>/dev/null 2>&1

		if [ $? -eq 0 ]; then

			#
			# Password authentication.
			#
			sexpect expect \
				-timeout 10 \
				-nocase \
				-re 'password:' \
				>/dev/null 2>&1

			if [ $? -eq 0 ]; then
				sexpect send -enter -- "$password" \
					>/dev/null 2>&1
			fi


			#
			# Omada EAP prompt.
			#
			sexpect expect \
				-timeout 12 \
				-re 'EAP[>#][[:space:]]*' \
				>/dev/null 2>&1

			if [ $? -eq 0 ]; then

				#
				# Mamy EAP.
				#
				sexpect send -enter -- 'exit' \
					>/dev/null 2>&1

				sexpect close \
					>/dev/null 2>&1

				rm -f "$SOCK" "$KNOWN"

				echo "omada"
				return 0
			fi
		fi

		sexpect close >/dev/null 2>&1

		rm -f "$SOCK" "$KNOWN"
	fi


	#
	# ============================================================
	# 3. UBIQUITI
	# ============================================================
	#
	# Zostawiamy detekcję, która u Ciebie już działa.
	# ============================================================
	#

	if [ "$usekeyfile" = "1" ] && [ -e "$keyfile" ]; then

		OUT=$(
			ssh -q \
				-i "$keyfile" \
				$SSHOPTIONS \
				-o HostKeyAlgorithms=+ssh-rsa \
				-o PubkeyAcceptedAlgorithms=+ssh-rsa \
				-o KexAlgorithms=+diffie-hellman-group14-sha1,diffie-hellman-group1-sha1 \
				-p "$port" \
				-o ConnectTimeout=5 \
				-o LogLevel=ERROR \
				"$username@$ipaddr" \
				'echo __APCONTROLLER_TEST__' \
				2>&1
		)

	else

		OUT=$(
			sshpass -p "$password" \
			ssh -q \
				$SSHOPTIONS \
				-o HostKeyAlgorithms=+ssh-rsa \
				-o PubkeyAcceptedAlgorithms=+ssh-rsa \
				-o KexAlgorithms=+diffie-hellman-group14-sha1,diffie-hellman-group1-sha1 \
				-p "$port" \
				-o ConnectTimeout=5 \
				-o LogLevel=ERROR \
				"$username@$ipaddr" \
				'echo __APCONTROLLER_TEST__' \
				2>&1
		)

	fi

	if echo "$OUT" | grep -qiE \
		'ubnt|unifi|ubiquiti|mca-|ubntbox|UniFi'; then

		echo "ubiquiti"
		return 0
	fi


	#
	# ============================================================
	# 4. UNKNOWN
	# ============================================================
	#

	echo "unknown"
	return 0
}


#
# SSH options depending on remote platform
#
get_ssh_options() {
	local platform="$1"

	case "$platform" in
		ubiquiti)
			echo "$SSHOPTIONS \
				-o HostKeyAlgorithms=+ssh-rsa \
				-o PubkeyAcceptedAlgorithms=+ssh-rsa \
				-o KexAlgorithms=+diffie-hellman-group14-sha1,diffie-hellman-group1-sha1"
			;;

		*)
			echo "$SSHOPTIONS"
			;;
	esac
}


#
# Run command remotely
#
remote_ssh() {
	local platform="$1"
	local ipaddr="$2"
	local port="$3"
	local username="$4"
	local password="$5"
	local keyfile="$6"
	local usekeyfile="$7"

	shift 7

	local OPTIONS
	OPTIONS=$(get_ssh_options "$platform")

	if [ "$usekeyfile" = "1" ] && [ -e "$keyfile" ]; then
		ssh -q \
			-i "$keyfile" \
			$OPTIONS \
			-p "$port" \
			"$username@$ipaddr" "$@" 2>/dev/null
	else
		sshpass -p "$password" \
			ssh -q \
			$OPTIONS \
			-p "$port" \
			"$username@$ipaddr" "$@" 2>/dev/null
	fi
}


#
# Copy file to remote host
#
remote_scp() {
	local platform="$1"
	local ipaddr="$2"
	local port="$3"
	local username="$4"
	local password="$5"
	local keyfile="$6"
	local usekeyfile="$7"
	local source="$8"
	local destination="$9"

	local OPTIONS
	OPTIONS=$(get_ssh_options "$platform")

	if [ "$usekeyfile" = "1" ] && [ -e "$keyfile" ]; then
		scp -O \
			-i "$keyfile" \
			$OPTIONS \
			-P "$port" \
			"$source" \
			"$username@$ipaddr:$destination" \
			2>/dev/null
	else
		sshpass -p "$password" \
			scp -O \
			$OPTIONS \
			-P "$port" \
			"$source" \
			"$username@$ipaddr:$destination" \
			2>/dev/null
	fi
}


#
# Get data from host
#
get_data_from_host() {
	local cfg="$1"

	local enabled
	local ipaddr
	local username
	local password
	local port
	local usekeyfile
	local keyfile
	local platform
	local AGENT
	local T
	local NOW
	local VAL
	local TIMESTAMP
	local D

	config_get_bool enabled "$cfg" enabled 1
	[ "$enabled" -gt 0 ] || return 0

	config_get ipaddr "$cfg" ipaddr
	config_get username "$cfg" username

	[ -n "$ipaddr" ] || return 0
	[ -n "$username" ] || return 0

	config_get password "$cfg" password
	config_get port "$cfg" port 22

	config_get usekeyfile "$cfg" usekeyfile 0
	config_get keyfile "$cfg" keyfile "/root/.ssh/id_dropbear"


	#
	# Detect platform
	#
	platform=$(detect_platform \
		"$ipaddr" \
		"$port" \
		"$username" \
		"$password" \
		"$keyfile" \
		"$usekeyfile")

	[ -n "$platform" ] || platform="unknown"


	#
	# Select agent
	#
	AGENT="/usr/share/apcontroller/apcontroller-agent"

	case "$platform" in
		openwrt)
			[ -x "/usr/share/apcontroller/apcontroller-agent-openwrt" ] &&
				AGENT="/usr/share/apcontroller/apcontroller-agent-openwrt"
			;;

		ubiquiti)
			[ -x "/usr/share/apcontroller/apcontroller-agent-ubiquiti" ] &&
				AGENT="/usr/share/apcontroller/apcontroller-agent-ubiquiti"
			;;

		omada)
			[ -x "/usr/share/apcontroller/apcontroller-agent-omada" ] &&
				AGENT="/usr/share/apcontroller/apcontroller-agent-omada"
			;;
	esac


	#
	# Copy agent and execute it
	#
case "$platform" in

	omada)

		#
		# Omada EAP:
		# agent działa lokalnie na APController.
		#
		# Argumenty:
		# poll
		# ip
		# port
		# username
		# password
		# usekeyfile
		# keyfile
		#

		"$AGENT" \
			poll \
			"$ipaddr" \
			"$port" \
			"$username" \
			"$password" \
			"$usekeyfile" \
			"$keyfile" \
			> "${BASEPATH}/${ipaddr}-${cfg}" \
			2> "${BASEPATH}/${ipaddr}-${cfg}.err"

		T=$?
		;;

	*)
	
		#
		# OpenWrt / Ubiquiti:
		# copy agent and execute remotely.
		#
		if remote_scp \
			"$platform" \
			"$ipaddr" \
			"$port" \
			"$username" \
			"$password" \
			"$keyfile" \
			"$usekeyfile" \
			"$AGENT" \
			"/tmp"; then

			remote_ssh \
				"$platform" \
				"$ipaddr" \
				"$port" \
				"$username" \
				"$password" \
				"$keyfile" \
				"$usekeyfile" \
				"/tmp/$(basename "$AGENT")" \
				> "${BASEPATH}/${ipaddr}-${cfg}"

			T=$?

			remote_ssh \
				"$platform" \
				"$ipaddr" \
				"$port" \
				"$username" \
				"$password" \
				"$keyfile" \
				"$usekeyfile" \
				"rm -f /tmp/$(basename "$AGENT")" \
				>/dev/null 2>&1

		else
			T=1
		fi
		;;

esac


	#
	# Determine online status
	#
	NOW=$(date "+%s")
	VAL=0

	if [ "$T" -eq 0 ] &&
	   [ -s "${BASEPATH}/${ipaddr}-${cfg}" ]; then

		TIMESTAMP=$(date +%s -r "${BASEPATH}/${ipaddr}-${cfg}")
		D=$((NOW - TIMESTAMP))

		[ "$D" -le 60 ] && VAL=1
	fi


	#
	# Log only day/hour
	#
	NOW=$(date +%s -d "$(date -d @"$NOW" "+%Y-%m-%d %H:00")")

	touch "${BASEPATH}/${ipaddr}.txt"

	grep -q "$NOW $VAL" "${BASEPATH}/${ipaddr}.txt" ||
		echo "$NOW $VAL" >> "${BASEPATH}/${ipaddr}.txt"


	#
	# Save detected platform
	#
	echo "$platform" > "${BASEPATH}/${ipaddr}-${cfg}.platform"
}


config_load apcontroller
config_foreach get_data_from_host host

exit 0
