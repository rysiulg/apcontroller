#!/bin/sh

# ============================================================
# apcontroller-agent-omada
# TP-Link Omada EAP 5.x
#
# Komunikacja:
#   OpenWrt -> SSH -> EAP CLI
#
# WAŻNE:
#   - NIE używa scp
#   - NIE używa tftp
#   - NIE tworzy plików na EAP
#   - komendy są wysyłane bezpośrednio do EAP CLI
#
# Usage:
#
#   apcontroller-agent-omada <host> <user> <password> [port]
#   apcontroller-agent-omada poll <host> <user> <password> [port]
#
# Example:
#
#   apcontroller-agent-omada 192.168.88.77 admin 'password'
#
#   apcontroller-agent-omada poll 192.168.88.77 admin 'password'
#
# ============================================================


# ------------------------------------------------------------
# ARGUMENTS
# ------------------------------------------------------------

POLL=0

if [ "$1" = "poll" ]; then
	POLL=1
	shift
fi

HOST="$1"
USER="$2"
PASSWORD="$3"
PORT="${4:-22}"


if [ -z "$HOST" ] || [ -z "$USER" ] || [ -z "$PASSWORD" ]; then
	echo "usage: $0 [poll] <host> <user> <password> [port]" >&2
	exit 2
fi


# ------------------------------------------------------------
# DEPENDENCIES
# ------------------------------------------------------------

command -v sshpass >/dev/null 2>&1 || {
	echo "sshpass not found" >&2
	exit 127
}

command -v ssh >/dev/null 2>&1 || {
	echo "ssh not found" >&2
	exit 127
}


# ------------------------------------------------------------
# SSH OPTIONS
# ------------------------------------------------------------

KNOWN_HOSTS="/tmp/apcontroller-omada-known_hosts"

SSH_OPTS="
-q
-T
-o StrictHostKeyChecking=accept-new
-o UserKnownHostsFile=$KNOWN_HOSTS
-o ConnectTimeout=8
-o ServerAliveInterval=5
-o ServerAliveCountMax=2
-o HostKeyAlgorithms=+ssh-rsa
-o PubkeyAcceptedAlgorithms=+ssh-rsa
-o LogLevel=ERROR
-p $PORT
"


# ------------------------------------------------------------
# RUN EAP CLI
#
# Komendy idą przez stdin.
#
# NIE:
#   ssh host "sh script"
#
# TAK:
#   printf commands | ssh host
#
# Dzięki temu niczego nie trzeba tworzyć na EAP.
# ------------------------------------------------------------

run_cli()
{
	sshpass -p "$PASSWORD" ssh $SSH_OPTS "$USER@$HOST" 2>/dev/null
}


# ------------------------------------------------------------
# COMMAND LIST
# ------------------------------------------------------------

COMMANDS='enable
show version
show uptime
show memory summary
show network status
show wifi detail
show station info
show traffic
show controller-ip
show device-id
show status cloud
show status device
show date
show temperature
'


# ------------------------------------------------------------
# POLL
# ------------------------------------------------------------

if [ "$POLL" = "1" ]; then

	RAW=$(
		printf '%s\n' "$COMMANDS" |
		run_cli
	)

else

	RAW=$(
		printf '%s\n' "$COMMANDS" |
		run_cli
	)

fi


# ------------------------------------------------------------
# NO RESPONSE
# ------------------------------------------------------------

if [ -z "$RAW" ]; then
	echo '{"error":"No response from Omada EAP"}'
	exit 1
fi


# ------------------------------------------------------------
# JSON ESCAPE
# ------------------------------------------------------------

json_escape()
{
	printf '%s' "$1" |
	awk 'BEGIN { ORS="" }
	{
		gsub(/\\/,"\\\\")
		gsub(/"/,"\\\"")
		gsub(/\r/,"")
		gsub(/\t/,"\\t")
		print
	}'
}


# ------------------------------------------------------------
# VERSION
# ------------------------------------------------------------

VERSION=$(
	printf '%s\n' "$RAW" |
	grep 'Build ' |
	head -n1 |
	sed 's/^[[:space:]]*//'
)


# ------------------------------------------------------------
# UPTIME
# ------------------------------------------------------------

UPTIME=$(
	printf '%s\n' "$RAW" |
	sed -n 's/.*up \([^,]*\), load average:.*/\1/p' |
	head -n1
)


# ------------------------------------------------------------
# LOAD
# ------------------------------------------------------------

LOAD=$(
	printf '%s\n' "$RAW" |
	sed -n 's/.*load average:[[:space:]]*\(.*\)$/\1/p' |
	head -n1
)


# ------------------------------------------------------------
# IP
# ------------------------------------------------------------

IP=$(
	printf '%s\n' "$RAW" |
	awk '
		/^br0[[:space:]]/ {
			inbr=1
			next
		}

		inbr && /inet addr:/ {
			split($0,a,"inet addr:")
			split(a[2],b," ")
			print b[1]
			exit
		}
	'
)


# ------------------------------------------------------------
# MAC
# ------------------------------------------------------------

MAC=$(
	printf '%s\n' "$RAW" |
	awk '
		/^eth0[[:space:]]/ {
			for (i=1;i<=NF;i++) {
				if ($i=="HWaddr") {
					print $(i+1)
					exit
				}
			}
		}
	'
)


# ------------------------------------------------------------
# DEVICE ID
#
# Nie używamy {40}, bo różne BusyBox awk mogą tego nie obsługiwać.
# ------------------------------------------------------------

DEVICE_ID=$(
	printf '%s\n' "$RAW" |
	grep -E '^[0-9A-Fa-f]{40}$' |
	head -n1
)


# ------------------------------------------------------------
# CLOUD STATUS
# ------------------------------------------------------------

CLOUD=$(
	printf '%s\n' "$RAW" |
	sed -n 's/^Cloud Status:[[:space:]]*//p' |
	head -n1
)


# ------------------------------------------------------------
# MEMORY
# ------------------------------------------------------------

RAM_TOTAL=$(
	printf '%s\n' "$RAW" |
	sed -n 's/^MemTotal:[[:space:]]*\([0-9][0-9]*\) kB/\1/p' |
	head -n1
)

RAM_FREE=$(
	printf '%s\n' "$RAW" |
	sed -n 's/^MemFree:[[:space:]]*\([0-9][0-9]*\) kB/\1/p' |
	head -n1
)


# ------------------------------------------------------------
# JSON ESCAPE VALUES
# ------------------------------------------------------------

VERSION=$(json_escape "$VERSION")
UPTIME=$(json_escape "$UPTIME")
LOAD=$(json_escape "$LOAD")
IP=$(json_escape "$IP")
MAC=$(json_escape "$MAC")
DEVICE_ID=$(json_escape "$DEVICE_ID")
CLOUD=$(json_escape "$CLOUD")


# ------------------------------------------------------------
# JSON START
# ------------------------------------------------------------

printf '{'

printf '"type":"omada-eap",'
printf '"ipaddr":"%s",' "$IP"
printf '"mac":"%s",' "$MAC"
printf '"software":"%s",' "$VERSION"
printf '"uptime":"%s",' "$UPTIME"
printf '"load":"%s",' "$LOAD"
printf '"device_id":"%s",' "$DEVICE_ID"
printf '"cloud_status":"%s",' "$CLOUD"
printf '"memory_total":"%s",' "$RAM_TOTAL"
printf '"memory_free":"%s",' "$RAM_FREE"


# ============================================================
# WIFI
# ============================================================

printf '"wifi":['

FIRST=1

printf '%s\n' "$RAW" |
while IFS= read -r LINE
do

	case "$LINE" in

		ath[0-9]*" IEEE "*)
			IFACE=$(printf '%s\n' "$LINE" | awk '{print $1}')

			SSID=$(
				printf '%s\n' "$LINE" |
				sed -n 's/.*ESSID:"\([^"]*\)".*/\1/p'
			)

			FREQ=$(
				printf '%s\n' "$LINE" |
				sed -n 's/.*Frequency:\([0-9.]*\) GHz.*/\1/p'
			)

			BSSID=$(
				printf '%s\n' "$LINE" |
				sed -n 's/.*Access Point:[[:space:]]*\([0-9A-Fa-f:]*\).*/\1/p'
			)

			[ -n "$FREQ" ] || continue

			BAND=$(
				awk -v f="$FREQ" '
					BEGIN {
						if (f < 3)
							print "2g"
						else if (f < 6)
							print "5g"
						else
							print "6g"
					}
				'
			)

			[ "$FIRST" = "1" ] || printf ','
			FIRST=0

			printf '{'
			printf '"ifname":"%s",' "$IFACE"
			printf '"ssid":"%s",' "$(json_escape "$SSID")"
			printf '"frequency":"%s",' "$FREQ"
			printf '"band":"%s",' "$BAND"
			printf '"bssid":"%s"' "$BSSID"
			printf '}'

			;;

	esac

done

printf '],'


# ============================================================
# CLIENTS
# ============================================================

printf '"clients":['

FIRST=1

printf '%s\n' "$RAW" |
awk '
/^ath[0-9]+[[:space:]]+[0-9]+[[:space:]]+[0-9A-Fa-f-][0-9A-Fa-f-][0-9A-Fa-f-][0-9A-Fa-f-][0-9A-Fa-f-][0-9A-Fa-f-][0-9A-Fa-f-][0-9A-Fa-f-][0-9A-Fa-f-][0-9A-Fa-f-][0-9A-Fa-f-][0-9A-Fa-f-][0-9A-Fa-f-][0-9A-Fa-f-][0-9A-Fa-f-][0-9A-Fa-f-][0-9A-Fa-f-][0-9A-Fa-f-][0-9A-Fa-f-]/ {

	print $1 "|" $2 "|" $3 "|" $4 "|" $5 "|" $6 "|" $7 "|" $8

}
' |
while IFS='|' read IFACE CHANNEL MACADDR TXRATE RXRATE RSSI CONNECTED INACTIVE
do

	[ -n "$MACADDR" ] || continue

	MACADDR=$(
		printf '%s' "$MACADDR" |
		tr 'a-f' 'A-F' |
		sed 's/-/:/g'
	)


	# --------------------------------------------------------
	# BAND
	# --------------------------------------------------------

	case "$IFACE" in

		ath0|ath1|ath2)
			BAND="2g"
			;;

		ath10|ath11|ath12)
			BAND="5g"
			;;

		*)
			BAND="unknown"
			;;

	esac


	# --------------------------------------------------------
	# JSON
	# --------------------------------------------------------

	[ "$FIRST" = "1" ] || printf ','
	FIRST=0

	printf '{'

	printf '"ap":"%s",' "$IFACE"
	printf '"mac":"%s",' "$MACADDR"
	printf '"channel":%s,' "$CHANNEL"
	printf '"txrate":"%s",' "$TXRATE"
	printf '"rxrate":"%s",' "$RXRATE"
	printf '"signal":%s,' "$RSSI"
	printf '"connected":"%s",' "$CONNECTED"
	printf '"inactive":"%s",' "$INACTIVE"
	printf '"band":"%s"' "$BAND"

	printf '}'

done


printf ']'
printf '}\n'

exit 0
